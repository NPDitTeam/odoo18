<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- เพิ่ม fields ในหน้าตั้งค่าผู้ใช้ -->
    <record id="view_users_form_vehicle_inspection" model="ir.ui.view">
        <field name="name">res.users.form.vehicle.inspection</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="รายการตรวจสอบสภาพรถ" name="vehicle_inspection_permissions">
                    <group string="สิทธิ์การจัดการรายการตรวจสอบสภาพรถ">
                        <group>
                            <field name="can_confirm_vehicle_inspection" widget="boolean_toggle"/>
                            <field name="can_approve_vehicle_inspection" widget="boolean_toggle"/>
                            <field name="can_reset_vehicle_inspection" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                <p><strong>คำอธิบาย:</strong></p>
                                <ul>
                                    <li><strong>ยืนยัน:</strong> อนุญาตให้เปลี่ยนสถานะจาก "ร่าง" เป็น "ยืนยัน"</li>
                                    <li><strong>อนุมัติ:</strong> อนุญาตให้เปลี่ยนสถานะจาก "ยืนยัน" เป็น "อนุมัติ"</li>
                                    <li><strong>กลับเป็นร่าง:</strong> อนุญาตให้เปลี่ยนสถานะกลับเป็น "ร่าง"</li>
                                </ul>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
