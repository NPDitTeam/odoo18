<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Installment Wizard Form -->
    <record id="view_add_installment_wizard_form" model="ir.ui.view">
        <field name="name">npd.loan.add.installment.wizard.form</field>
        <field name="model">npd.loan.add.installment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="ข้อมูลสินเชื่อ">
                            <field name="loan_id" invisible="1"/>
                            <field name="loan_amount" readonly="1"/>
                            <field name="interest_rate" readonly="1"/>
                            <field name="loan_date" readonly="1"/>
                        </group>
                        <group string="ข้อมูลงวดที่จะเพิ่ม">
                            <field name="installment_no" readonly="1" style="font-weight: bold; font-size: 18px;"/>
                            <field name="previous_remaining" readonly="1"/>
                            <field name="carried_interest" readonly="1" 
                                   style="color: #cc6600; font-weight: bold;"
                                   invisible="carried_interest == 0"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    
                    <separator string="ตัวเลือกการคำนวณ"/>

                    <group>
                        <group>
                            <field name="skip_interest"/>
                            <field name="skip_late_fee"/>
                        </group>
                        <group>
                            <div invisible="not skip_interest" style="color: #0066cc; font-weight: bold; padding-top: 5px;">
                                ✓ ไม่คิดดอกเบี้ย - ตัดเงินต้นอย่างเดียว
                            </div>
                            <div invisible="not skip_late_fee" style="color: #cc6600; font-weight: bold; padding-top: 5px;">
                                ✓ ไม่คิดค่าปรับ
                            </div>
                        </group>
                    </group>

                    <separator string="การชำระเงิน"/>

                    <group>
                        <group>
                            <field name="actual_payment" style="font-weight: bold; font-size: 16px; color: #0066cc;"/>
                            <field name="paid_date"/>
                        </group>
                        <group>
                            <field name="minimum_payment" string="ชำระขั้นต่ำ (ดอก+ค้าง)" readonly="1"/>
                            <field name="advance_used"
                                   invisible="advance_remaining == 0"
                                   style="color: #cc6600;"/>
                            <field name="advance_remaining" readonly="1"
                                   invisible="advance_remaining == 0"
                                   style="color: #cc6600; font-weight: bold;"/>
                        </group>
                    </group>
                    
                    <separator string="ค่าคอม Sale"/>

                    <field name="wizard_commission_ids" invisible="not wizard_commission_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sale_user_id" readonly="1" force_save="1"/>
                            <field name="commission_amount"/>
                            <field name="minimum_payment" readonly="1" string="ชำระขั้นต่ำ (ดอก+ค้าง)"/>
                            <field name="net_amount" readonly="1" string="ยอดสุทธิเหลือ"
                                   decoration-danger="net_amount &lt; 0"
                                   decoration-success="net_amount &gt;= 0"/>
                        </list>
                    </field>

                    <separator string="ผลลัพธ์การคำนวณ"/>

                    <group>
                        <group>
                            <field name="overdue_days" readonly="1" invisible="overdue_days == 0"/>
                            <field name="late_fee" readonly="1" invisible="late_fee == 0"
                                   style="color: #cc0000; font-weight: bold;"/>
                            <field name="late_fee_paid" readonly="1" invisible="late_fee_paid == 0"
                                   style="color: #cc0000;"/>
                            <field name="interest_amount" readonly="1" string="ยอดชำระดอก"/>
                            <field name="principal_amount" readonly="1" string="ยอดชำระเงินต้น"/>
                        </group>
                        <group>
                            <field name="remaining_principal" readonly="1"
                                   style="font-weight: bold; font-size: 16px; color: red;"
                                   string="เงินต้นคงเหลือหลังชำระ"/>
                            <field name="carry_forward_interest" readonly="1"
                                   style="font-weight: bold; color: #cc6600;"
                                   string="ดอกค้างส่งต่องวดถัดไป"
                                   invisible="carry_forward_interest == 0"/>
                        </group>
                    </group>

                    <field name="can_close_debt" invisible="1"/>
                    <group invisible="not can_close_debt">
                        <group>
                            <field name="close_debt"/>
                        </group>
                        <group>
                            <div invisible="not close_debt" style="color: green; font-weight: bold; padding-top: 5px;">
                                ✓ ปิดบัญชีทันที (ไม่คิดดอกเบี้ย)
                            </div>
                            <div invisible="close_debt" style="color: #666; padding-top: 5px;">
                                ไม่ติ๊ก = คิดดอกจนเคลียร์หนี้หมดก่อน
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="✓ ยืนยันเพิ่มงวด" 
                            type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_add_installment_wizard" model="ir.actions.act_window">
        <field name="name">เพิ่มงวดชำระใหม่</field>
        <field name="res_model">npd.loan.add.installment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_add_installment_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
