<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Loan Type List View -->
    <record id="view_npd_loan_type_list" model="ir.ui.view">
        <field name="name">npd.loan.type.list</field>
        <field name="model">npd.loan.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="interest_rate"/>
                <field name="late_fee_rate"/>
                <field name="late_fee_type" optional="show"/>
                <field name="max_amount"/>
                <field name="max_period"/>
                <field name="loan_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Loan Type Form View -->
    <record id="view_npd_loan_type_form" model="ir.ui.view">
        <field name="name">npd.loan.type.form</field>
        <field name="model">npd.loan.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="loan_count" widget="statinfo" string="สินเชื่อ"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="เก็บถาวร" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="ข้อมูลทั่วไป">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="อัตราดอกเบี้ย">
                            <field name="interest_rate"/>
                        </group>
                    </group>
                    <group>
                        <group string="ค่าปรับล่าช้า">
                            <field name="late_fee_type" widget="radio"/>
                            <field name="late_fee_rate"/>
                            <div colspan="2" class="text-muted">
                                <p><b>รายวัน:</b> ค่าปรับ = ยอดค้าง × อัตรา% × จำนวนวัน</p>
                                <p><b>รอบ:</b> ค่าปรับ = ยอดค้าง × อัตรา% (คิดครั้งเดียวต่องวด)</p>
                            </div>
                        </group>
                        <group string="วงเงินและระยะเวลา">
                            <field name="max_amount"/>
                            <field name="max_period"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="รายละเอียดประเภทสินเชื่อ..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Loan Type Action -->
    <record id="action_npd_loan_type" model="ir.actions.act_window">
        <field name="name">ประเภทสินเชื่อ</field>
        <field name="res_model">npd.loan.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างประเภทสินเชื่อใหม่
            </p>
        </field>
    </record>
</odoo>
