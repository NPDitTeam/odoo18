<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commission Template List View -->
    <record id="view_sale_commission_template_list" model="ir.ui.view">
        <field name="name">npd.sale.commission.template.list</field>
        <field name="model">npd.sale.commission.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="sale_line_ids" widget="many2many_tags" string="รายชื่อ Sale"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Commission Template Form View -->
    <record id="view_sale_commission_template_form" model="ir.ui.view">
        <field name="name">npd.sale.commission.template.form</field>
        <field name="model">npd.sale.commission.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="ชื่อเทมเพลต"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="description" placeholder="หมายเหตุ..."/>
                        </group>
                    </group>
                    <separator string="รายชื่อ Sale"/>
                    <field name="sale_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="sale_user_id"/>
                            <field name="sale_name" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Commission Template Action -->
    <record id="action_sale_commission_template" model="ir.actions.act_window">
        <field name="name">เทมเพลตค่าคอม Sale</field>
        <field name="res_model">npd.sale.commission.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างเทมเพลตค่าคอม Sale ใหม่
            </p>
            <p>กำหนดรายชื่อ Sale ที่ต้องการเพิ่มในค่าคอมมิชชั่น</p>
        </field>
    </record>
</odoo>
