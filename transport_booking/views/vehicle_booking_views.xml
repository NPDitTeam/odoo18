<!--                                    </list>-->
<!--                                </field>-->
                                
                                <!-- ข้อมูลการส่งมอบ - แสดงเมื่อส่งของเสร็จแล้ว -->
                                <separator string="📦 ข้อมูลการส่งมอบ" invisible="not receiver_name and not delivery_photo and not receiver_signature"/>
                                <group invisible="not receiver_name and not delivery_photo and not receiver_signature">
                                    <group string="👤 ข้อมูลผู้รับ">
                                        <field name="receiver_name" placeholder="ชื่อผู้รับสินค้า" readonly="state == 'done'"/>
                                        <field name="actual_delivery_time" string="เวลาส่งถึง" readonly="1"/>
                                    </group>
                                </group>
                                
                                <!-- รูปภาพการส่งมอบ -->
                                <group invisible="not delivery_photo or not receiver_signature">
                                    <group string="📸 รูปถ่ายหลักฐานการส่ง" invisible="not delivery_photo">
                                        <field name="delivery_photo" widget="image" options="{'size': [400, 400]}" nolabel="1"/>
                                    </group>
                                    <group string="✍️ ลายเซ็นผู้รับ" invisible="not receiver_signature">
                                        <field name="receiver_signature" widget="image" options="{'size': [400, 200]}" nolabel="1"/>
                                    </group>
                                </group>
                                
                                <group string="📝 บันทึกการติดตาม">
                                    <field name="tracking_notes" nolabel="1" placeholder="บันทึกเพิ่มเติมเกี่ยวกับการขนส่ง..."/>
                                </group>
                            </page>

                            <page string="ค่าใช้จ่ายเพิ่มเติม">
    <!-- (ถ้าไม่อยากโชว์บนหัวแท็บ ให้คอมเมนต์ไว้)
    <group>
        <field name="total_expense" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
    </group>
    -->

    <field name="expense_ids" nolabel="1">
        <!-- ใช้ <list> สำหรับ inline one2many ใน v17+ -->
        <list string="รายการค่าใช้จ่าย" editable="bottom">
            <field name="expense_date"/>
            <field name="expense_type"/>
            <field name="description" optional="hide"/>
            <field name="is_fuel" widget="boolean_toggle" readonly="1"/>
            <!-- ✅ ตัด attrs ออก ให้ฟิลด์ fuel แสดงได้เสมอ (โหลดชัวร์) -->
            <field name="fuel_liters" optional="hide"/>
            <field name="fuel_price_per_liter" optional="hide"/>

            <!-- ✅ amount เป็นคอลัมน์สุดท้าย + มี footer รวมล่างขวา -->
            <field name="amount"
                   widget="monetary"
                   options="{'currency_field': 'currency_id'}"
                   class="oe_right"
                   sum="รวมค่าใช้จ่ายเพิ่มเติม"/>
        </list>

        <!-- ฟอร์มย่อยของรายการ -->
        <form string="รายการค่าใช้จ่าย">
            <group>
                <group>
                    <field name="expense_date"/>
                    <field name="expense_type"/>
                    <field name="description"/>
                </group>

                <group string="รายละเอียดค่าน้ำมัน" colspan="2">
                    <field name="is_fuel" readonly="1"/>
                    <!-- ❗ ไม่มี attrs ใน v17+ -->
                    <field name="fuel_liters"/>
                    <field name="fuel_price_per_liter"/>
                    <field name="amount"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                </group>
            </group>
        </form>
    </field>

    <!-- แถบสรุปใต้ตาราง ชิดขวา (ไม่ใช้ attrs) -->
    <group col="4">
        <group/><group/><group/>  <!-- ดันพื้นที่ว่างซ้าย -->
        <group>
            <!-- ใส่ for ให้ label เพื่อกัน error label-without-for -->
            <label for="total_expense" string="รวมค่าใช้จ่ายเพิ่มเติม"/>
            <field name="total_expense"
                   nolabel="1"
                   class="oe_right"
                   widget="monetary"
                   options="{'currency_field': 'currency_id'}"
                   readonly="1"/>
        </group>
    </group>
</page>

                            <page string="📋 รายการสินค้า">
                                <field name="order_line_ids" nolabel="1" readonly="1">
                                    <list string="รายการสินค้า" create="0" edit="0" delete="0">
                                        <field name="product_name_o14" string="ชื่อสินค้า"/>
                                        <field name="quantity" string="จำนวน" sum="รวมจำนวน"/>
                                        <field name="uom_name" string="หน่วย"/>
                                        <field name="total_weight" string="น้ำหนัก (กก.)" sum="รวมน้ำหนัก"/>
                                    </list>
                                </field>
                            </page>

                            <page string="⭐ ประเมินความพึงพอใจ" invisible="state != 'done'">
                                <group>
                                    <group string="📊 สถิติการประเมิน">
                                        <field name="rating_count" string="จำนวนการประเมิน"/>
                                        <field name="latest_rating" string="คะแนนล่าสุด" widget="float"/>
                                    </group>
                                    <group string="🔗 สร้าง Link ประเมิน">
                                        <button name="action_create_rating_link" 
                                                string="📝 สร้าง Link ประเมินใหม่" 
                                                type="object" 
                                                class="btn-primary"
                                                icon="fa-link"/>
                                    </group>
                                </group>
                                
                                <separator string="📋 ประวัติการประเมินทั้งหมด"/>
                                <field name="rating_ids" nolabel="1"/>
                            </page>
                            
                            <page string="หมายเหตุ">
                                <field name="note" nolabel="1" readonly="state != 'draft'"/>
                                <separator string="📌 เหตุผลที่ไม่ใช้งานผ่านแอป (เสร็จสิ้น)"
                                           invisible="not no_app_done_reason"/>
                                <field name="no_app_done_reason" nolabel="1" readonly="1"
                                       invisible="not no_app_done_reason"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter>
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </form>
            </field>
        </record>

        <!-- Wizard: ระบุเหตุผลที่ไม่ใช้งานผ่านแอป (ก่อนกดเสร็จสิ้น) -->
        <record id="view_done_reason_wizard_form" model="ir.ui.view">
            <field name="name">vehicle.booking.done.reason.wizard.form</field>
            <field name="model">vehicle.booking.done.reason.wizard</field>
            <field name="arch" type="xml">
                <form string="หมายเหตุ: ระบุเหตุผลที่ไม่ใช้งานผ่านแอป">
                    <div class="alert alert-warning" role="alert">
                        ⚠️ คุณกำลังกดเสร็จสิ้นจากฝั่ง Odoo โดยไม่จบงานผ่านแอปขนส่ง
                        กรุณาระบุเหตุผล (บังคับกรอก)
                    </div>
                    <group>
                        <field name="booking_id" invisible="1"/>
                        <field name="reason" nolabel="1" required="1"
                               placeholder="กรุณาระบุเหตุผลที่ไม่ใช้งานผ่านแอป..."/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="ตกลง"
                                type="object" class="btn-primary"/>
                        <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action -->
