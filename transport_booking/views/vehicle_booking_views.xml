<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="view_vehicle_booking_list" model="ir.ui.view">
            <field name="name">vehicle.booking.list</field>
            <field name="model">vehicle.booking</field>
            <field name="arch" type="xml">
                <list string="จองคิวรถขนส่ง"
                      decoration-info="state=='draft'"
                      decoration-primary="state=='confirmed'"
                      decoration-warning="state=='in_progress'"
                      decoration-success="state=='done'">
                    <field name="name"/>
                    <field name="branch_id"/>
		    <field name="delivery_type"/>
                    <field name="booking_date"/>
                    <field name="transport_order_id"/>
                    <field name="partner_id"/>
                    <field name="pickup_location"/>
                    <field name="destination"/>
                    <field name="vehicle_id"/>
		    <field name="vehicle_ownership" readonly="1"/>
                    <field name="driver_id"/>
                    <field name="license_plate_name"/>
                    <field name="gps_tracking_available" string="GPS" widget="boolean"/>
                    <field name="gps_vehicle_status" optional="show"/>
                    <field name="delivery_date" optional="show"/>
                    <field name="travel_expenses" sum="รวมค่าเที่ยว" optional="show"/>
                    <field name="daily_allowance" sum="รวมเบี้ยเลี้ยง" optional="show"/>
                    <field name="shipping_cost" sum="รวมค่าขนส่ง" optional="show"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_vehicle_booking_form" model="ir.ui.view">
            <field name="name">vehicle.booking.form</field>
            <field name="model">vehicle.booking</field>
            <field name="arch" type="xml">
                <form string="จองคิวรถขนส่ง">
                    <header>
                        <button name="action_confirm" string="✅ ยืนยันการจอง"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_reset_to_draft" string="🔄 รีเซ็ตเป็นร่าง"
                                type="object" class="btn-warning"
                                confirm="คุณต้องการรีเซ็ตกลับเป็นร่างใช่หรือไม่? สถานะรถจะถูกเปลี่ยนเป็น 'พร้อมใช้'"
                                invisible="state != 'confirmed'"/>
                        <button name="action_start" string="🚚 เริ่มขนส่ง"
                                type="object" class="btn-primary"
                                confirm="⚠️ เมื่อคุณกด เริ่มขนส่ง ระบบจะปรับการทำงานฝั่งแอปขนส่งเพื่อข้าม การถ่ายรูปส่งของในการเริ่มงาน"
                                invisible="state != 'confirmed'"/>
                        <button name="action_open_done_reason_wizard" string="✔️ เสร็จสิ้น"
                                type="object" class="btn-success"
                                invisible="state != 'in_progress'"/>
                        <button name="action_cancel" string="❌ ยกเลิก"
                                type="object"
                                invisible="state in ['done','cancelled']"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,in_progress,done"/>
                    </header>
                    <sheet>
                        <!-- Smart Buttons -->
                        <div class="oe_button_box" name="button_box">
                            <!-- GPS Tracking Button -->
                            <button name="action_view_gps_tracking"
                                    type="object"
                                    class="oe_stat_button"
                                     icon="fa-location-arrow"
                                    invisible="not gps_tracking_available">
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="gps_vehicle_speed" widget="float" digits="[16,1]"/>
                                    </span>
                                    <span class="o_stat_text">เปิดแผนที่ GPSติดตามรถ กม./ชม. (GPS)</span>
                                </div>
                            </button>

                            <button name="action_open_tracking_map"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-map"
                                    invisible="state == 'draft'"
                                    string="🗺️ แผนที่ติดตาม">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">ติดตามการขนส่ง</span>
                                </div>
                            </button>
                            <button name="action_view_tracking"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-map-marker"
                                    invisible="state == 'draft'">
                                <div class="o_stat_info">
                                    <field name="tracking_count" widget="statinfo" string="ตำแหน่ง GPS"/>
                                </div>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"
                                       class="oe_inline"
                                       placeholder="ร่าง (รอยืนยันการจอง)"/>
                            </h1>
                        </div>

                        <group>
    <group string="📦 ข้อมูลคำสั่งขนส่ง">
        <field name="transport_order_id"
               options="{'no_create': True, 'no_create_edit': True}"
               readonly="state != 'draft'"/>

        <field name="booking_date" readonly="state != 'draft'"/>
        <field name="partner_id" readonly="1"/>
        <field name="delivery_employee_name" readonly="1"/>
        <field name="branch_id" readonly="1"/>
        <field name="travel_expenses" />
        <field name="daily_allowance" />
    </group>
    <group string="🚚 จัดสรรรถและคนขับ">
    <!-- ✅ จองพร้อมกัน -->
    <field name="is_concurrent_booking"
           widget="boolean_toggle"
           readonly="state != 'draft'"/>
    <field name="concurrent_booking_id"
           invisible="not is_concurrent_booking"
           readonly="state != 'draft'"
           options="{'no_create': True, 'no_edit': True}"/>

    <!-- ✅ หมายเหตุ - แสดงเมื่อเลือก concurrent_booking_id แล้ว + บังคับกรอก -->
    <field name="note"
           string="📝 หมายเหตุ (จองพร้อมกัน)"
           invisible="not concurrent_booking_id"
           readonly="state != 'draft'"
           required="concurrent_booking_id"
           placeholder="กรุณาระบุเหตุผลที่ต้องจองพร้อมกัน..."/>

    <!-- ✅ รถที่จัดส่ง - เพิ่ม force_save="1" -->
    <field name="vehicle_id"
           options="{'no_create': True, 'no_create_edit': True}"
           readonly="state != 'draft' or (is_concurrent_booking and concurrent_booking_id)"
           force_save="1"/>

	<field name="vehicle_ownership" readonly="1"/>
    <!-- ✅ คนขับ - เพิ่ม force_save="1" -->
    <field name="driver_id"
           options="{'no_create': True, 'no_create_edit': True}"
           readonly="state != 'draft' or (is_concurrent_booking and concurrent_booking_id)"
           force_save="1"/>

    <field name="license_plate_name" readonly="1"/>
	<field name="source" readonly="1"/>
</group>
</group>

                        <!-- GPS Tracking Information -->
                        <group invisible="not gps_tracking_available">
                            <group string="🛰️ ข้อมูล GPS รถ">
                                <field name="gps_tracking_available" invisible="1"/>
                                <field name="gps_vehicle_id" readonly="1"
                                       string="รถใน GPS"
                                       options="{'no_create': True, 'no_open': False}"/>
                                <field name="gps_vehicle_status" readonly="1"/>
                                <field name="gps_vehicle_speed" readonly="1" string="ความเร็วปัจจุบัน (กม./ชม.)"/>
                                <field name="gps_last_update" readonly="1" widget="datetime"/>
                                <div colspan="2">
<!--                                    <button name="action_view_gps_tracking" -->
<!--                                            string="🗺️ เปิดแผนที่ GPSติดตามรถ"-->
<!--                                            type="object" -->
<!--                                            class="btn btn-primary"-->
<!--                                            icon="fa-map-marker"/>-->
                                    <button name="action_open_gps_vehicle_form"
                                            string="📊 ดูข้อมูล GPS เต็มรูปแบบ"
                                            type="object"
                                            class="btn btn-secondary"
                                            icon="fa-info-circle"/>
                                </div>
                            </group>
                        </group>

                        <group>
                            <group string="📍 สถานที่">
                                <field name="pickup_location"
                                       placeholder="สถานที่รับสินค้า"
                                       readonly="1"/>
                                <field name="destination"
                                       placeholder="ปลายทาง"
                                       readonly="1"/>
                                <field name="distance_km" readonly="1"/>
                                <field name="estimated_time" readonly="1"/>
                                <field name="shipping_cost"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                                <field name="total_weight_order" readonly="1" string="น้ำหนักรวม (กก.)"/>
                                <field name="vehicle_type_name" readonly="1"/>
				<field name="delivery_type"/>
                            </group>
                            <group string="⏰ เวลาที่วางแผน">
                                <field name="planned_start_date" readonly="state != 'draft'"/>
<!--                                <field name="planned_end_date" readonly="state != 'draft'"/>-->
                                <field name="planned_start_date_t" readonly="state != 'draft'"/>
                                <field name="planned_end_date_t" readonly="state != 'draft'"/>
                                <field name="delivery_date" string="วันส่งจริง (วันที่)" readonly="1"/>
                            </group>
                        </group>

                        <!-- Hidden fields for widget trigger -->
                        <group invisible="1">
                            <field name="currency_id"/>
                            <field name="pickup_location" force_save="1"/>
                            <field name="destination" force_save="1"/>
                            <field name="distance_km" force_save="1"/>
                            <field name="shipping_cost" force_save="1"/>
                            <field name="total_weight_order" force_save="1"/>
                            <field name="estimated_time" force_save="1"/>
                            <field name="waypoints_json" force_save="1"/>
                            <field name="route_version" force_save="1"/>
                            <field name="map_trigger" force_save="1"/>
                            <field name="tracking_count"/>
                            <!-- GPS Coordinates -->
                            <field name="pickup_latitude" force_save="1"/>
                            <field name="pickup_longitude" force_save="1"/>
                            <field name="destination_latitude" force_save="1"/>
                            <field name="destination_longitude" force_save="1"/>
                        </group>

                        <notebook>
                            <page string="🗺️ แผนที่เส้นทาง">
                                <!-- ล็อกแผนที่: readonly=1 -> ปิดการลาก/แก้ไขเส้นทาง (ดูได้อย่างเดียว) -->
                                <field name="map_route" widget="google_maps_widget" nolabel="1" readonly="1"/>
                            </page>
                            
                            <page string="ติดตามข้อมูลการขนส่ง" invisible="state == 'draft'">
                                <!-- 📸 รูปถ่ายสินค้าก่อนขนส่ง - แสดงทันที -->
                                <group string="📸 รูปถ่ายสินค้าก่อนขนส่ง" invisible="not pickup_photo">
                                    <field name="pickup_photo" widget="image" options="{'size': [400, 400]}" nolabel="1"/>
                                    <group>
                                        <field name="actual_pickup_time" string="เวลาที่ถ่ายรูป" readonly="1"/>
                                    </group>
                                </group>
                                
<!--                                <separator string="🗺️ แผนที่แสดงตำแหน่ง Real-time"/>-->
<!--                                &lt;!&ndash; แผนที่แสดงตำแหน่ง Real-time &ndash;&gt;-->
