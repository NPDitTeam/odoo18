<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ให้ AI อธิบายใบที่กฎจับได้ (ทีละ 30 ใบ ทุก 15 นาที)
             แยกจากตอนกดปิดงาน เพราะแอปคนขับต้องได้คำตอบทันที ไม่ควรรอ AI -->
        <record id="cron_fraud_ai_explain" model="ir.cron">
            <field name="name">ตรวจทุจริตการจัดส่ง: ให้ AI วิเคราะห์ใบที่เข้าข่าย</field>
            <field name="model_id" ref="model_npd_transport_fraud_analyzer"/>
            <field name="state">code</field>
            <field name="code">model.cron_ai_explain()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- กวาดซ้ำเที่ยวที่ปิดงานย้อนหลัง 3 วัน เผื่อมีใบที่แก้ข้อมูลทีหลัง
             หรือปิดงานผ่านช่องทางที่ไม่ได้ผ่าน action_done -->
        <record id="cron_fraud_analyze_recent" model="ir.cron">
            <field name="name">ตรวจทุจริตการจัดส่ง: ตรวจซ้ำเที่ยวที่เพิ่งปิดงาน</field>
            <field name="model_id" ref="model_npd_transport_fraud_analyzer"/>
            <field name="state">code</field>
            <field name="code">model.cron_analyze_recent()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).replace(hour=20, minute=0, second=0, microsecond=0)"/>
        </record>
    </data>
</odoo>
