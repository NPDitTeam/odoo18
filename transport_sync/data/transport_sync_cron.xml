<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 🕐 Cron Job: ซิงค์ข้อมูลจาก Odoo 14 อัตโนมัติ (เฉพาะวันปัจจุบัน) -->
        <record id="ir_cron_transport_sync" model="ir.cron">
            <field name="name">Transport: Auto Sync from Odoo 14 (Today)</field>
            <field name="model_id" ref="model_transport_order"/>
            <field name="state">code</field>
            <field name="code">model.with_context(transport_sync_from_cron=True).action_sync_recent_from_odoo14()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- เดิมตั้ง transport_sync.stop_after_date = 2026-12-30 ไว้ที่นี่ (หยุดซิงค์สิ้นปี)
             เอาออกแล้ว: หลังปีใหม่ยังต้องดึงค่าขนส่งของลูกค้าที่ข้ามปีจากฝั่ง 14 ต่อ
             ลบ record ออกจากไฟล์ = ตอนอัปโมดูล Odoo ลบพารามิเตอร์ตัวเดิมทิ้ง -> ไม่หยุด
             ถ้าต้องการหยุดภายหลัง ตั้งพารามิเตอร์นี้เองที่ การตั้งค่า > เทคนิค > พารามิเตอร์ระบบ -->
    </data>
</odoo>
