<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action: ใบสั่งซื้อ -->
    <record id="jasper_purchase_order_report" model="ir.actions.report">
        <field name="name">ใบสั่งซื้อ</field>
        <field name="model">purchase.order</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_po_jasper/report/purchase_order.jrxml</field>
        <field name="attachment_use">False</field>
        <!-- report_name = URL path segment ห้ามมีสแลช/อักขระพิเศษ -->
        <field name="report_name">purchase_order_po</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบสั่งซื้อ - %s' % (object.name)</field>
    </record>

    <record id="jasper_purchase_order_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">purchase_order.jrxml</field>
        <field name="report_id" ref="pfb_npd_po_jasper.jasper_purchase_order_report"/>
        <field name="file" type="base64" file="pfb_npd_po_jasper/report/purchase_order.jrxml"/>
    </record>
</odoo>
