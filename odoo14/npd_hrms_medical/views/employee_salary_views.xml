<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_salary_form_hrms_medical" model="ir.ui.view">
        <field name="name">employee.salary.form.hrms.medical</field>
        <field name="model">employee.salary</field>
        <field name="inherit_id" ref="npd_hrms_base.view_employee_salary_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_account_number']" position="after">
                <field name="hrms_partner_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
