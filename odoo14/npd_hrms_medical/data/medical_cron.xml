<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- รันทุกวันแต่ทำงานจริงแค่ครั้งแรกของปีใหม่ (ยกเฉพาะคนที่ยังไม่มีวงเงินปีนี้) -->
        <record id="ir_cron_hrms_medical_limit_rollover" model="ir.cron">
            <field name="name">ระบบบุคคล: ยกวงเงินค่ารักษาพยาบาลรายบุคคลขึ้นปีใหม่</field>
            <field name="model_id" ref="model_hrms_medical_limit"/>
            <field name="state">code</field>
            <field name="code">model._cron_rollover_annual_limit()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
