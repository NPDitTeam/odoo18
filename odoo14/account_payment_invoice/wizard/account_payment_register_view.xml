<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_register_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.invoice</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <group>
                    <group>
                        <field name="is_payment_multi"/>
                        <field name="pfb_so_type" invisible="not is_payment_multi"/>
                        <field name="pfb_objective_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
