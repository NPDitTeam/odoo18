<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_payment" model="ir.ui.view">
        <field name="name">res.users.form.inherit.payment</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Payment Permissions">
                    <field name="account_payment_lock_draft_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
