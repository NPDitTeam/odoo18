<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Account Payment Form - Inherit to add invoice/paid/WHT tabs  -->
    <!-- ============================================================ -->
    <record id="view_account_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.invoice</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_th_account_tax.view_account_payment_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">

            <!-- Override statusbar: แสดงเฉพาะ flow หลัก (ยกเลิกจะแสดงเฉพาะตอนเป็นสถานะปัจจุบัน) -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
            </xpath>

            <!-- Smart button: รายการบันทึกบัญชี (ข้าง ใบแจ้งหนี้) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_journal_entry" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="not voucher_number">
                    <div class="o_stat_info">
                        <field name="voucher_number" class="o_stat_value"/>
                        <span class="o_stat_text">รายการบันทึกบัญชี</span>
                    </div>
                </button>
            </xpath>

            <!-- ปุ่มดูใบแจ้งหนี้ + ยกเลิกที่ header -->
            <xpath expr="//header" position="inside">
                <button name="get_invoice" type="object" string="ดูใบแจ้งหนี้"
                        class="btn-secondary"
                        invisible="state == 'draft' or not custom_invoice_ids"/>
                <button name="action_cancel_payment" type="object" string="ยกเลิกการชำระ"
                        class="btn-danger"
                        invisible="state not in ('paid', 'in_process')"
                        confirm="ต้องการยกเลิกการชำระเงินนี้? ใบแจ้งหนี้จะกลับเป็นค้างชำระ และไม่สามารถแก้ไขข้อมูลได้"/>
                <button name="action_draft" type="object" string="รีเซ็ตเป็นฉบับร่าง"
                        class="btn-secondary"
                        invisible="state != 'canceled'"/>
            </xpath>

            <!-- ซ่อนฟิลด์ ประเภทการชำระเงิน (payment_type) -->
            <xpath expr="//field[@name='payment_type'][@widget='radio']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Custom fields — จัดตำแหน่งเหมือน Odoo 14 (ซ้าย-ขวา) -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="search_invoice_name" string="เลขใบแจ้งหนี้"/>
                <field name="is_payment_multi" string="Payment Multi"/>
                <field name="pfb_so_type" string="ประเภท" invisible="not is_payment_multi"/>
                <field name="pfb_date_of_rent" string="Day of Rent"/>
                <field name="cash_status" string="สถานะเงินสด"/>
                <field name="overpaid_refund_status" string="สถานะคืนเงินโอนเกิน"/>
                <field name="wtax_refund_status" string="สถานะคืนหัก ณ ที่จ่าย"/>
                <field name="rental_difference_status" string="สถานะโอนคืนค่าเช่าส่วนต่าง"/>
                <field name="pfb_objective_id" string="วัตถุประสงค์"/>
            </xpath>
            <!-- ย้ายวันที่ไปฝั่งขวา ก่อนสมุดบันทึก -->
            <xpath expr="//field[@name='journal_id']" position="before">
                <field name="date" string="วันที่"/>
                <field name="can_edit_date" invisible="1"/>
                <field name="min_allowed_date" invisible="1"/>
                <field name="max_allowed_date" invisible="1"/>
                <field name="wht_amount" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="company_id" string="บริษัท" readonly="state != 'draft'"/>
                <field name="payment_method_one_id" string="Payment Method"
                       invisible="is_payment_multi"
                       readonly="state == 'paid'"
                       required="not is_payment_multi"
                       options="{'no_create': True}"/>
                <field name="cheque_id" string="เช็ค"/>
                <field name="voucher_source_id" invisible="1"/>
                <field name="voucher_number" string="รายการบันทึกบัญชี" readonly="1"/>
                <field name="payment_memo" string="หมายเหตุ"/>
            </xpath>

            <!-- move_id invisible field สำหรับ condition -->
            <xpath expr="//notebook[@name='payment_notebook']" position="before">
                <field name="move_id" invisible="1"/>
            </xpath>

            <!-- เพิ่ม pages เข้า payment_notebook ของ Odoo 18 -->
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                    <!-- รายการใบแจ้งหนี้ -->
                    <page string="รายการใบแจ้งหนี้" name="invoice_lines">
                        <field name="custom_invoice_ids" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="move_id" string="ใบแจ้งหนี้"
                                       domain="[('move_type', 'in', ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']), ('state', '=', 'posted'), ('payment_state', '!=', 'paid')]"/>
                                <field name="partner_id" string="คู่ค้า" optional="show"/>
                                <field name="date_invoice" string="วันที่ใบแจ้งหนี้" optional="show"/>
                                <field name="date_due" string="วันครบกำหนด" optional="hide"/>
                                <field name="amount_total" string="ยอดรวม"/>
                                <field name="amount_residual" string="ยอดค้างชำระ"/>
                                <field name="amount_due" string="ยอดที่ชำระ"/>
                                <field name="paid_total" string="ยอดชำระแล้ว" optional="show"/>
                                <field name="wt_amount" string="หัก ณ ที่จ่าย" optional="show"/>
                                <field name="net_amount" string="ยอดสุทธิ" optional="show"/>
                                <field name="invoice_status" string="สถานะ"/>
                                <field name="invoice_payment_state" string="สถานะการชำระ" widget="badge"
                                       decoration-success="invoice_payment_state == 'paid'"
                                       decoration-warning="invoice_payment_state == 'partial'"
                                       decoration-info="invoice_payment_state == 'not_paid'"/>
                                <field name="select" string="เลือก"/>
                                <field name="communication" string="หมายเหตุ" optional="hide"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                        <group class="oe_subtotal_footer">
                            <field name="total_invoice_amount" string="ยอดรวมใบแจ้งหนี้"/>
                            <field name="total_amount" string="ยอดรวม"/>
                        </group>
                    </page>

                    <!-- รายการชำระเงิน (แสดงเมื่อติ๊ก Payment Multi) -->
                    <page string="รายการชำระเงิน" name="paid_lines" invisible="not is_payment_multi">
                        <field name="paid_ids" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="journal_id" string="สมุดรายวัน"/>
                                <field name="payment_method_type" string="วิธีการชำระเงิน"/>
                                <field name="amount" string="จำนวนเงิน"/>
                                <field name="date" string="วันที่" optional="show"/>
                                <field name="cheque_id" string="เช็ค" optional="show"
                                       invisible="payment_method_type != 'cheque'"/>
                                <field name="cheque_number" string="เลขที่เช็ค" optional="show"
                                       invisible="payment_method_type != 'cheque'"/>
                                <field name="cheque_date" string="วันที่เช็ค" optional="show"
                                       invisible="payment_method_type != 'cheque'"/>
                                <field name="bank_account_id" string="บัญชีธนาคาร" optional="show"
                                       invisible="payment_method_type not in ('bank', 'cheque')"/>
                                <field name="account_id" string="บัญชี" optional="hide"/>
                                <field name="analytic_account_id" string="บัญชีวิเคราะห์" optional="hide"/>
                                <field name="analytic_distribution" widget="analytic_distribution" optional="hide"/>
                                <field name="is_write_off" string="ตัดจ่าย"/>
                                <field name="write_off_account_id" string="บัญชีตัดจ่าย" optional="show"
                                       invisible="not is_write_off"/>
                                <field name="communication" string="หมายเหตุ" optional="hide"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                        <group class="oe_subtotal_footer">
                            <field name="total_paid_amount" string="ยอดรวมชำระ"/>
                            <field name="write_off_amount" string="ยอดตัดจ่าย"/>
                            <field name="outstanding_amount" string="ยอดค้างชำระ"/>
                        </group>
                        <group>
                            <button name="calculate_outstanding_by_paid_total" type="object"
                                    string="คำนวณใหม่" class="btn-secondary"
                                    invisible="state != 'draft'"/>
                        </group>
                    </page>

                    <!-- หัก ณ ที่จ่าย -->
                    <page string="หัก ณ ที่จ่าย" name="wt_certs">
                        <field name="wt_cert_ids" readonly="state != 'draft'"/>
                    </page>

                    <!-- ใบกำกับภาษี -->
                    <page string="ใบกำกับภาษี" name="tax_invoices">
                        <field name="tax_invoice_ids"/>
                    </page>

                    <!-- รายการสมุดบัญชีรายวัน (Journal Entry Lines) -->
                    <page string="รายการสมุดบัญชีรายวัน" name="journal_entry_lines"
                          invisible="state == 'draft' and not move_id">
                        <group>
                            <group>
                                <field name="move_id" string="เลขที่รายการ" readonly="1"
                                       class="fw-bold"/>
                            </group>
                            <group>
                                <field name="voucher_number" string="เลขที่ Voucher" readonly="1"/>
                            </group>
                        </group>
                        <field name="move_line_ids" readonly="1">
                            <list decoration-muted="reconciled">
                                <field name="account_id" string="บัญชี"/>
                                <field name="name" string="รายละเอียด"/>
                                <field name="partner_id" string="คู่ค้า" optional="show"/>
                                <field name="debit" string="เดบิต" sum="รวมเดบิต"/>
                                <field name="credit" string="เครดิต" sum="รวมเครดิต"/>
                                <field name="balance" string="ยอดคงเหลือ" optional="hide"/>
                                <field name="date_maturity" string="วันครบกำหนด" optional="hide"/>
                                <field name="reconciled" string="กระทบยอดแล้ว" optional="show"
                                       widget="boolean"/>
                            </list>
                        </field>
                    </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Account Move Form - เพิ่ม tab รายการสมุดบัญชีรายวัน          -->
    <!-- สำหรับ moves ที่เกี่ยวกับ payment (Odoo 18 navigate ไป       -->
    <!-- move form เสมอ)                                              -->
    <!-- ============================================================ -->
    <record id="view_move_form_journal_lines" model="ir.ui.view">
        <field name="name">account.move.form.journal.lines</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab_entry']" position="before">
                <page string="รายการสมุดบัญชีรายวัน" name="journal_entry_lines_tab"
                      invisible="move_type != 'entry'">
                    <field name="line_ids" readonly="1">
                        <list decoration-muted="reconciled">
                            <field name="account_id" string="บัญชี"/>
                            <field name="name" string="รายละเอียด"/>
                            <field name="partner_id" string="คู่ค้า" optional="show"/>
                            <field name="debit" string="เดบิต" sum="รวมเดบิต"/>
                            <field name="credit" string="เครดิต" sum="รวมเครดิต"/>
                            <field name="date_maturity" string="วันครบกำหนด" optional="hide"/>
                            <field name="reconciled" string="กระทบยอดแล้ว" optional="show"
                                   widget="boolean"/>
                        </list>
                    </field>
                    <group col="6" class="mt-2">
                        <group colspan="4"/>
                        <group colspan="2" class="oe_subtotal_footer">
                            <field name="total_debit" string="รวมเดบิต"/>
                            <field name="total_credit" string="รวมเครดิต"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Account Payment Invoice - List View                          -->
    <!-- ============================================================ -->
    <record id="view_account_payment_invoice_list" model="ir.ui.view">
        <field name="name">account.payment.invoice.list</field>
        <field name="model">account.payment.invoice</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="payment_id"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="date_invoice"/>
                <field name="amount_total"/>
                <field name="amount_residual"/>
                <field name="amount_due"/>
                <field name="wt_amount"/>
                <field name="net_amount"/>
                <field name="paid_total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Account Payment Invoice - Form View                          -->
    <!-- ============================================================ -->
    <record id="view_account_payment_invoice_form" model="ir.ui.view">
        <field name="name">account.payment.invoice.form</field>
        <field name="model">account.payment.invoice</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="payment_id"/>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="date_invoice"/>
                            <field name="date_due"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="amount_residual"/>
                            <field name="amount_due"/>
                            <field name="wt_amount"/>
                            <field name="net_amount"/>
                            <field name="paid_total"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                    </group>
                    <group>
                        <field name="communication"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Account Paid Line - List View                                -->
    <!-- ============================================================ -->
    <record id="view_account_paid_line_list" model="ir.ui.view">
        <field name="name">account.paid.line.list</field>
        <field name="model">account.paid.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="payment_id"/>
                <field name="journal_id"/>
                <field name="payment_method_type"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="cheque_id"/>
                <field name="bank_account_id"/>
                <field name="is_write_off"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Account Paid Line - Form View                                -->
    <!-- ============================================================ -->
    <record id="view_account_paid_line_form" model="ir.ui.view">
        <field name="name">account.paid.line.form</field>
        <field name="model">account.paid.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="payment_id"/>
                            <field name="journal_id"/>
                            <field name="payment_method_type"/>
                            <field name="amount"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="cheque_id" invisible="payment_method_type != 'cheque'"/>
                            <field name="cheque_number" invisible="payment_method_type != 'cheque'"/>
                            <field name="cheque_date" invisible="payment_method_type != 'cheque'"/>
                            <field name="bank_account_id" invisible="payment_method_type not in ('bank', 'cheque')"/>
                            <field name="account_id"/>
                            <field name="analytic_account_id"/>
                            <field name="analytic_distribution" widget="analytic_distribution"/>
                        </group>
                    </group>
                    <group>
                        <field name="is_write_off"/>
                        <field name="write_off_account_id" invisible="not is_write_off"/>
                        <field name="communication"/>
                        <field name="currency_id" invisible="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List การชำระเงิน: แสดงคอลัมน์บริษัทเป็นค่าเริ่มต้น -->
    <record id="view_account_payment_tree_company" model="ir.ui.view">
        <field name="name">account.payment.list.company</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

</odoo>
