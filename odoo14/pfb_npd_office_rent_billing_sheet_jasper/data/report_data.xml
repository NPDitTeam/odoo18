<?xml version="1.0"?>
<odoo>
    <!-- report_name ห้ามมี "/" และต้องไม่ซ้ำรายงานอื่น (jasper_reports หาไฟล์แม่แบบจาก report_name) -->
    <record id="jasper_office_rent_billing_sheet_report" model="ir.actions.report">
        <field name="name">ใบแจ้งหนี้ค่าเช่าพื้นที่สำนักงาน</field>
        <field name="model">account.move</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_office_rent_billing_sheet_jasper/report/office_rent_billing_sheet.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบแจ้งหนี้ค่าเช่าพื้นที่สำนักงาน</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Office Rent Invoice - %s' % (object.name)</field>
    </record>
    <record id="jasper_office_rent_billing_sheet_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">office_rent_billing_sheet.jrxml</field>
        <field name="report_id" ref="jasper_office_rent_billing_sheet_report"/>
        <field name="file" type="base64" file="pfb_npd_office_rent_billing_sheet_jasper/report/office_rent_billing_sheet.jrxml"/>
    </record>
</odoo>
