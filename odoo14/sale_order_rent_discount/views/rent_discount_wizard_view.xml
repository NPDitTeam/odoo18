<odoo>
    <record id="view_rent_discount_wizard_form" model="ir.ui.view">
        <field name="name">rent.discount.wizard.form</field>
        <field name="model">rent.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่วนลดค่าเช่า">
                <group>
                    <field name="discount_amount"/>
                </group>
                <footer>
                    <button string="ยืนยัน" type="object" name="action_confirm_discount" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="rent_discount_wizard_action" model="ir.actions.act_window">
        <field name="name">ส่วนลดค่าเช่า</field>
        <field name="res_model">rent.discount.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
