<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ir.sequence = เลขรันสัญญาเช่า (ส่วน 26062300004) ไม่รวมตัวย่อบริษัท
        Prefix = %(y)s%(month)s%(day)s -> รหัสวันที่ yymmdd (เช่น 260623)
        output = 260623 + เลขรัน padding = 260623 + 00004 = 26062300004
        (ตัวย่อบริษัท nb-/sg- อยู่ที่ฟิลด์ rental_contract_prefix แยกต่างหาก)
    -->
    <record id="seq_npd_rental_contract" model="ir.sequence">
        <field name="name">เลขที่สัญญาเช่าอุปกรณ์ก่อสร้าง</field>
        <field name="code">npd.rental.contract</field>
        <field name="prefix">%(y)s%(month)s%(day)s</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
