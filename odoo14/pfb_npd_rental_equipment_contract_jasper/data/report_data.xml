<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action: สัญญาเช่าอุปกรณ์ก่อสร้าง -->
    <record id="jasper_rental_contract_report" model="ir.actions.report">
        <field name="name">สัญญาเช่าอุปกรณ์ก่อสร้าง</field>
        <field name="model">sale.order</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_rental_equipment_contract_jasper/report/rental_contract.jrxml</field>
        <field name="report_name">สัญญาเช่าอุปกรณ์ก่อสร้าง</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="attachment_use">False</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'สัญญาเช่า-%s' % (object.rental_contract_full or object.name)</field>
    </record>

    <!-- Attach the JRXML file to the report -->
    <record id="jasper_rental_contract_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">rental_contract.jrxml</field>
        <field name="report_id" ref="pfb_npd_rental_equipment_contract_jasper.jasper_rental_contract_report"/>
        <field name="file" type="base64" file="pfb_npd_rental_equipment_contract_jasper/report/rental_contract.jrxml"/>
    </record>
</odoo>
