<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_prefix_wizard_form" model="ir.ui.view">
        <field name="name">npd.rental.contract.prefix.wizard.form</field>
        <field name="model">npd.rental.contract.prefix.wizard</field>
        <field name="arch" type="xml">
            <form string="เปลี่ยนตัวย่อบริษัท">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="prefix"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="บันทึก" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
