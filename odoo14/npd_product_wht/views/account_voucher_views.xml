<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ใบสำคัญจ่าย: ปุ่มสร้าง WHT อัตโนมัติ + ยอดจ่ายสุทธิ + คอลัมน์ WHT -->
    <record id="view_purchase_receipt_form_wht" model="ir.ui.view">
        <field name="name">account.voucher.purchase.form.wht</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_purchase_receipt_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='proforma_voucher']" position="before">
                <button name="action_auto_create_wht_cert" string="สร้าง WHT อัตโนมัติ"
                        type="object" class="btn-secondary"
                        invisible="check_type_show_selection != 'false' or state != 'draft'"/>
            </xpath>
            <xpath expr="//group[contains(@class,'oe_subtotal_footer')]/field[@name='amount']" position="after">
                <field name="net_payment_amount" class="oe_subtotal_footer_separator" invisible="wht_amount == 0"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="before">
                <field name="npd_is_logistics" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='wht_total']" position="before">
                <field name="wht_category_id" optional="show" options="{'no_create': True}"/>
                <field name="wht_rate_display" optional="show"/>
                <field name="is_deduct_vat" column_invisible="not parent.npd_is_logistics"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='wht_total']" position="after">
                <field name="wht_status" widget="badge" optional="show"
                       decoration-success="wht_status == 'eligible'"
                       decoration-muted="wht_status == 'no_category'"/>
            </xpath>
        </field>
    </record>

    <!-- ใบสำคัญรับ: ฟอร์มนี้ยังไม่มี check_type_show_selection และคอลัมน์ wht_total ต้องเพิ่มให้ -->
    <record id="view_sale_receipt_form_wht" model="ir.ui.view">
        <field name="name">account.voucher.sale.form.wht</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_sale_receipt_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='paid']" position="after">
                <field name="check_type_show_selection" invisible="1"/>
                <field name="npd_is_logistics" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='proforma_voucher']" position="before">
                <button name="action_auto_create_wht_cert" string="สร้าง WHT อัตโนมัติ"
                        type="object" class="btn-secondary"
                        invisible="check_type_show_selection != 'false' or state != 'draft'"/>
            </xpath>
            <xpath expr="//group[contains(@class,'oe_subtotal_footer')]/field[@name='amount']" position="after">
                <field name="net_payment_amount" class="oe_subtotal_footer_separator" invisible="wht_amount == 0"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='price_subtotal']" position="before">
                <field name="wht_category_id" optional="show" options="{'no_create': True}"/>
                <field name="wht_rate_display" optional="show"/>
                <field name="wht_total"/>
                <field name="wht_status" widget="badge" optional="show"
                       decoration-success="wht_status == 'eligible'"
                       decoration-muted="wht_status == 'no_category'"/>
                <field name="is_deduct_vat" column_invisible="not parent.npd_is_logistics"/>
            </xpath>
        </field>
    </record>
</odoo>
