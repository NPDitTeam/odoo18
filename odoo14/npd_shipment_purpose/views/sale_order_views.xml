<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_shipment_purpose" model="ir.ui.view">
        <field name="name">sale.order.form.shipment.purpose</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <!-- ต้องมาหลัง sale_api_rent (so_number) และ pfb_npd_add_date_quatation_order (debt_payment_type) -->
        <field name="priority">200</field>
        <field name="arch" type="xml">

            <!-- ปุ่ม "ดึงข้อมูลการเช่า" (ของ sale_api_rent) ใช้กับงานเช่าเท่านั้น
                 งานโยกระหว่างสาขา/ส่งรถไปช่วยสาขา ให้ซ่อนไว้ กันพนักงานกดผิด -->
            <xpath expr="//button[@name='action_fetch_rental_data']" position="attributes">
                <attribute name="invisible">not is_npd_logistics_company or shipment_purpose in ['branch_transfer', 'help_branch']</attribute>
            </xpath>

            <!-- ปุ่มดึงสินค้าจากใบโยก (o18 อยู่ฐานเดียวกัน อ่านตรงได้เลย) -->
            <xpath expr="//button[@name='action_fetch_rental_data']" position="after">
                <button name="action_fetch_transfer_data" type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        string="ดึงข้อมูลใบโยก"
                        invisible="not is_npd_logistics_company or shipment_purpose != 'branch_transfer' or not transfer_ref_id"/>
            </xpath>

            <!-- ประเภทการจัดส่งสินค้า: วางไว้ "ก่อน" ดึงข้อมูลการเช่าจาก บ.อื่น + เลขเอกสาร SO -->
            <xpath expr="//field[@name='source_company_id']" position="before">
                <!-- งานขนส่งเป็นของบริษัท เอ็นพีดี โลจิสติกส์ เท่านั้น บริษัทอื่นไม่ต้องเห็น/ไม่บังคับ -->
                <field name="shipment_purpose"
                       invisible="not is_npd_logistics_company"
                       required="is_npd_logistics_company"
                       readonly="state in ['sale', 'done', 'cancel']"/>
            </xpath>

            <!-- งานเช่า: บริษัทต้นทางถูกตั้งจาก popup จึงล็อกไว้ตามเดิม
                 งานโยกระหว่างสาขา: ต้องเลือกบริษัทต้นทางเองก่อน จึงปลดล็อกเฉพาะกรณีนี้ -->
            <xpath expr="//field[@name='source_company_id']" position="attributes">
                <attribute name="readonly">shipment_purpose != 'branch_transfer' or state in ['sale', 'done', 'cancel']</attribute>
                <attribute name="required">shipment_purpose == 'branch_transfer' and is_npd_logistics_company</attribute>
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>

            <!-- งานโยกใช้ "เลขโยกสินค้า" แทน จึงซ่อนช่องเลขเอกสาร SO กันสับสน
                 (ระบบยังเติมเลขใบโยกลงช่องนี้เบื้องหลัง เพื่อส่งต่อไปงานขนส่ง) -->
            <xpath expr="//field[@name='so_number']" position="attributes">
                <attribute name="invisible">not is_npd_logistics_company or shipment_purpose == 'branch_transfer'</attribute>
            </xpath>

            <!-- เลขโยกสินค้า: เลือกจากใบโยกในระบบ กรองตามบริษัทต้นทาง + เฉพาะใบที่ยืนยันแล้ว -->
            <xpath expr="//field[@name='so_number']" position="after">
                <field name="transfer_ref_id"
                       options="{'no_create': True}"
                       domain="[('state', '=', 'confirmed'), ('source_company_id', '=', source_company_id)]"
                       invisible="shipment_purpose != 'branch_transfer' or not is_npd_logistics_company"
                       required="shipment_purpose == 'branch_transfer' and is_npd_logistics_company"
                       readonly="state in ['sale', 'done', 'cancel']"/>
                <field name="transfer_product_summary" readonly="1"
                       invisible="shipment_purpose != 'branch_transfer' or not transfer_product_summary"/>
            </xpath>

            <!-- หมายเหตุ: ต่อจากช่อง "ประเภทการรับชำระหนี้" -->
            <xpath expr="//field[@name='debt_payment_type']" position="after">
                <field name="shipment_note"
                       invisible="not is_npd_logistics_company"
                       required="is_npd_logistics_company"
                       placeholder="อธิบายงานขนส่งครั้งนี้ให้ตรงกับประเภทการจัดส่งสินค้าที่เลือก"
                       readonly="state in ['sale', 'done', 'cancel']"/>
                <field name="shipment_note_ai_state" readonly="1"
                       invisible="not shipment_note_ai_state"/>
                <field name="shipment_note_ai_feedback" readonly="1"
                       invisible="not shipment_note_ai_feedback"/>
            </xpath>

            <!-- ประเภทการจัดส่ง (ช่องเดิม) เดินตามประเภทการจัดส่งสินค้า ล็อกไม่ให้แก้เอง -->
            <xpath expr="//field[@name='delivery_type']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="help">ตั้งค่าอัตโนมัติจาก "ประเภทการจัดส่งสินค้า" ด้านบน</attribute>
            </xpath>
        </field>
    </record>
</odoo>
