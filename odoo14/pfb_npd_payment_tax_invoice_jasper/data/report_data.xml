<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action for Payment Tax Invoice -->
    <record id="jasper_payment_tax_invoice_report" model="ir.actions.report">
        <field name="name">ใบกำกับภาษี</field>
        <field name="model">account.payment</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_payment_tax_invoice_jasper/report/payment_tax_invoice.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบกำกับภาษี</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบกำกับภาษี - %s' % (object.name)</field>
    </record>

    <!-- Attach the JRXML file to the report -->
    <record id="jasper_payment_tax_invoice_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">payment_tax_invoice.jrxml</field>
        <field name="report_id" ref="pfb_npd_payment_tax_invoice_jasper.jasper_payment_tax_invoice_report"/>
        <field name="file" type="base64" file="pfb_npd_payment_tax_invoice_jasper/report/payment_tax_invoice.jrxml"/>
    </record>
</odoo>
