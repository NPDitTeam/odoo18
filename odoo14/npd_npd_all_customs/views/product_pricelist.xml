<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_pricelist_item_form_view" model="ir.ui.view">
        <field name="name">product.pricelist.item.form</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <field name="fixed_price" position="after">
                <field name="npd_insurance_price"/>
            </field>
        </field>
    </record>

    <record id="product_pricelist_form_view" model="ir.ui.view">
        <field name="name">product.pricelist</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='item_ids']/list/field[@name='price']" position="after">
                <field name="npd_insurance_price"/>
            </xpath>
        </field>
    </record>
</odoo>
