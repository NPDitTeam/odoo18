<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ใส่ที่ฟอร์ม "การรับ" เท่านั้น ไม่ใส่ฟอร์มคืนเงินประกันค่าเช่า
         เหมือน Odoo 14 ที่ account_advance_sales_contact สืบจาก account_voucher.view_purchase_receipt_form -->
    <record id="view_purchase_receipt_form_commission" model="ir.ui.view">
        <field name="name">account.voucher.purchase.form.commission</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_purchase_receipt_general_form"/>
        <field name="arch" type="xml">
            <!-- สองช่องนี้แก้ได้แม้ลงบัญชีแล้ว (ปุ่มด้านบน) เพราะเป็นข้อมูลประกอบรายงาน
                 ไม่กระทบยอดบัญชี และมักกรอกตกหล่นจนมารู้ตอนปิดค่าคอม -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="after">
                <field name="sales_contact_id"
                       options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="payment_date" required="1"/>
            </xpath>
            <!-- บังคับบัญชีวิเคราะห์เมื่อเป็นใบการรับ (check_type_show_selection = 'false') เหมือน o14 -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_analytic_id']" position="attributes">
                <attribute name="required">parent.check_type_show_selection == 'false'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel_draft']" position="before">
                <button name="action_edit_sales_contact"
                        string="แก้ไข Sales ที่ติดต่อ/วันที่กำหนดจ่าย"
                        type="object" class="btn-secondary"
                        invisible="state != 'posted'"/>
            </xpath>
        </field>
    </record>

    <!-- สาขา: ใส่ที่ฟอร์มคืนเงินประกันค่าเช่า (ฟอร์มการรับสืบจากฟอร์มนี้ จึงได้ด้วย) -->
    <record id="view_purchase_receipt_form_branch" model="ir.ui.view">
        <field name="name">account.voucher.purchase.form.branch</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_purchase_receipt_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="branch_id" options="{'no_create': True}" readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="view_sale_receipt_form_commission" model="ir.ui.view">
        <field name="name">account.voucher.sale.form.commission</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_sale_receipt_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="branch_id" options="{'no_create': True}" readonly="state != 'draft'"/>
            </field>
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="after">
                <field name="sales_contact_id"
                       options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="payment_date" required="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="before">
                <field name="check_type_show_selection" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_analytic_id']" position="attributes">
                <attribute name="required">parent.check_type_show_selection == 'false'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel_draft']" position="before">
                <button name="action_edit_sales_contact"
                        string="แก้ไข Sales ที่ติดต่อ"
                        type="object" class="btn-secondary"
                        invisible="state != 'posted'"/>
            </xpath>
        </field>
    </record>

    <record id="view_voucher_line_tree_commission" model="ir.ui.view">
        <field name="name">account.voucher.line.tree.commission</field>
        <field name="model">account.voucher.line</field>
        <field name="inherit_id" ref="account_voucher_npd.view_voucher_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="sales_contact_id"
                       options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="payment_date" required="1"/>
            </field>
        </field>
    </record>

    <record id="view_voucher_line_form_commission" model="ir.ui.view">
        <field name="name">account.voucher.line.form.commission</field>
        <field name="model">account.voucher.line</field>
        <field name="inherit_id" ref="account_voucher_npd.view_voucher_line_form"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="sales_contact_id"
                       options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="payment_date" required="1"/>
            </field>
        </field>
    </record>

</odoo>
