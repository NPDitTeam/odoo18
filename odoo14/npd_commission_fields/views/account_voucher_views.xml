<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_receipt_form_commission" model="ir.ui.view">
        <field name="name">account.voucher.purchase.form.commission</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_purchase_receipt_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="branch_id" options="{'no_create': True}"/>
            </field>
            <!-- สองช่องนี้แก้ได้แม้ลงบัญชีแล้ว เพราะเป็นข้อมูลประกอบรายงาน
                 ไม่กระทบยอดบัญชี และมักกรอกตกหล่นจนมารู้ตอนปิดค่าคอม -->
            <xpath expr="//field[@name='line_ids']/list" position="inside">
                <field name="sales_contact_id" optional="show"
                       options="{'no_create': True}"/>
                <field name="payment_date" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
