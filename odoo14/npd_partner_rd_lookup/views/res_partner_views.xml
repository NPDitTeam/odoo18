<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_npd_rd_lookup" model="ir.ui.view">
        <field name="name">res.partner.form.npd.rd.lookup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- ปุ่ม popup ค้นหาจากกรมสรรพากร แสดงเฉพาะเมื่อเลือกเป็นบริษัท ใช้ได้ทั้งผู้ติดต่อใหม่ (ยังไม่บันทึก) และเดิม -->
            <xpath expr="//field[@name='vat']" position="after">
                <widget name="npd_rd_lookup" colspan="2" invisible="not is_company"/>
            </xpath>
        </field>
    </record>
</odoo>
