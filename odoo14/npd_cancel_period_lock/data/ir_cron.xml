<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ทุกวันที่ 15 เวลา 00:05 (เวลาไทย) ล็อกเอกสารของเดือนก่อนหน้า
             nextcall จริงถูกตั้งใน post_init_hook ให้ตรงวันที่ 15 ตามเวลาไทย
             (Odoo เก็บ nextcall เป็น UTC = วันที่ 14 เวลา 17:05)
             Odoo 18 ไม่มี numbercall / doall แล้ว -->
        <record id="cron_update_cancel_lock" model="ir.cron">
            <field name="name">ล็อกการยกเลิกใบแจ้งหนี้/ใบรับชำระ เดือนก่อนหน้า (ทุกวันที่ 15)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_cancel_lock()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>

        <!-- วันที่ของเดือนที่จะล็อกเดือนก่อนหน้า ต้องตรงกับวันที่ของ nextcall ด้านบน -->
        <record id="param_lock_day" model="ir.config_parameter">
            <field name="key">npd_cancel_period_lock.lock_day</field>
            <field name="value">15</field>
        </record>
    </data>
</odoo>
