<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ใบสั่งขายของ บริษัท เอ็นพีดี โลจิสติกส์ จำกัด: ซ่อนช่องที่เป็นสูตรงานเช่า/ช่องที่บริษัทอื่นต้องกรอก
         (o14 ฐานโลจิสติกส์ไม่มีช่องเหล่านี้) ผู้ใช้สั่ง 22 ต.ค. 2569
         ทุกเงื่อนไขต่อท้ายด้วย "or is_npd_logistics_company" — บริษัทอื่นเหมือนเดิมทุกอย่าง -->
    <record id="view_order_form_logistics_hide_fields" model="ir.ui.view">
        <field name="name">sale.order.form.logistics.hide.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- หัวใบ -->
            <xpath expr="//field[@name='pfb_so_type']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='pfb_objective_id']" position="attributes">
                <attribute name="invisible">pfb_so_type == 'sale' or is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='pfb_date_of_rent'][not(ancestor::field[@name='order_line'])]" position="attributes">
                <attribute name="invisible">pfb_so_type == 'sale' or is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='deposit_return_status']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='renewal_bill_status']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='delivery_note_no']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='use_new_calc']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='use_baan_kheaw']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='vat_from_total']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>

            <!-- รอบ 2 (ผู้ใช้สั่ง 22 ต.ค. 2569): ช่องที่ Logistics ไม่ใช้
                 ช่องบังคับ (การติดต่อของลูกค้า / Sales ที่ติดต่อ / ช่องทางลูกค้า) ต้องเลิกบังคับด้วย
                 ไม่งั้นบันทึกไม่ได้ ค่าเริ่มต้นเติมให้ที่ models/sale_order.py -->
            <xpath expr="//field[@name='contact_type']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
                <attribute name="required">not is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='sales_contact']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
                <attribute name="required">not is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='cash']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='rental_status']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='rent_days_remaining']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='rent_days_overdue']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='deposit_ref']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='debt_payment_type']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='start_rent_date']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='end_rent_date']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='customer_channel_id']" position="attributes">
                <attribute name="required">not is_npd_logistics_company</attribute>
            </xpath>
            <!-- Order อนุมัติ / สถานะการตรวจสอบ (ผู้ใช้สั่ง 22 ต.ค. 2569 ไม่ได้ใช้) -->
            <xpath expr="//field[@name='approver_id'][not(ancestor::field[@name='order_line'])]" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='state_sale'][not(ancestor::field[@name='order_line'])]" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <!-- รายการราคา: ช่องถูกซ่อนสำหรับ Logistics อยู่แล้ว (sale_api_rent) แต่ป้ายยังโผล่ว่าง ๆ -->
            <xpath expr="//label[@for='pricelist_id']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//page[@name='marketing_tab']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>

            <!-- สรุปท้ายใบ: ค่าประกัน / ส่วนลดเช่า
                 (ไม่แตะ npd_amount_total_vat — ฟอร์มบน prod ยังไม่มีช่องนี้ xpath จะพังทั้งโมดูล) -->
            <xpath expr="//field[@name='total_rental_discount']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='pfb_amount_insurance'][not(@invisible='1')]" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='pfb_dis_amount_insurance']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='pfb_insurance_min']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='pfb_required_insurance_premium']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='pfb_amount']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//label[@for='pfb_amount']" position="attributes">
                <attribute name="invisible">is_npd_logistics_company</attribute>
            </xpath>

            <!-- คอลัมน์รายการสินค้า -->
            <xpath expr="//field[@name='order_line']/list/field[@name='pfb_quantity']" position="attributes">
                <!-- Logistics กรอก Quantity Rent เป็นจำนวนของเสมอ (แบบ o14) -->
                <attribute name="invisible">not pfb_so_rent_ok and not parent.is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='pfb_date_of_rent']" position="attributes">
                <attribute name="column_invisible">parent.is_npd_logistics_company</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='pfb_insurance_price']" position="attributes">
                <attribute name="column_invisible">parent.is_npd_logistics_company</attribute>
            </xpath>
            <!-- ให้ตรง o14: ค่าประกันอยู่หลังหน่วยวัด (product_uom ตัวแรกคือตัวซ่อนของ groups="!uom.group_uom") -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom'][last()]" position="after">
                <xpath expr="//field[@name='order_line']/list/field[@name='pfb_insurance_price']" position="move"/>
            </xpath>
            <!-- o14 มีคอลัมน์น้ำหนักรวมเฉพาะ NPD_Logistics_New (บริษัทเช่าไม่มี) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='total_weight']" position="attributes">
                <attribute name="column_invisible">not parent.is_npd_logistics_company</attribute>
            </xpath>
            <!-- o14 ซ่อน Disc.% ทุกบริษัท (ใช้ประเภทส่วนลด/ปุ่มส่วนลดแทน) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <!-- เหลือช่อง "ราคาต่อหน่วย" ช่องเดียว (Logistics ไม่ถอด VAT ค่าเท่ากับราคาที่กรอก) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="column_invisible">parent.is_npd_logistics_company</attribute>
            </xpath>
        </field>
    </record>
</odoo>
