<odoo>
    <record id="view_users_form_inherit_payment_reprocess" model="ir.ui.view">
        <field name="name">res.users.form.inherit.payment.reprocess</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="สิทธิ์ดำเนินการรับชำระใหม่">
                    <field name="allow_payment_reprocess"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
