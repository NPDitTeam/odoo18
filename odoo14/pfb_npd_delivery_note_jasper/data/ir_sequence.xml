<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- เลขที่ใบส่งมอบสินค้า: RDO-yymmdd + ลำดับ padding 4 (เช่น RDO-2607210001)
             company_id ว่าง = ใช้ร่วมทุกบริษัท (O18 single-DB multi-company) -->
        <record id="seq_npd_delivery_note" model="ir.sequence">
            <field name="name">เลขที่ใบส่งมอบสินค้า</field>
            <field name="code">npd.delivery.note</field>
            <field name="prefix">RDO-%(y)s%(month)s%(day)s</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
