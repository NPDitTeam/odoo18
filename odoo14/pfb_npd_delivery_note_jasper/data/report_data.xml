<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action: ใบส่งมอบสินค้า -->
    <record id="jasper_delivery_note_report" model="ir.actions.report">
        <field name="name">ใบส่งมอบสินค้า</field>
        <field name="model">sale.order</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_delivery_note_jasper/report/delivery_note.jrxml</field>
        <field name="attachment_use">False</field>
        <!-- report_name = URL path segment ห้ามมีสแลช/อักขระพิเศษ -->
        <field name="report_name">delivery_note</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบส่งมอบสินค้า - %s' % (object.delivery_note_no or object.name)</field>
    </record>

    <record id="jasper_delivery_note_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">delivery_note.jrxml</field>
        <field name="report_id" ref="pfb_npd_delivery_note_jasper.jasper_delivery_note_report"/>
        <field name="file" type="base64" file="pfb_npd_delivery_note_jasper/report/delivery_note.jrxml"/>
    </record>
</odoo>
