    <!-- ========================= Scheduled Action: อัพเดททุกวัน ตี 3 ========================= -->
    <data noupdate="1">
        <record id="cron_npd_debt_summary_refresh" model="ir.cron">
            <field name="name">อัพเดทรวมหนี้ลูกค้า (ทุกวัน ตี 3)</field>
            <field name="model_id" ref="model_npd_debt_summary"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).replace(hour=3, minute=0, second=0, microsecond=0)"/>
        </record>
    </data>
