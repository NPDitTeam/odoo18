<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- เลขรันของเลขที่เอกสาร (คำนำหน้ากับปี พ.ศ. ประกอบใน python ที่
             models/debt_summary.py -> _next_debt_doc_name เพราะคำนำหน้าขึ้นกับบริษัท
             และ ir.sequence ใส่ปี พ.ศ. ให้ไม่ได้)
             use_date_range = ตัดรอบทุกปี ขึ้นปีใหม่เลขกลับไปเริ่ม 0001
             o18 เป็นฐานเดียวหลายบริษัท จึงแยก sequence ต่อบริษัทด้วย company_id
             (ของ o14 แยกด้วยการที่แต่ละบริษัทอยู่คนละฐานข้อมูล) -->
        <record id="seq_npd_debt_summary" model="ir.sequence">
            <field name="name">รวมหนี้ลูกค้า</field>
            <field name="code">npd.debt.summary</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
