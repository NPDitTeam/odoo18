<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action for Rental Quotation -->
    <record id="jasper_rental_quotation_report" model="ir.actions.report">
        <field name="name">ใบเสนอราคาเช่าสินค้า</field>
        <field name="model">sale.order</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_rental_quotation_jasper/report/rental_quotation.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบเสนอราคาเช่าสินค้า</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบเสนอราคาเช่าสินค้า - %s' % (object.name)</field>
    </record>

    <!-- Attach the JRXML file to the report -->
    <record id="jasper_rental_quotation_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">rental_quotation.jrxml</field>
        <field name="report_id" ref="pfb_npd_rental_quotation_jasper.jasper_rental_quotation_report"/>
        <field name="file" type="base64" file="pfb_npd_rental_quotation_jasper/report/rental_quotation.jrxml"/>
    </record>
</odoo>
