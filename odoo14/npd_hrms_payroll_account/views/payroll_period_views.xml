<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ปุ่มบนฟอร์มรอบของฝ่ายบุคคล (เห็นเฉพาะคนที่มีสิทธิ์ลงบัญชีเงินเดือน) -->
    <record id="view_payroll_period_form_inherit_payroll_account" model="ir.ui.view">
        <field name="name">payroll.period.form.inherit.payroll.account</field>
        <field name="model">payroll.period</field>
        <field name="inherit_id" ref="npd_hrms_payroll.view_payroll_period_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_cancel']" position="after">
                <button name="action_open_payroll_account_wizard" type="object"
                        string="ลงบัญชีเงินเดือน"
                        groups="npd_hrms_payroll_account.group_payroll_account"
                        invisible="state not in ('approved', 'paid')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_payroll_account_moves" type="object"
                        class="oe_stat_button" icon="fa-book"
                        groups="npd_hrms_payroll_account.group_payroll_account">
                    <field name="npd_account_link_count" widget="statinfo"
                           string="รายการบัญชี"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- วิวของฝ่ายบัญชีแยกต่างหาก priority สูงไว้ไม่ให้แทนวิวหลักของฝ่ายบุคคล
         ไม่แสดงสลิป เพราะกลุ่มนี้ไม่มีสิทธิ์อ่าน payroll.salary -->
    <record id="view_payroll_period_list_account" model="ir.ui.view">
        <field name="name">payroll.period.list.account</field>
        <field name="model">payroll.period</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="รอบเงินเดือน" create="0" edit="0" delete="0">
                <field name="display_name" string="รอบ"/>
                <field name="company_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="payment_date"/>
                <field name="employee_count"/>
                <field name="total_net" sum="รวมสุทธิ"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'approved'"
                       decoration-success="state == 'paid'"/>
                <field name="npd_account_status" widget="badge"
                       groups="npd_hrms_payroll_account.group_payroll_account"
                       decoration-success="npd_account_status == 'done'"
                       decoration-info="npd_account_status == 'partial'"
                       decoration-warning="npd_account_status == 'outdated'"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_period_form_account" model="ir.ui.view">
        <field name="name">payroll.period.form.account</field>
        <field name="model">payroll.period</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="รอบเงินเดือน" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_payroll_account_wizard" type="object"
                            string="ลงบัญชีเงินเดือน" class="btn-primary"
                            invisible="state not in ('approved', 'paid')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="รอบ" name="period">
                            <field name="company_id" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="payment_date" readonly="1"/>
                            <field name="npd_account_status" readonly="1"
                                   groups="npd_hrms_payroll_account.group_payroll_account"/>
                        </group>
                        <group string="ยอดรวมทุกบริษัทในรอบ" name="totals">
                            <field name="total_gross" readonly="1"/>
                            <field name="total_deduction" readonly="1"/>
                            <field name="total_net" readonly="1"/>
                        </group>
                    </group>
                    <separator string="การลงบัญชีรายบริษัท"/>
                    <field name="npd_account_link_ids" readonly="1" nolabel="1"
                           groups="npd_hrms_payroll_account.group_payroll_account">
                        <list decoration-muted="state == 'reversed'"
                              decoration-warning="is_outdated">
                            <field name="company_id"/>
                            <field name="date"/>
                            <field name="move_id"/>
                            <field name="state" widget="badge"/>
                            <field name="is_outdated" widget="boolean"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_npd_payroll_account_period" model="ir.actions.act_window">
        <field name="name">ลงบัญชีเงินเดือน</field>
        <field name="res_model">payroll.period</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('approved', 'paid'))]</field>
        <field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_payroll_period_list_account')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_payroll_period_form_account')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">ยังไม่มีรอบเงินเดือนที่อนุมัติแล้วหรือจ่ายแล้ว</p>
            <p>
                เลือกบริษัทของรอบ (บริษัทที่สร้างรอบ) ในตัวสลับบริษัทด้วย
                รอบที่ยกมาจากระบบเดิมเป็นของบริษัทเอ็นพีดี โลจิสติกส์ แต่มีสลิปของทุกบริษัท
                ระบบจะลงบัญชีแยกตามบริษัทของสลิปให้เอง
            </p>
        </field>
    </record>

</odoo>
