<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- แยกหมวดของตัวเอง ไม่ใส่ในหมวดบัญชี/HRMS: หมวดเหล่านั้นเป็นตัวเลือกแบบ
             dropdown บนหน้าผู้ใช้ กลุ่มที่ไม่ได้ต่อสายสิทธิ์กันจะทำให้ dropdown เพี้ยน -->
        <record id="module_category_npd_payroll_account" model="ir.module.category">
            <field name="name">ลงบัญชีเงินเดือน</field>
            <field name="description">สิทธิ์ลงบัญชีเงินเดือนเข้าบัญชีแยกประเภท</field>
            <field name="sequence">60</field>
        </record>

        <!-- ต้องมีคู่กับ "ผู้ดูแลบัญชี" (ตรวจในโค้ด) เพราะผู้ดูแลบัญชีบน prod มี 83 คน
             รวมพนักงานสาขา ถ้าใช้สิทธิ์นั้นอย่างเดียวทุกคนจะเห็นเงินเดือนรายสาขาทุกบริษัท -->
        <record id="group_payroll_account" model="res.groups">
            <field name="name">ลงบัญชีเงินเดือน (ฝ่ายบัญชี)</field>
            <field name="category_id" ref="module_category_npd_payroll_account"/>
            <field name="comment">ตั้งผังบัญชีเงินเดือน ลงบัญชีและกลับรายการเงินเดือน (ต้องเป็นผู้ดูแลบัญชีด้วย)</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <record id="rule_npd_payroll_account_config_company" model="ir.rule">
            <field name="name">ตั้งค่าลงบัญชีเงินเดือน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_npd_payroll_account_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_npd_payroll_account_map_company" model="ir.rule">
            <field name="name">ผังบัญชีเงินเดือน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_npd_payroll_account_map"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_npd_payroll_account_move_company" model="ir.rule">
            <field name="name">ประวัติการลงบัญชีเงินเดือน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_npd_payroll_account_move"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
