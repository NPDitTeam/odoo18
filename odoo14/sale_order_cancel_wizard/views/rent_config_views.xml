<odoo>
    <record id="view_users_form_inherit_rent_cancel" model="ir.ui.view">
        <field name="name">res.users.form.inherit.rent.cancel</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="สิทธิ์การยกเลิกรายการเช่า">
                    <field name="cancel_rent_same_day"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
