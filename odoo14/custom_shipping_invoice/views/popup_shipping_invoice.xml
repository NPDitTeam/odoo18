<odoo>
    <record id="view_popup_shipping_invoice_form" model="ir.ui.view">
        <field name="name">popup.shipping.invoice.form</field>
        <field name="model">popup.shipping.invoice</field>
        <field name="arch" type="xml">
            <form string="สร้างใบค่าขนส่ง">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="shipping_cost" readonly="1"/>
                    <field name="shipping_product_id" readonly="1"/>
                </group>
                <footer>
                    <button name="action_create_view_invoice"
                            string="Create and View Invoice"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_create_invoice"
                            string="Create Invoice"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
