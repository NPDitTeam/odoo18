<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add quotation's header which in minimum compare to order's -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <xpath expr="/form/header" position="attributes">
                <attribute name="invisible">not order_sequence</attribute>
            </xpath>
            <xpath expr="/form/header" position="inside">
                <button name="action_waiting_to_approve"
                        type="object"
                        string="ส่งอนุมัติค่าประกัน"
                        class="btn-primary"
                        invisible="not button_convert_visible_send"/>
                <button name="action_waiting_to_approve_r"
                        type="object"
                        string="ขออนุมัติส่วนลดค่าเช่า"
                        class="btn-primary"
                        invisible="not button_convert_visible_send_r"/>
                <button name="action_open_approval_popup"
                        type="object"
                        class="btn-success"
                        string="Approve"
                        invisible="not button_visible"/>
                <button name="action_reject"
                        type="object"
                        class="btn-warning"
                        string="Reject"
                        invisible="not button_visible_reject"/>
            </xpath>
            <xpath expr="/form/header" position="after">
                <header name="quotation" invisible="order_sequence">
                    <button name="action_convert_to_order"
                            class="oe_highlight"
                            type="object"
                            string="Convert to Order"
                            invisible="not button_convert_visible"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="quotation_state"
                           widget="statusbar"
                           statusbar_visible="draft,done"/>
                    <button name="action_waiting_to_approve"
                            type="object"
                            string="Send for Approval"
                            class="btn-primary"
                            invisible="not button_convert_visible_send"/>
                    <button name="action_open_approval_popup"
                            type="object"
                            class="btn-success"
                            string="Approve"
                            invisible="not button_visible"/>
                    <button name="action_reject"
                            type="object"
                            class="btn-warning"
                            string="Reject"
                            invisible="not button_visible_reject"/>
                </header>
            </xpath>

            <field name="partner_shipping_id" position="after">
                <field name="order_sequence" invisible="1"/>
                <field name="quote_id" invisible="not order_sequence"
                       context="{'order_sequence': False}"/>
                <field name="order_id" invisible="order_sequence"
                       context="{'order_sequence': True}"/>
                <field name="approver_id" string="Order อนุมัติ" readonly="1"/>
                <field name="state_sale" string="สถานะการตรวจสอบ" readonly="1"/>
                <field name="pfb_amount_insurance" invisible="1"/>
                <field name="button_visible" invisible="1"/>
                <field name="button_convert_visible" invisible="1"/>
                <field name="button_convert_visible_send" invisible="1"/>
                <field name="button_convert_visible_send_r" readonly="0" invisible="1"/>
                <field name="button_visible_reject" invisible="1"/>
            </field>
            <field name="date_order" position="after">
                <field name="c_date" string="วันที่สั่งซื้อย้อนหลัง" readonly="state != 'draft'"/>
            </field>
            <xpath expr="/form/sheet/notebook/page/field[@name='order_line']"
                   position="attributes">
                <attribute name="context">{'order_sequence': order_sequence}</attribute>
            </xpath>
        </field>
    </record>
    <!-- Assign order_sequence to context -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="context">{'default_order_sequence': False, 'order_sequence': False}</field>
        <field name="domain">[('order_sequence', '=', False)]</field>
    </record>
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="context">{'default_order_sequence': True, 'order_sequence': True}</field>
        <field name="domain">[('order_sequence', '=', True)]</field>
    </record>
</odoo>
