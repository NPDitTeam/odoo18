<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <!-- Force delete old sequence then create new -->
    <function model="ir.sequence" name="search">
        <value eval="[('code', '=', 'sale.quotation')]"/>
    </function>

    <!-- Sequence: Quotation QT-YYMMDD-0001 -->
    <record id="seq_sale_quotation" model="ir.sequence" forcecreate="True">
        <field name="name">Quotation</field>
        <field name="code">sale.quotation</field>
        <field name="prefix">QT-%(y)s%(month)s%(day)s-</field>
        <field name="padding">4</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence: Sales Order SO-YYMMDD-0001 -->
    <record id="seq_sale_order" model="ir.sequence" forcecreate="True">
        <field name="name">Sales Order</field>
        <field name="code">sale.order</field>
        <field name="prefix">SO-%(y)s%(month)s%(day)s-</field>
        <field name="padding">4</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
