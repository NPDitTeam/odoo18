<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_line_branch" model="ir.ui.view">
        <field name="name">account.move.form.line.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='partner_id']" position="after">
                <field name="branch_id" optional="show" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
