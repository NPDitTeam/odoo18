				</textElement>
				<textFieldExpression><![CDATA["น้ำหนักรวมสินค้ารวมสุทธิ " + ($F{Total_Weight-jasper_total_weight} != null && !$F{Total_Weight-jasper_total_weight}.isEmpty() ? String.format("%,.2f", Double.parseDouble($F{Total_Weight-jasper_total_weight})) : "0.00") + " กก."]]></textFieldExpression>
