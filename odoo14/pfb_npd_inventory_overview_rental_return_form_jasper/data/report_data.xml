<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action for Rental Return Form -->
    <record id="jasper_rental_return_form_report" model="ir.actions.report">
        <field name="name">ใบคืนการเช่า</field>
        <field name="model">stock.picking</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_inventory_overview_rental_return_form_jasper/report/rental_return_form.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบคืนการเช่า</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบคืนการเช่า - %s' % (object.name)</field>
    </record>

    <!-- Attach the JRXML file to the report -->
    <record id="jasper_rental_return_form_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">rental_return_form.jrxml</field>
        <field name="report_id" ref="pfb_npd_inventory_overview_rental_return_form_jasper.jasper_rental_return_form_report"/>
        <field name="file" type="base64" file="pfb_npd_inventory_overview_rental_return_form_jasper/report/rental_return_form.jrxml"/>
    </record>
</odoo>
