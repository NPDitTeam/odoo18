<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_product_create" model="ir.ui.view">
        <field name="name">res.users.form.inherit.product.create</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="สิทธิ์การสร้างสินค้า">
                    <field name="can_create_product"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
