<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_pnd_accounts" model="ir.ui.view">
        <field name="name">res.company.form.pnd.accounts</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="ภาษีหัก ณ ที่จ่าย" name="npd_pnd_accounts" groups="account.group_account_manager">
                    <group>
                        <group>
                            <field name="account_pnd1_withholding_tax_id"/>
                            <field name="account_pnd1a_withholding_tax_id"/>
                            <field name="account_pnd3_withholding_tax_id"/>
                            <field name="account_pnd3a_withholding_tax_id"/>
                            <field name="account_pnd53_withholding_tax_id"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        ใช้กับหนังสือรับรองหัก ณ ที่จ่ายตอนจ่ายเงิน (หน้ารับชำระ/ใบสำคัญ) ตามแบบ ภ.ง.ด. เหมือน Odoo 14
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
