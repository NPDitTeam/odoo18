<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The number of an entry numbered by a journal ir.sequence is assigned by
         the system on posting, so it must never be editable by hand. -->
    <record id="view_move_form_seq" model="ir.ui.view">
        <field name="name">account.move.form.seq</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h1/field[@name='name']" position="before">
                <field name="use_journal_sequence" invisible="1"/>
            </xpath>
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="readonly">state != 'draft' or use_journal_sequence</attribute>
            </xpath>
        </field>
    </record>

</odoo>
