<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_license_plate_form" model="ir.ui.view">
        <field name="name">fleet.license_plate.form</field>
        <field name="model">fleet.license_plate</field>
        <field name="arch" type="xml">
            <form string="ทะเบียนรถ">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="brand"/>
                        <field name="model"/>
                        <field name="year"/>
                        <field name="employee_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_fleet_license_plate_list" model="ir.ui.view">
        <field name="name">fleet.license_plate.list</field>
        <field name="model">fleet.license_plate</field>
        <field name="arch" type="xml">
            <list string="ทะเบียนรถ">
                <field name="name"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="year"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>
</odoo>
