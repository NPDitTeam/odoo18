<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_refund_note_required" model="ir.ui.view">
        <field name="name">account.move.form.refund.note.required</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='narration']" position="attributes">
                <attribute name="required">move_type == 'out_refund' and state == 'draft'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
