<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ซ่อนตัวแก้ HTML ของ narration แล้ววางช่องข้อความธรรมดาแทนที่ตำแหน่งเดิม
         (ไม่ใช้ replace เพราะวิวอื่นอาจ xpath หา narration) -->
    <record id="view_move_form_refund_note_required" model="ir.ui.view">
        <field name="name">account.move.form.refund.note.required</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='narration']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='narration']" position="after">
                <field name="npd_narration_text" nolabel="1" placeholder="เงื่อนไขและข้อกำหนด"
                       required="move_type == 'out_refund' and state == 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
