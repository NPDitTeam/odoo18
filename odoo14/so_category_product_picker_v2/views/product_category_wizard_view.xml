<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_wizard_form" model="ir.ui.view">
        <field name="name">product.category.wizard.form</field>
        <field name="model">product.category.wizard</field>
        <field name="arch" type="xml">
            <form string="เพิ่มสินค้าตามหมวดหมู่">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="category_id"
                           domain="[('parent_id','!=',False)]"
                           context="{'default_type': 'product'}"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="product_id" invisible="1"/>
                        <field name="bk_reference_code" readonly="1"/>
                        <field name="product_name" readonly="1"/>
                        <field name="product_code" invisible="1"/>
                        <field name="pfb_quantity"/>
                        <field name="product_qty_available" readonly="1"/>
                        <field name="product_weight" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_add_selected_products"
                            type="object"
                            string="เพิ่มเข้าใบเสนอราคา"
                            class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
