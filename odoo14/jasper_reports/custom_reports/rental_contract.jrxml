	<detail>
		<band height="400" splitType="Stretch">
			<!-- ==================== หัวสัญญา ==================== -->
			<staticText>
				<reportElement style="ThaiTitle" positionType="Float" x="0" y="0" width="545" height="26" uuid="c1d2e3f4-0002-0000-0000-000000000001"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Sarabun" size="17" isBold="true"/>
				</textElement>
				<text><![CDATA[สัญญาเช่า อุปกรณ์ก่อสร้าง]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="ThaiBold" positionType="Float" x="250" y="28" width="295" height="16" uuid="c1d2e3f4-0002-0000-0000-000000000002"/>
				<textElement textAlignment="Right">
					<font fontName="Sarabun" size="13" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["เลขที่สัญญาเช่า " + $F{Contract_Base-jasper_rc_contract_base}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="Thai" positionType="Float" x="150" y="46" width="395" height="16" uuid="c1d2e3f4-0002-0000-0000-000000000003"/>
				<textElement textAlignment="Right">
					<font fontName="Sarabun" size="13"/><paragraph lineSpacing="Proportional" lineSpacingSize="0.93"/></textElement>
				<textFieldExpression><![CDATA["ทำที่ " + $F{Lessor_Name-jasper_rc_lessor_name} + " สาขา " + $F{Branch_Name-jasper_rc_branch_name}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="Thai" positionType="Float" x="0" y="64" width="545" height="16" uuid="c1d2e3f4-0002-0000-0000-000000000004"/>
				<textElement textAlignment="Center">
					<font fontName="Sarabun" size="13"/><paragraph lineSpacing="Proportional" lineSpacingSize="0.93"/></textElement>
				<textFieldExpression><![CDATA["วันที่ " + $F{Date_Day-jasper_rc_date_day} + " เดือน " + $F{Date_Month-jasper_rc_date_month} + " พ.ศ. " + $F{Date_Year-jasper_rc_date_year}]]></textFieldExpression>
			</textField>
			<!-- ==================== หน้า 1 : บทนำ + ข้อ 1 ==================== -->
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="Thai" positionType="Float" x="0" y="84" width="545" height="20" uuid="c1d2e3f4-0002-0000-0000-000000000005"/>
				<textElement textAlignment="Left"><font fontName="Sarabun" size="13"/><paragraph lineSpacing="Proportional" lineSpacingSize="0.82"/></textElement>
				<textFieldExpression><![CDATA["      สัญญาเช่าฉบับนี้ทำขึ้น ระหว่าง " + $F{Lessor_Name-jasper_rc_lessor_name} + " โดยพลตรี หรือ นายธีระพล รอดสาตร์ กรรมการผู้มีอำนาจ เลขประจำตัวผู้เสียภาษี " + $F{Lessor_Vat-jasper_rc_lessor_vat} + " ที่อยู่ " + $F{Lessor_Address-jasper_rc_lessor_address} + " ซึ่งต่อไปในสัญญานี้เรียกว่า \"ผู้ให้เช่า\" ฝ่ายหนึ่งกับ\n"
+ $F{Mark_Company-jasper_rc_mark_company} + " นิติบุคคล " + $F{Company_Name-jasper_rc_company_name} + " โดยนาย/นาง/นางสาว.....................................กรรมการผู้มีอำนาจ เลขประจำตัวผู้เสียภาษี " + $F{Company_Vat-jasper_rc_company_vat} + " ที่อยู่ " + $F{Company_Address-jasper_rc_company_address} + "\n"
+ $F{Mark_Person-jasper_rc_mark_person} + " (ชื่อ-นามสกุล) " + $F{Person_Name-jasper_rc_person_name} + " เลขประจำตัวผู้เสียภาษี " + $F{Person_Vat-jasper_rc_person_vat} + " ที่อยู่ " + $F{Person_Address-jasper_rc_person_address} + "\n"
+ "[    ] มอบอำนาจให้ นาย/นาง/นางสาว..............................ถือบัตรประจำตัวประชาชน........................บ้านเลขที่...............\n"
+ "หมู่ที่............ถนน.................................ตำบล/แขวง......................อำเภอ/เขต........................ จังหวัด...........................เบอร์โทรศัพท์..............................ซึ่งต่อไปในสัญญานี้เรียกว่า \"ผู้เช่า\" อีกฝ่ายหนึ่ง\n"
+ "      คู่สัญญาทั้งสองฝ่ายตกลงทำสัญญากันมีข้อความดังต่อไปนี้\n"
+ "ข้อ 1. ผู้เช่าตกลงเช่า เครื่องมือ อุปกรณ์ก่อสร้างต่างๆ ซึ่งต่อไปในสัญญานี้เรียกว่า \"ทรัพย์สินที่เช่า\" จากผู้ให้เช่า มีรายละเอียดเกี่ยวกับทรัพย์สินที่เช่า อันปรากฏตามตารางทรัพย์สิน โดยผู้เช่าได้รับทรัพย์สินที่เช่าดังกล่าวจากผู้ให้เช่าแล้ว ในวันที่ " + $F{Date_Day-jasper_rc_date_day} + " เดือน " + $F{Date_Month-jasper_rc_date_month} + " พ.ศ. " + $F{Date_Year-jasper_rc_date_year} + " ในสภาพเรียบร้อยดีถูกต้องครบถ้วน มีการตรวจสอบเป็นที่พอใจแล้ว\n"
+ "      อนึ่ง หากปรากฏในภายหลังจากทำสัญญาเช่าฉบับนี้ ผู้เช่าประสงค์เช่าทรัพย์สินอื่นๆ เพิ่มเติม หรือนอกเหนือจากตารางด้านล่างนี้ คู่สัญญาทั้งสองฝ่ายให้ยึดถือเอาใบกำกับการเช่า ใบแจ้งหนี้ หรือเอกสารเพิ่มเติมอื่นใดที่ผู้ให้เช่าออกให้ด้วยระบบอิเล็กทรอนิกส์ของผู้ให้เช่าในภายหลัง (ถ้ามี) เป็นส่วนหนึ่งของสัญญาเช่าฉบับนี้ด้วย" + "\n" + "รายละเอียดปรากฏตามใบกำกับการเช่า เลขที่ " + $F{Order_Name-jasper_rc_name} + " ลงวันที่ " + $F{Start_Short-jasper_rc_start_short} + " ยอดเงินสุทธิ " + $F{Amount_Total-jasper_rc_amount_total} + " บาท" + "\n" + "**หมายเหตุ : หากรายการทรัพย์สินที่เช่าไม่เพียงพอ ให้ใช้ใบต่อ หรือใช้ใบกำกับการเช่า หรือใบแจ้งหนี้เพิ่มเติม\n"
+ "      ระยะเวลาเช่ามีกำหนด " + $F{Duration-jasper_rc_duration} + " วัน/เดือน/ปี กำหนดส่งมอบคืน วันที่ " + $F{Return_Day-jasper_rc_return_day} + " เดือน " + $F{Return_Month-jasper_rc_return_month} + " พ.ศ. " + $F{Return_Year-jasper_rc_return_year} + "\n"
+ "ข้อ 2. ผู้เช่าได้ชำระเงินค่าเช่า เป็นจำนวนเงิน " + $F{Invoice_Amount-jasper_rc_invoice_amount} + " บาท (" + $F{Invoice_Amount_Text-jasper_rc_invoice_amount_text} + ") ซึ่งเป็นค่าเช่าของเดือน " + $F{Date_Month-jasper_rc_date_month} + " พ.ศ. " + $F{Date_Year-jasper_rc_date_year} + " ส่วนค่าเช่าของเดือนถัดไป หรือค่าเช่าส่วนที่เหลือ (ถ้ามี) ผู้เช่าตกลงว่าจะชำระให้แก่ผู้ให้เช่า ตามกำหนดใบแจ้งหนี้ และ/หรือในวันที่ผู้เช่าส่งมอบคืนทรัพย์สินที่เช่าทันที\n"
+ "ข้อ 3. ผู้เช่าตกลงวางหลักประกันไว้ให้แก่ผู้ให้เช่าในวันทำสัญญาฉบับนี้ โดยถือว่าเป็นประกันทรัพย์สินที่เช่าตามสัญญา รวมไปถึงใบกำกับการเช่า ใบแจ้งหนี้ หรือเอกสารเพิ่มเติมอื่นใดซึ่งถือเป็นการเช่าเพิ่มเติมนอกเหนือจากสัญญาฉบับนี้\n"
+ "        [    ] 3.1 วางเงินสดมัดจำประกันความเสียหายทรัพย์สินที่เช่า เป็นจำนวนเงิน...........................................บาท (..............................................................................)\n"
+ "        [    ] 3.2 ค่าเช่าล่วงหน้า ด้วยเช็คธนาคาร.....................................เช็คเลขที่.......................... ลงวันที่........................จำนวน....................บาท (...........................................)\n"
+ "        [    ] 3.3 หนังสือค้ำประกันธนาคาร (BG) .....................................เลขที่.......................... ลงวันที่........................จำนวน....................บาท (...........................................)\n"
+ "        [    ] 3.4 อื่นๆ ...................................................................................................................................\n"
+ "      ในกรณีที่ผู้เช่าผิดสัญญา ไม่ชำระค่าเช่า ไม่ส่งมอบคืนทรัพย์สินที่เช่า หรือมีความเสียหายเกิดขึ้นแก่ทรัพย์สินที่เช่าในระหว่างอายุของสัญญา ไม่ว่าจะเป็นการชำรุดบกพร่อง การสูญหายซึ่งทรัพย์สินที่เช่า หรือความเสียหายอื่นๆ อันเกิดจากพฤติกรรมของผู้เช่า รวมไปถึงกรณีความเสียหายเกิดจากเหตุสุดวิสัย เช่น ทรัพย์สินที่เช่าถูกโจรกรรม อัคคีภัย วินาศภัย บุบสลายด้วยภัยใดๆ ผู้เช่าตกลงยินยอมให้ผู้ให้เช่าริบหลักประกันดังกล่าวได้โดยทันที เพื่อชำระค่าเช่าที่ค้างชำระ รวมถึงเพื่อชดใช้มูลค่าความเสียหายตามจำนวนจริง หากมูลค่าความเสียหายนั้นเกินกว่ามูลค่าของหลักประกัน ผู้เช่าตกลงใช้ค่าเสียหายส่วนต่างที่เกินกว่ามูลค่าหลักประกัน จนกว่าจะครบจำนวนมูลค่าความเสียหาย"]]></textFieldExpression>
			</textField>
			<!-- ==================== ขึ้นหน้า 2 : เริ่มข้อ 4 ==================== -->
			<break type="Page">
				<reportElement positionType="Float" x="0" y="106" width="545" height="1" uuid="c1d2e3f4-0002-0000-0000-0000000000b1"/>
			</break>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="Thai" positionType="Float" x="0" y="108" width="545" height="20" uuid="c1d2e3f4-0002-0000-0000-0000000000b2"/>
				<textElement textAlignment="Left"><font fontName="Sarabun" size="13"/><paragraph lineSpacing="Proportional" lineSpacingSize="0.82"/></textElement>
				<textFieldExpression><![CDATA["ข้อ 4. ผู้เช่าสัญญาว่าจะนำทรัพย์สินที่เช่าไปใช้ ณ " + $F{On_Site-jasper_rc_on_site} + " โดยจะไม่ยักย้าย ทำลาย แก้ไข ทำเครื่องหมายใดๆ กับทรัพย์สินที่เช่า โอนการครอบครอง หรือกระทำการใดๆ ที่เป็นอันส่งมอบให้แก่บุคคลภายนอกซึ่งไม่ผูกพันในสัญญาฉบับนี้ และจะดูแลรักษาอย่างวิญญูชนพึงสงวนทรัพย์สินของตนเองเป็นอย่างดีตลอดอายุสัญญาฉบับนี้ และผู้เช่ายินยอมให้ผู้ให้เช่าหรือตัวแทน เข้าตรวจดูแลทรัพย์สินที่เช่าได้ตามระยะเวลาอันสมควร\n"
+ "ข้อ 5. ผู้เช่าตกลงใช้งานทรัพย์สินที่เช่าด้วยความระมัดระวัง เหมาะสมตามวัตถุประสงค์ของการเช่าเท่านั้น และตกลงบำรุงรักษาทรัพย์สินที่เช่าให้อยู่ในสภาพที่ดีใช้งานได้ดีตลอดเวลาด้วยค่าใช้จ่ายของตนเอง ในกรณีผู้เช่าไม่บำรุงรักษา หรือซ่อมแซมทรัพย์สินที่เช่าให้อยู่ในสภาพที่ดี ผู้ให้เช่ามีสิทธิที่จะบำรุงรักษาและซ่อมแซมเอง โดยผู้เช่าจะต้องเป็นผู้รับผิดชอบออกค่าใช้จ่ายที่เกิดขึ้นทั้งสิ้น\n"
+ "ข้อ 6. ผู้เช่าสามารถตกลงเงื่อนไขในการขนส่งทรัพย์สินที่เช่าได้ดังต่อไปนี้\n"
+ "        6.1 ผู้เช่าตกลงเป็นผู้ขนส่งทรัพย์สินที่เช่าทั้งขาไป (เริ่มเช่า) และขากลับ (ส่งคืน) ด้วยค่าใช้จ่ายผู้เช่าเองทั้งหมด\n"
+ "        6.2 ผู้เช่าตกลงว่าจ้างผู้ให้เช่าขนส่งทั้งขาไปและขากลับ หรืออย่างใดอย่างหนึ่ง โดยคิดอัตราค่าจ้างขนส่งตามเงื่อนไขของผู้ให้เช่า ทั้งนี้ ผู้เช่าจะเป็นผู้รับภาระชำระค่าจ้างขนส่งรวมถึงค่าใช้จ่ายใดๆ ที่เกี่ยวเนื่องกับการขนส่งนั้นเองทั้งสิ้น และจะชำระทันทีเมื่อได้รับแจ้งค่าขนส่ง\n"
+ "ข้อ 7. ผู้เช่าตกลงว่า ในระหว่างที่ทรัพย์สินที่เช่าอยู่ในความครอบครองของผู้เช่า หากเกิดการชำรุดบกพร่อง หรือสูญหายด้วยประการใดๆ โดยไม่คำนึงว่าจะเป็นความผิดของผู้เช่าหรือไม่ ผู้ให้เช่ามีสิทธิบอกเลิกสัญญาได้ทันที และผู้เช่าตกลงใช้ค่าเสียหายให้แก่ผู้ให้เช่าตามราคาที่ผู้ให้เช่ากำหนด\n"
+ "      อันทรัพย์สินที่เช่าที่ถูกโจรกรรม อัคคีภัย วินาศภัย หรือบุบสลายด้วยภัยใดๆ ผู้ให้เช่ามีสิทธิบอกเลิกสัญญาได้ทันที และผู้ให้เช่ามีสิทธิเรียกค่าเสียหายได้\n"
+ "      หากทรัพย์สินที่เช่าก่อให้เกิดความเสียหายต่อบุคคลภายนอก หรือทรัพย์สินใดๆ ของบุคคลภายนอกในระหว่างการเช่า ผู้เช่าตกลงยอมรับผิดเพื่อการนั้น และชดใช้ความเสียหายให้บุคคลภายนอกแต่เพียงฝ่ายเดียว\n"
+ "ข้อ 8. ชั่วโมงการทำงานของทรัพย์สินที่เช่า เช่น เครื่องจักร หรือเครื่องมือต่างๆ เท่ากับ 8 (แปด) ชั่วโมงต่อวัน หากเกินกว่ากำหนดจะคิดเฉลี่ยเป็นรายชั่วโมง\n"
+ "ข้อ 9. ในกรณีที่ผู้เช่าได้มอบหมายให้บุคคลหนึ่งบุคคลใดมีอำนาจลงนามในใบสั่งซื้อหรือทำนิติกรรมใดๆ แทนผู้เช่า ต้องแจ้งแก่ผู้ให้เช่าเป็นลายลักษณ์อักษร หรือแสดงหนังสือมอบอำนาจ มิฉะนั้นผู้ให้เช่าจะถือว่าค่าใช้จ่ายใดๆ อันเกิดจากบุคคลดังกล่าวตามที่ได้รับมอบหมายเดิมเป็นความรับผิดชอบของผู้เช่าทั้งสิ้น"]]></textFieldExpression>
			</textField>
			<!-- ==================== ขึ้นหน้า 3 : เริ่มข้อ 10 ==================== -->
			<break type="Page">
				<reportElement positionType="Float" x="0" y="118" width="545" height="1" uuid="c1d2e3f4-0002-0000-0000-0000000000b5"/>
			</break>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="Thai" positionType="Float" x="0" y="120" width="545" height="20" uuid="c1d2e3f4-0002-0000-0000-0000000000b6"/>
				<textElement textAlignment="Left"><font fontName="Sarabun" size="13"/><paragraph lineSpacing="Proportional" lineSpacingSize="0.82"/></textElement>
				<textFieldExpression><![CDATA["ข้อ 10. เมื่อครบกำหนดระยะเวลาการเช่า หากผู้เช่าไม่ติดต่อชำระค่าเช่า หรือไม่ส่งคืนทรัพย์สินที่เช่า ผู้ให้เช่ามีสิทธิเข้าเก็บทรัพย์สินที่เช่าคืนทันทีโดยปราศจากข้อโต้แย้ง และสามารถคิดค่าปรับ หรือค่าขาดประโยชน์ค่าเสียหายใดๆ ตามเงื่อนไขของผู้ให้เช่า หรือ\n"
+ "      เมื่อครบกำหนดระยะเวลาตามสัญญาแล้ว ผู้เช่ายังมิได้ส่งมอบทรัพย์สินที่เช่าคืนให้แก่ผู้ให้เช่า และหากผู้ให้เช่ายังมิได้ทักท้วง ให้ถือว่าสัญญาเช่านั้นเป็นการเช่าแบบไม่มีกำหนดระยะเวลา โดยผู้ให้เช่ามิต้องแจ้งให้ผู้เช่าทราบล่วงหน้า และจะมีผลบังคับเป็นการคิดค่าเช่าที่เกินกำหนดได้ทันทีนับตั้งแต่วันถัดจากวันสิ้นสุดสัญญาเดิม ไปจนกว่าผู้เช่าจะคืนทรัพย์สินที่เช่าทั้งหมด หรือผู้ให้เช่าได้ใช้สิทธิบอกเลิกสัญญาเช่า\n"
+ "ข้อ 11. การส่งมอบทรัพย์สินที่เช่าคืนนั้น คู่สัญญาทั้งสองฝ่ายกำหนดให้ตรวจนับจำนวนของทรัพย์สินที่เช่า รวมถึงตรวจสอบความชำรุดบกพร่อง หรือความเสียหาย สูญหายของทรัพย์สินที่เช่าตามสัญญาหรือใบกำกับการเช่านั้นๆ หากพบกรณีดังกล่าวต้องระบุไว้ในใบตรวจรับสินค้าให้ชัดเจน หากผู้เช่าฝ่าฝืนไม่ร่วมตรวจนับ คู่สัญญาทั้งสองฝ่ายถือให้การตรวจนับนั้น ถูกต้อง และได้รับทราบกันทั้งสองฝ่ายโดยไม่ข้อโต้แย้งใดๆ\n" + "ข้อ 12. กรณีผู้เช่าเป็นผู้ดำเนินการขนส่งทรัพย์สินที่เช่าด้วยตนเองตามข้อ 6.1 เมื่อครบกำหนดระยะเวลาการเช่า หรือกรณีสัญญาเลิกกันไม่ว่าด้วยเหตุใด ผู้เช่าต้องขนย้ายทรัพย์สินที่เช่าส่งคืนผู้ให้เช่า ณ สถานที่ของผู้ให้เช่าในสภาพเรียบร้อยทันที หากผู้เช่าไม่ปฏิบัติตาม ผู้เช่ายินยอมชดใช้ค่าปรับให้แก่ผู้ให้เช่าเป็นรายได้ในอัตราที่ผู้ให้เช่ากำหนด รายละเอียดตามใบเสนอราคา นับตั้งแต่วันที่สัญญาสิ้นสุดลง ไปจนกว่าจะมีการส่งมอบทรัพย์สินคืนให้แก่ผู้ให้เช่า หรือผู้ให้เช่าได้กลับเข้าครอบครองทรัพย์สินที่เช่าด้วยตนเอง ในกรณีที่ผู้เช่าไม่ส่งมอบคืนซึ่งทรัพย์สินที่เช่าไม่ว่าด้วยเหตุใดๆ ผู้ให้เช่าชอบที่จะใช้สิทธิเรียกให้ผู้เช่าใช้ราคาของทรัพย์สินที่เช่าแทนการส่งมอบทรัพย์สินคืนได้\n"
+ "ข้อ 13. หากกรณีผู้เช่าไม่สามารถส่งมอบทรัพย์สินที่เช่าคืนแก่ผู้ให้เช่าได้ตรงตามกำหนดระยะเวลา ผู้เช่ามีหน้าที่เร่งแจ้งให้ผู้ให้เช่าทราบล่วงหน้าเป็นลายลักษณ์อักษร หากผู้เช่าไม่ปฏิบัติตามให้ถือว่าผู้เช่าผิดสัญญา และผู้ให้เช่าสงวนสิทธิบังคับตามข้อ 10. ทันที\n"
+ "ข้อ 14. ความรับผิดของผู้เช่าจะระงับลง หรือสิ้นสุดลงต่อเมื่อ ผู้เช่าได้ชำระค่าเช่าครบถ้วนแล้ว และผู้เช่าได้นำทรัพย์สินที่เช่าส่งคืนให้แก่ผู้ให้เช่า พร้อมมีการตรวจรับ ตรวจสอบสภาพของทรัพย์สินที่เช่า เว้นแต่ปรากฏว่าทรัพย์สินที่เช่าอยู่ในสภาพชำรุด เสียหาย ไม่สามารถใช้งานได้ตามปกติ ผู้เช่าจะต้องรับผิดชดใช้ค่าเสียหายเพื่อความชำรุดของทรัพย์สินที่เช่านั้นตามเงื่อนไขของผู้ให้เช่า\n" + "ข้อ 15. คู่สัญญาทั้งสองฝ่ายจะต้องปฏิบัติตามข้อตกลงโดยเคร่งครัด การเปลี่ยนแปลง แก้ไขใดๆ จะทำได้เฉพาะแต่ความยินยอมของทั้งสองฝ่าย และทำเป็นลายลักษณ์อักษร"]]></textFieldExpression>
			</textField>
			<!-- ==================== ขึ้นหน้า 4 : เริ่มข้อ 16 + ลงนาม ==================== -->
			<break type="Page">
				<reportElement positionType="Float" x="0" y="130" width="545" height="1" uuid="c1d2e3f4-0002-0000-0000-0000000000b3"/>
			</break>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement style="Thai" positionType="Float" x="0" y="132" width="545" height="20" uuid="c1d2e3f4-0002-0000-0000-0000000000b4"/>
				<textElement textAlignment="Left"><font fontName="Sarabun" size="13"/><paragraph lineSpacing="Proportional" lineSpacingSize="0.82"/></textElement>
				<textFieldExpression><![CDATA["ข้อ 16. หากผู้เช่าผิดสัญญาข้อใดข้อหนึ่ง ให้ถือว่าสัญญาเป็นอันสิ้นสุดลงโดยมิต้องบอกกล่าวล่วงหน้า และผู้ให้เช่าย่อมทรงสิทธิในการกลับเข้าครอบครองทรัพย์สินที่เช่าได้โดยพลัน ทั้งนี้การสิ้นสุดสัญญาไม่ตัดสิทธิของผู้ให้เช่าในการเรียกค่าเช่าที่ค้างชำระ หรือค่าเสียหายต่อทรัพย์สินที่เช่า หรือค่าอุปกรณ์ใดๆ ที่ผู้เช่ามีภาระติดพันกับผู้ให้เช่าตามสัญญา\n"
+ "ข้อ 17. ผู้ให้เช่าย่อมใช้สิทธิบอกกล่าวให้ผู้เช่าปฏิบัติตามสัญญานี้ หรือบอกเลิกสัญญานี้ หรือเรียกค่าเสียหายกับผู้เช่าได้ทันที เมื่อปรากฏว่าผู้เช่าผิดสัญญานี้ข้อหนึ่งข้อใด หรือหลายข้อรวมกัน และ/หรือผู้ให้เช่าได้บอกกล่าวแล้วแต่ผู้เช่าเพิกเฉย\n"
+ "ข้อ 18. ผู้เช่าตกลงให้คิดดอกเบี้ยในอัตราร้อยละ 15 ต่อปีของยอดเงินค่าเช่าที่ค้างชำระ หรือค่าเสียหายที่ผู้ให้เช่าเรียกจากผู้เช่าได้ ตลอดจนค่าใช้จ่ายต่างๆ ที่ผู้ให้เช่าต้องเสียไปเพื่อการติดตามให้ชำระค่าเช่าที่ค้างชำระ\n"
+ "      สัญญาฉบับนี้ทำขึ้นสองฉบับ มีข้อความถูกต้องตรงกัน คู่สัญญาได้อ่านและเข้าใจข้อความโดยตลอดแล้ว เห็นว่าถูกต้องตามความประสงค์ จึงได้ลงลายมือชื่อและประทับตรา (ถ้ามี) ไว้เป็นหลักฐานต่อหน้าพยานเป็นสำคัญ"]]></textFieldExpression>
			</textField>
			
			
<!-- หมายเหตุ + ระยะเวลา + ข้อ 2 + ข้อ 3 -->
			
			<!-- ==================== หน้า 2 : ข้อ 4 - ข้อ 15 ==================== -->
			
			<!-- ==================== หน้า 3 : ข้อ 16 - ข้อ 18 + ลงนาม ==================== -->
			
			<!-- ตราประทับ -->
			<rectangle>
				<reportElement positionType="Float" mode="Transparent" x="20" y="210" width="55" height="32" uuid="c1d2e3f4-0002-0000-0000-00000000000d">
