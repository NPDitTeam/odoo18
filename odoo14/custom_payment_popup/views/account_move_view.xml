<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_payment_button" model="ir.ui.view">
        <field name="name">account.move.form.payment.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_payment_form"
                        type="object"
                        string="ชำระเงิน"
                        class="btn-primary"
                        invisible="state != 'posted' or payment_state == 'paid'"
                        icon="fa-money"/>
            </xpath>
            <!-- ซ่อนปุ่มมาตรฐาน "จ่าย" (Register Payment) เหมือน o14 pfb_account_move — ให้รับชำระผ่าน "ชำระเงิน" ของ NPD
                 และปุ่ม "พิมพ์" (PDF มาตรฐาน) ใช้แบบฟอร์ม NPD จากเมนูพิมพ์แทน -->
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//header/button[@name='action_print_pdf'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//header/button[@name='action_print_pdf'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
