<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            คำนวณค่าเสื่อมของปีปัจจุบันให้เองทุกเดือน
            ตั้งเป็นรายเดือนเพราะพอขึ้นเดือนใหม่ ยอดของเดือนนั้นถึงจะครบ
            การคำนวณทับได้ไม่มีปัญหา เดือนที่ลงบัญชีไปแล้วจะไม่ถูกแตะ
            (ดู npd_compute_year ใน models/account_asset.py)

            ลงบัญชีให้เฉพาะสินทรัพย์ที่กด "เริ่มคิดค่าเสื่อม" แล้ว และเฉพาะเดือนที่ผ่านไปแล้ว

            o18 ไม่มี numbercall แล้ว (รันไม่จำกัดเสมอ)
            รอบแรก 00:30 วันที่ 1 ของเดือนถัดไปตามเวลาไทย (เซิร์ฟเวอร์เก็บเวลาเป็น UTC)
        -->
        <record id="cron_npd_compute_depreciation" model="ir.cron">
            <field name="name">คำนวณค่าเสื่อมราคาประจำเดือน</field>
            <field name="model_id" ref="model_account_asset"/>
            <field name="state">code</field>
            <field name="code">model.cron_npd_compute_current_year()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="((DateTime.utcnow() + relativedelta(months=1)).replace(day=1, hour=0, minute=30, second=0, microsecond=0) - relativedelta(hours=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
