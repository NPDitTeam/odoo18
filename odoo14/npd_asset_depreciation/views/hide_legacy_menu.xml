<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        ปิดเมนู "Compute Assets" ของระบบเดิม กันคนเผลอกดแล้วได้สมุดรายวัน
        ค่าเสื่อมอีกชุดที่คิดคนละสูตรกับโมดูลนี้
        ถ้าวันหลังอยากเปิดคืน ตั้ง active กลับเป็น True ได้จากเมนูการตั้งค่า
    -->
    <record id="account_asset_management.account_asset_compute_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
