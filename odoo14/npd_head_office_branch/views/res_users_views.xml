<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- หน้าตั้งค่าผู้ใช้: สิทธิ์แก้ไขสาขาสำนักงานใหญ่เอง -->
    <record id="view_users_form_head_office_branch" model="ir.ui.view">
        <field name="name">res.users.form.head.office.branch</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="สิทธิ์สาขาสำนักงานใหญ่" name="head_office_branch_rights">
                    <field name="allow_edit_head_office_branch"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
