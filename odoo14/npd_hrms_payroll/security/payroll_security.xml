<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_payroll_policy_company" model="ir.rule">
            <field name="name">นโยบายเงินเดือน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_payroll_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_payroll_period_company" model="ir.rule">
            <field name="name">รอบทำเงินเดือน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
