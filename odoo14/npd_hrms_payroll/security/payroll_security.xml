            <field name="global" eval="True"/>
        </record>

        <record id="rule_payroll_salary_company" model="ir.rule">
            <field name="name">สลิปเงินเดือน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_payroll_salary"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_other_income_company" model="ir.rule">
            <field name="name">เงินได้อื่นๆ: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
