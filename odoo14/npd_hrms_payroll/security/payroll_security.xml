            <field name="global" eval="True"/>
        </record>

        <record id="rule_work_security_deposit_company" model="ir.rule">
            <field name="name">เงินประกันการทำงาน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_work_security_deposit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
