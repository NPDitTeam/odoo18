<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_other_income_list" model="ir.ui.view">
        <field name="name">other.income.list</field>
        <field name="model">other.income</field>
        <field name="arch" type="xml">
            <list string="เงินได้อื่นๆ" decoration-success="state == 'confirmed'">
                <field name="employee_code"/>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="total_amount" sum="รวม"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_other_income_form" model="ir.ui.view">
        <field name="name">other.income.form</field>
        <field name="model">other.income</field>
        <field name="arch" type="xml">
            <form string="เงินได้อื่นๆ">
                <header>
                    <button name="action_confirm" type="object" string="ยืนยัน"
                            class="btn-primary" invisible="state == 'confirmed'"/>
                    <button name="action_reset_draft" type="object" string="กลับเป็นร่าง"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"
                                   readonly="state == 'confirmed'"/>
                            <field name="employee_code"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="position_id"/>
                            <field name="total_amount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายการ" name="lines">
                            <field name="line_ids" readonly="state == 'confirmed'">
                                <list editable="bottom">
                                    <field name="payment_date"/>
                                    <field name="note"/>
                                    <field name="amount" sum="รวม"/>
                                    <field name="attachment" widget="binary"
                                           filename="attachment_filename"/>
                                    <field name="attachment_filename" column_invisible="1"/>
                                </list>
                            </field>
                            <div class="alert alert-info" role="alert">
                                ยอดจะเข้าสลิปของรอบที่ "วันที่จ่ายเงิน" ตกอยู่ — อิงรอบตัดเงินเดือน
                                ไม่ใช่เดือนปฏิทิน
                            </div>
                        </page>
                        <page string="หมายเหตุ" name="note">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_other_income" model="ir.actions.act_window">
        <field name="name">เงินได้อื่นๆ</field>
        <field name="res_model">other.income</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีรายการเงินได้อื่นๆ</p>
        </field>
    </record>

</odoo>
