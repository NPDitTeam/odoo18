<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- แท็บบุคคลพิเศษบนบัตรพนักงาน
         แทน EXECUTIVE_TAX_CONFIG / EXECUTIVE_EMPLOYEE_CODES ที่ Odoo 14 ฝังรหัสไว้ในโค้ด -->
    <record id="view_employee_salary_form_payroll" model="ir.ui.view">
        <field name="name">employee.salary.form.inherit.payroll</field>
        <field name="model">employee.salary</field>
        <field name="inherit_id" ref="npd_hrms_base.view_employee_salary_form"/>
        <field name="arch" type="xml">
            <!-- ปิดสถานะพนักงาน = ต้องมีวันที่ออกจากงานเสมอ
                 วันที่นี้คือตัวคุมสูตรคืนเงินประกันการทำงาน ถ้าไม่ใส่ รายการเงินประกัน
                 จะค้างเป็น "ทำงานอยู่" และยอดที่ต้องคืนไม่ขึ้น -->
            <xpath expr="//field[@name='resign_date']" position="attributes">
                <attribute name="required">status == 'inactive'</attribute>
            </xpath>

            <xpath expr="//page[@name='payroll']" position="after">
                <page string="พักงาน" name="suspension"
                      groups="npd_hrms_base.group_hrms_payroll">
                    <div class="alert alert-info" role="alert">
                        บันทึกช่วงวันที่ถูกสั่งพักงาน <b>ไม่ต้องระบุรอบเงินเดือน</b>
                        ระบบหาเองว่าตกรอบไหน ตอนคำนวณสลิปจะดึงไปคิดให้อัตโนมัติ<br/>
                        นับทุกวันในช่วงนั้น <b>รวมวันหยุดด้วย</b> และหักตาม % ที่ตั้งไว้
                        (ค่าเริ่มต้น 50%)<br/>
                        เหตุผลที่กรอกจะถูกแสดงในแอปตอนพนักงานกดเข้าหน้าลงเวลา
                    </div>
                    <field name="is_suspended_today" invisible="1"/>
                    <field name="suspension_ids" nolabel="1">
                        <list editable="bottom" decoration-muted="not active">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="day_count" readonly="1"/>
                            <field name="deduct_percent"/>
                            <field name="reason"/>
                            <field name="period_hint" readonly="1"/>
                            <field name="note" optional="hide"/>
                            <field name="active" optional="show"/>
                        </list>
                    </field>
                </page>
                <page string="กติกาเงินเดือนเฉพาะบุคคล" name="payroll_special"
                      groups="npd_hrms_base.group_hrms_payroll">
                    <group>
                        <field name="payroll_special_case"/>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not payroll_special_case">
                        พนักงานคนนี้ถูกตั้งกติกาเฉพาะ — ระบบจะ<b>ไม่</b>คำนวณตามสูตรปกติ
                        ในหัวข้อที่ระบุไว้ด้านล่าง กรุณาบันทึกเหตุผลไว้ด้วยเพื่อการตรวจสอบ
                    </div>
                    <group invisible="not payroll_special_case">
                        <group string="ภาษี">
                            <field name="payroll_tax_mode"/>
                            <field name="payroll_fixed_tax_amount"
                                   invisible="payroll_tax_mode != 'fixed'"/>
                        </group>
                        <group string="ประกันสังคม">
                            <field name="payroll_sso_mode"/>
                            <field name="payroll_fixed_sso_amount"
                                   invisible="payroll_sso_mode != 'fixed'"/>
                        </group>
                    </group>
                    <group invisible="not payroll_special_case">
                        <group string="เวลาทำงาน">
                            <field name="payroll_exempt_attendance"/>
                            <field name="payroll_exempt_ot"/>
                        </group>
                    </group>
                    <group string="เหตุผล" invisible="not payroll_special_case">
                        <field name="payroll_special_note" nolabel="1"
                               placeholder="เช่น ผู้บริหารไม่ต้องลงเวลา และตกลงภาษีคงที่เดือนละ 5,000 บาท ตามมติที่ประชุม..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
