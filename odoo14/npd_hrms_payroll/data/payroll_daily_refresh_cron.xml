<?xml version="1.0" encoding="utf-8"?>
<!--
    อัพเดทข้อมูลเงินเดือนรายวัน

    ตรงกับฝั่ง Odoo 14 ที่ cron ตามอัพเดท OT/สาย/ขาด/ลา ให้ทุกวัน
    จนถึงวันที่ที่ตั้งไว้ในช่อง "อัพเดทถึงวันที่" ของแต่ละรอบ (ค่าเริ่มต้น 26)

    เปลี่ยน "เวลา" ที่รันได้ที่ ตั้งค่า > เทคนิค > อัตโนมัติ > การกระทำตามกำหนดเวลา
    (ห้ามแก้ไฟล์นี้ เพราะ noupdate="1" มีผลแค่ตอนติดตั้งครั้งแรก)
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_payroll_daily_refresh" model="ir.cron">
            <field name="name">อัพเดทข้อมูลเงินเดือน (รายวัน)</field>
            <field name="model_id" ref="model_payroll_period"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_refresh()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
