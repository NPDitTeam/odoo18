<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_npd_account_lock_wizard_form" model="ir.ui.view">
        <field name="name">npd.account.lock.wizard.form</field>
        <field name="model">npd.account.lock.wizard</field>
        <field name="arch" type="xml">
            <form string="ล็อกงวดบัญชี">
                <div class="alert alert-info" role="alert">
                    วันที่ในแต่ละช่อง = ล็อกเอกสารที่ลงวันที่ตั้งแต่วันนั้นย้อนลงไป (รวมวันนั้น)
                    · ช่องว่าง = ไม่ล็อก
                    · ระบบไม่ได้ห้ามผ่านรายการเอกสารที่ลงวันที่ในช่วงล็อก แต่จะย้ายวันที่บัญชีไปงวดแรกที่ยังเปิด
                    จึงควรผ่านรายการเอกสารของงวดนั้นให้ครบก่อนล็อก
                    · ปิดสิ้นปี: ลงค่าเสื่อมเดือนสุดท้ายและทำรายการปิดบัญชีสิ้นปีให้เสร็จก่อนล็อกวันสุดท้ายของปี
                    เพราะรายการที่ผ่านทีหลังจะถูกย้ายไปปีถัดไป
                    · ชี้ที่ชื่อช่องเพื่อดูว่าแต่ละตัวล็อกอะไร
                    · ล็อกได้ไม่เกินวันสิ้นเดือนที่แล้ว
                </div>

                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>

                <!-- ค่าปัจจุบัน (orig_*) ต้อง force_save ให้หน้าเว็บส่งค่าตอนเปิดกลับมา ใช้ตรวจว่ามีคนอื่นแก้ระหว่างนั้นหรือไม่ -->
                <group string="วันล็อก">
                    <label for="new_fiscalyear_lock_date"/>
                    <div class="o_row">
                        <field name="new_fiscalyear_lock_date"/>
                        <span class="text-muted">ปัจจุบัน</span>
                        <field name="orig_fiscalyear_lock_date" readonly="1" force_save="1" nolabel="1"/>
                    </div>
                    <label for="new_tax_lock_date"/>
                    <div class="o_row">
                        <field name="new_tax_lock_date"/>
                        <span class="text-muted">ปัจจุบัน</span>
                        <field name="orig_tax_lock_date" readonly="1" force_save="1" nolabel="1"/>
                    </div>
                    <label for="new_sale_lock_date"/>
                    <div class="o_row">
                        <field name="new_sale_lock_date"/>
                        <span class="text-muted">ปัจจุบัน</span>
                        <field name="orig_sale_lock_date" readonly="1" force_save="1" nolabel="1"/>
                    </div>
                    <label for="new_purchase_lock_date"/>
                    <div class="o_row">
                        <field name="new_purchase_lock_date"/>
                        <span class="text-muted">ปัจจุบัน</span>
                        <field name="orig_purchase_lock_date" readonly="1" force_save="1" nolabel="1"/>
                    </div>
                    <label for="new_hard_lock_date"/>
                    <div class="o_row">
                        <field name="new_hard_lock_date"/>
                        <span class="text-muted">ปัจจุบัน</span>
                        <field name="orig_hard_lock_date" readonly="1" force_save="1" nolabel="1"/>
                    </div>
                </group>

                <!-- ฟิลด์คำนวณที่ใช้ซ่อน/แสดงคำเตือน -->
                <field name="has_unlock" invisible="1"/>
                <field name="hard_lock_changed" invisible="1"/>
                <field name="no_posted_moves" invisible="1"/>
                <field name="new_effective_date" invisible="1"/>

                <div class="alert alert-warning" role="alert" invisible="not has_unlock">
                    กำลังปลดล็อกหรือถอยวันล็อกย้อนหลัง เอกสารในช่วงที่ปลดจะแก้ไข/ยกเลิกได้อีก
                    ต้องกรอกเหตุผล และระบบจะบันทึกไว้ในประวัติ
                </div>

                <div class="alert alert-warning" role="alert" invisible="not draft_move_count">
                    มีเอกสารร่าง <field name="draft_move_count" class="oe_inline" readonly="1"/> ใบ
                    ลงวันที่ในช่วงที่จะล็อก: ล็อกถาวรต้องผ่านรายการหรือลบให้หมดก่อน (ระบบไม่ยอม)
                    · ปิดงวดธรรมดา เอกสารเหล่านี้เมื่อผ่านรายการทีหลังจะถูกย้ายวันที่ไปงวดถัดไป
                    <button name="action_view_draft_moves" type="object" class="btn-link"
                            string="ดูเอกสารร่าง"/>
                </div>

                <div class="alert alert-warning" role="alert" invisible="not pending_depreciation_count">
                    มีค่าเสื่อมราคาที่ยังไม่ลงบัญชี
                    <field name="pending_depreciation_count" class="oe_inline" readonly="1"/> รายการ (สินทรัพย์ x เดือน)
                    ในช่วงที่จะล็อก งานตั้งเวลาจะลงบัญชีให้ทีหลัง แล้วสมุดรายวันค่าเสื่อมจะถูกย้ายวันที่ไปงวดถัดไป
                    ควรลงบัญชีค่าเสื่อมของงวดนี้ให้ครบก่อนล็อก
                    <button name="action_view_pending_depreciation" type="object" class="btn-link"
                            string="ดูค่าเสื่อมที่ยังไม่ลงบัญชี"/>
                </div>

                <div class="alert alert-warning" role="alert" invisible="not unreconciled_line_count">
                    มีรายการเดินบัญชีธนาคาร
                    <field name="unreconciled_line_count" class="oe_inline" readonly="1"/>
                    รายการที่ยังไม่กระทบยอดในช่วงที่จะล็อก ระบบจะไม่ยอมล็อก ต้องกระทบยอดหรือลบก่อน
                </div>

                <div class="alert alert-warning" role="alert" invisible="not no_posted_moves">
                    บริษัทนี้ยังไม่มีรายการบัญชีที่ผ่านรายการเลย ถ้าล็อกตอนนี้
                    ยอดยกมาที่จะลงทีหลังโดยลงวันที่ในช่วงล็อกจะถูกย้ายวันที่ไปงวดถัดไป
                    ควรลงยอดยกมาก่อนแล้วค่อยล็อก
                </div>

                <!-- หน้าเว็บไม่บังคับติ๊กช่อง boolean แม้ใส่ required ตัวบังคับจริงอยู่ใน action_apply -->
                <div class="alert alert-danger" role="alert" invisible="not hard_lock_changed">
                    <p>
                        ล็อกถาวร: บันทึกแล้วลบออกหรือเลื่อนถอยหลังไม่ได้อีก ผ่านระบบไม่มีใครปลดได้แม้ผู้ดูแลระบบ
                        ทำหลังส่งงบการเงินและยื่นภาษีสิ้นปีเรียบร้อยแล้วเท่านั้น
                    </p>
                    <div class="o_row">
                        <field name="hard_lock_confirm" required="hard_lock_changed" nolabel="1"/>
                        <label for="hard_lock_confirm" class="fw-bold"/>
                    </div>
                </div>

                <!-- ไม่ใส่ required ที่ note: หน้าเว็บบันทึกฟอร์มก่อนกดปุ่ม type="object" ทุกปุ่ม
                     ถ้าบังคับที่นี่ ปุ่ม ดูเอกสารร่าง / ล็อกถึงสิ้นเดือนที่แล้ว จะกดไม่ได้จนกว่าจะพิมพ์เหตุผล
                     ตัวบังคับจริงอยู่ใน action_apply ข้อ 7 ที่นี่แค่บอกให้เห็น -->
                <group>
                    <field name="note"
                           placeholder="เช่น ปิดงบ ก.ย. 2569 / ปลดล็อกเพื่อแก้ใบแจ้งหนี้ INV/2026/xxxx"/>
                </group>
                <div class="text-danger" invisible="not (has_unlock or hard_lock_changed) or note">
                    ต้องกรอกเหตุผลก่อนกด บันทึกวันล็อก (ปลดล็อก/ถอยวันล็อก หรือเปลี่ยนล็อกถาวร)
                </div>

                <footer>
                    <button name="action_apply" type="object" string="บันทึกวันล็อก" class="btn-primary"/>
                    <button name="action_fill_last_month" type="object" string="ล็อกถึงสิ้นเดือนที่แล้ว"
                            class="btn-secondary"
                            help="เติมปิดงวดบัญชีและล็อกภาษี = วันสุดท้ายของเดือนที่แล้ว ยังไม่บันทึกจนกด บันทึกวันล็อก"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_npd_account_lock_wizard" model="ir.actions.act_window">
        <field name="name">ล็อกงวดบัญชี</field>
        <field name="res_model">npd.account.lock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[Command.link(ref('group_npd_lock_manager'))]"/>
    </record>

</odoo>
