<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_npd_account_lock_status_list" model="ir.ui.view">
        <field name="name">npd.account.lock.status.list</field>
        <field name="model">npd.account.lock.status</field>
        <field name="arch" type="xml">
            <list string="สถานะการล็อกทุกบริษัท" create="0" edit="0" delete="0"
                  decoration-muted="not effective_lock_date">
                <field name="company_id"/>
                <field name="effective_lock_date" class="fw-bold"/>
                <field name="fiscalyear_lock_date"/>
                <field name="tax_lock_date"/>
                <field name="sale_lock_date"/>
                <field name="purchase_lock_date"/>
                <field name="hard_lock_date" decoration-danger="hard_lock_date"/>
                <field name="active_exception_count" decoration-warning="active_exception_count"
                       optional="show"/>
                <field name="last_change_date"/>
                <field name="last_change_user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <!-- กดแถวแล้วเปิดฟอร์มนี้แทนฟอร์มที่ Odoo สร้างเอง อ่านอย่างเดียว ไม่มีปุ่มแก้ -->
    <record id="view_npd_account_lock_status_form" model="ir.ui.view">
        <field name="name">npd.account.lock.status.form</field>
        <field name="model">npd.account.lock.status</field>
        <field name="arch" type="xml">
            <form string="สถานะการล็อกงวดบัญชี" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="company_id" readonly="1" options="{'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="effective_lock_date" class="fw-bold"/>
                            <field name="fiscalyear_lock_date"/>
                            <field name="tax_lock_date"/>
                            <field name="sale_lock_date"/>
                            <field name="purchase_lock_date"/>
                            <field name="hard_lock_date"/>
                        </group>
                        <group>
                            <field name="active_exception_count"/>
                            <field name="last_change_date"/>
                            <field name="last_change_user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_npd_account_lock_status" model="ir.actions.act_window">
        <field name="name">สถานะการล็อกทุกบริษัท</field>
        <field name="res_model">npd.account.lock.status</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[Command.link(ref('group_npd_lock_manager'))]"/>
    </record>

</odoo>
