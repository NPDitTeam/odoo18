<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_npd_account_lock_log_list" model="ir.ui.view">
        <field name="name">npd.account.lock.log.list</field>
        <field name="model">npd.account.lock.log</field>
        <field name="arch" type="xml">
            <list string="ประวัติการล็อกงวด" create="0" edit="0" delete="0"
                  decoration-danger="direction == 'unlock'">
                <field name="change_datetime"/>
                <field name="company_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="field_name"/>
                <field name="old_date"/>
                <field name="new_date"/>
                <field name="direction" widget="badge"
                       decoration-danger="direction == 'unlock'"
                       decoration-success="direction == 'lock'"/>
                <field name="source"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_npd_account_lock_log_search" model="ir.ui.view">
        <field name="name">npd.account.lock.log.search</field>
        <field name="model">npd.account.lock.log</field>
        <field name="arch" type="xml">
            <search string="ประวัติการล็อกงวด">
                <field name="company_id"/>
                <field name="user_id"/>
                <field name="field_name"/>
                <field name="note"/>
                <filter name="filter_unlock" string="ปลดล็อก / ถอยหลัง"
                        domain="[('direction', '=', 'unlock')]"/>
                <filter name="filter_hard" string="ล็อกถาวร"
                        domain="[('field_name', '=', 'hard_lock_date')]"/>
                <separator/>
                <filter name="filter_wizard" string="จากหน้าจอนี้"
                        domain="[('source', '=', 'wizard')]"/>
                <filter name="filter_exception" string="ข้อยกเว้นการล็อก"
                        domain="[('source', '=', 'exception')]"/>
                <filter name="filter_other" string="ช่องทางอื่น"
                        domain="[('source', '=', 'other')]"/>
                <separator/>
                <filter name="filter_change_datetime" string="เวลาที่แก้" date="change_datetime"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_company" string="บริษัท" context="{'group_by': 'company_id'}"/>
                    <filter name="group_field" string="ชนิดล็อก" context="{'group_by': 'field_name'}"/>
                    <filter name="group_user" string="ผู้แก้ไข" context="{'group_by': 'user_id'}"/>
                    <filter name="group_month" string="เดือนที่แก้" context="{'group_by': 'change_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_npd_account_lock_log" model="ir.actions.act_window">
        <field name="name">ประวัติการล็อกงวด</field>
        <field name="res_model">npd.account.lock.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_npd_account_lock_log_search"/>
        <field name="groups_id" eval="[Command.link(ref('group_npd_lock_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีการเปลี่ยนวันล็อกงวด</p>
            <p>ทุกครั้งที่วันล็อกของบริษัทเปลี่ยน ไม่ว่าจากหน้าจอล็อกงวดบัญชี ตัวช่วย AI-IT หรือสคริปต์
                รวมถึงการสร้างข้อยกเว้นการล็อก จะถูกบันทึกไว้ที่นี่</p>
        </field>
    </record>

</odoo>
