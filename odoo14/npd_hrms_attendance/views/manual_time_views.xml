<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_manual_time_log_list" model="ir.ui.view">
        <field name="name">hr.manual.time.log.list</field>
        <field name="model">hr.manual.time.log</field>
        <field name="arch" type="xml">
            <list string="เพิ่มเวลา"
                  decoration-warning="state == 'รออนุมัติ'"
                  decoration-success="state == 'อนุมัติ'"
                  decoration-danger="state == 'ไม่อนุมัติ'"
                  decoration-muted="state == 'ยกเลิก'">
                <field name="work_date"/>
                <field name="employee_code"/>
                <field name="username"/>
                <field name="branch_id"/>
                <field name="department_id" optional="hide"/>
                <field name="reason_type_id"/>
                <field name="allowance_type" optional="show"/>
                <field name="checkin_time"/>
                <field name="checkout_time"/>
                <field name="amount" sum="รวมเงิน"/>
                <field name="user_note" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="approved_by" optional="hide"/>
                <field name="approved_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_manual_time_log_form" model="ir.ui.view">
        <field name="name">hr.manual.time.log.form</field>
        <field name="model">hr.manual.time.log</field>
        <field name="arch" type="xml">
            <form string="เพิ่มเวลา">
                <header>
                    <button name="action_approve" type="object" string="อนุมัติ"
                            class="btn-primary" invisible="state != 'รออนุมัติ'"/>
                    <button name="action_disapprove" type="object" string="ไม่อนุมัติ"
                            class="btn-secondary" invisible="state != 'รออนุมัติ'"/>
                    <button name="action_cancel" type="object" string="ยกเลิก"
                            invisible="state == 'ยกเลิก'"/>
                    <button name="action_reset_to_pending" type="object"
                            string="กลับเป็นรออนุมัติ" invisible="state == 'รออนุมัติ'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="รออนุมัติ,อนุมัติ"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_summary" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="พนักงาน">
                            <field name="employee_id" options="{'no_create': True}"
                                   readonly="state != 'รออนุมัติ'"/>
                            <field name="employee_code"/>
                            <field name="branch_id"/>
                            <field name="department_id"/>
                            <field name="position_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="ช่วงเวลา">
                            <field name="work_date" readonly="state != 'รออนุมัติ'"/>
                            <field name="checkin_time" placeholder="08:00"
                                   readonly="state != 'รออนุมัติ'"/>
                            <field name="checkout_time" placeholder="17:00"
                                   readonly="state != 'รออนุมัติ'"/>
                        </group>
                    </group>
                    <group>
                        <group string="ประเภทและจำนวนเงิน">
                            <field name="reason_type_id" options="{'no_create': True}"
                                   readonly="state != 'รออนุมัติ'"/>
                            <field name="allowance_type" readonly="state != 'รออนุมัติ'"/>
                            <field name="amount" readonly="state != 'รออนุมัติ'"/>
                        </group>
                        <group string="รายละเอียด">
                            <field name="user_note"/>
                            <field name="attachment" widget="binary" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="การอนุมัติ">
                        <group>
                            <field name="approved_by"/>
                            <field name="approved_at"/>
                        </group>
                        <group>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manual_time_log_search" model="ir.ui.view">
        <field name="name">hr.manual.time.log.search</field>
        <field name="model">hr.manual.time.log</field>
        <field name="arch" type="xml">
            <search string="ค้นหาการเพิ่มเวลา">
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="branch_id"/>
                <field name="reason_type_id"/>
                <field name="work_date"/>
                <filter name="filter_pending" string="รออนุมัติ"
                        domain="[('state', '=', 'รออนุมัติ')]"/>
                <filter name="filter_approved" string="อนุมัติแล้ว"
                        domain="[('state', '=', 'อนุมัติ')]"/>
                <separator/>
                <filter name="filter_with_amount" string="มีจำนวนเงิน"
                        domain="[('amount', '&gt;', 0)]"/>
                <filter name="filter_this_month" string="เดือนนี้"
                        domain="[('work_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_employee" string="พนักงาน"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_branch" string="สาขา"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_reason" string="ประเภท"
                            context="{'group_by': 'reason_type_id'}"/>
                    <filter name="group_state" string="สถานะ"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="วันที่ทำงาน"
                            context="{'group_by': 'work_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_manual_time_log" model="ir.actions.act_window">
        <field name="name">เพิ่มเวลา / เบิกเบี้ยเลี้ยง</field>
        <field name="res_model">hr.manual.time.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_manual_time_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีคำขอเพิ่มเวลา</p>
            <p>คำขอจะเข้ามาอัตโนมัติเมื่อพนักงานยื่นผ่านแอป HR</p>
        </field>
    </record>

    <record id="action_manual_time_log_pending" model="ir.actions.act_window">
        <field name="name">คำขอเพิ่มเวลารออนุมัติ</field>
        <field name="res_model">hr.manual.time.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'รออนุมัติ')]</field>
        <field name="search_view_id" ref="view_manual_time_log_search"/>
    </record>

</odoo>
