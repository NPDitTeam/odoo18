<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo 14 มี cron 3 ตัว: sync ลงเวลา, sync ใบลา, sync เพิ่มเวลา — จาก PHP
             ทั้งหมดหายไปเพราะแอปเขียนเข้า Odoo โดยตรงแล้ว
             เหลือแค่ตัวเดียวที่ยังต้องมี คือการอัปเดตสิทธิ์วันลาตามอายุงาน -->
        <record id="cron_update_leave_entitlements" model="ir.cron">
            <field name="name">HRMS: อัปเดตสิทธิ์วันลาตามอายุงาน</field>
            <field name="model_id" ref="model_hrms_leave_balance"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_leave_entitlements()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
