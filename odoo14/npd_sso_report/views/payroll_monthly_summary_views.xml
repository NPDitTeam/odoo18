<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npd_payroll_monthly_summary_list" model="ir.ui.view">
        <field name="name">npd.payroll.monthly.summary.list</field>
        <field name="model">npd.payroll.monthly.summary</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="period"/>
                <field name="company_id"/>
                <field name="branch_id" optional="hide"/>
                <field name="taxid"/>
                <field name="employee_code" optional="hide"/>
                <field name="employee_name"/>
                <field name="net_income" sum="รวม"/>
                <field name="tax_monthly" sum="รวม"/>
                <field name="sso_wage" sum="รวม"/>
                <field name="sso_total" sum="รวม"/>
            </list>
        </field>
    </record>

    <record id="view_npd_payroll_monthly_summary_search" model="ir.ui.view">
        <field name="name">npd.payroll.monthly.summary.search</field>
        <field name="model">npd.payroll.monthly.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_name"/>
                <field name="taxid"/>
                <field name="employee_code"/>
                <field name="period"/>
                <field name="year"/>
                <field name="company_id"/>
                <field name="branch_id"/>
                <filter name="has_tax" string="มีภาษี" domain="[('tax_monthly', '>', 0)]"/>
                <filter name="has_sso" string="มีประกันสังคม" domain="[('sso_total', '>', 0)]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter name="group_period" string="งวด" context="{'group_by': 'period'}"/>
                    <filter name="group_company" string="บริษัท" context="{'group_by': 'company_id'}"/>
                    <filter name="group_branch" string="สาขา" context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_npd_payroll_monthly_summary" model="ir.actions.act_window">
        <field name="name">รายงานสรุปรายได้ต่อเดือน</field>
        <field name="res_model">npd.payroll.monthly.summary</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_period': 1, 'search_default_group_company': 1}</field>
    </record>
</odoo>
