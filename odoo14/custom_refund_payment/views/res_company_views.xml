<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_refund_accounts" model="ir.ui.view">
        <field name="name">res.company.form.refund.accounts</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="โอนคืนเงินลูกค้า" name="npd_refund_accounts" groups="account.group_account_manager">
                    <group>
                        <group string="สมุด">
                            <field name="refund_journal_id"
                                   domain="[('company_id', '=', id)]"/>
                        </group>
                        <group string="บัญชี">
                            <field name="refund_suspense_account_id"/>
                            <field name="refund_bank_savings_account_id"/>
                            <field name="refund_bank_current_account_id"/>
                            <field name="refund_wht_account_id"/>
                            <field name="refund_rental_income_account_id"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        คืนเงินโอนเกิน: เดบิต บัญชีธนาคารคืนเงินโอนเกิน / เครดิต บัญชีพัก ·
                        คืนหัก ณ ที่จ่าย: เดบิต ภาษีถูกหัก ณ ที่จ่าย / เครดิต บัญชีพัก ·
                        ค่าเช่าส่วนต่าง: เดบิต รายได้ค่าเช่า / เครดิต บัญชีธนาคารจ่ายคืนค่าเช่าส่วนต่าง
                        (คู่บัญชีเหมือน Odoo 14)
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
