<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_refund_permission" model="ir.ui.view">
        <field name="name">res.users.form.refund.permission</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <separator string="สิทธิ์พิเศษ"/>
                <group string="สิทธิ์การคืนเงิน">
                    <field name="can_confirm_refund_payment"/>
                    <field name="allow_edit_refund_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
