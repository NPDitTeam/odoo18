<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- แยกข้อมูลตามบริษัท — เอกสารภาษีของบริษัทหนึ่งต้องไม่โผล่ให้อีกบริษัทเห็น
             ยิ่งเมื่อปล่อยเช่าให้ลูกค้าใช้ระบบร่วมกัน -->
        <record id="rule_hr_wt_cert_company" model="ir.rule">
            <field name="name">หนังสือรับรอง 50 ทวิ: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_hr_withholding_tax_cert"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_hr_wt_cert_line_company" model="ir.rule">
            <field name="name">รายการ 50 ทวิ: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_hr_withholding_tax_cert_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('cert_id.company_id', '=', False), ('cert_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
