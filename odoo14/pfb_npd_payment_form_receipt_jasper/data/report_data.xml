<?xml version="1.0"?>
<odoo>
    <!-- 3 แบบฟอร์มในเมนูพิมพ์ของหน้ารับชำระ (report_name ห้ามมี "/" และต้องไม่ซ้ำรายงานอื่น) -->
    <record id="jasper_payment_form_receipt_report" model="ir.actions.report">
        <field name="name">ใบกำกับภาษี/ใบเสร็จรับเงิน</field>
        <field name="model">account.payment</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_payment_form_receipt_jasper/report/payment_form_receipt.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบกำกับภาษี-ใบเสร็จรับเงิน</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบกำกับภาษี-ใบเสร็จรับเงิน - %s' % (object.name)</field>
    </record>
    <record id="jasper_payment_form_receipt_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">payment_form_receipt.jrxml</field>
        <field name="report_id" ref="jasper_payment_form_receipt_report"/>
        <field name="file" type="base64" file="pfb_npd_payment_form_receipt_jasper/report/payment_form_receipt.jrxml"/>
    </record>

    <record id="jasper_payment_form_receipt_scaffold_report" model="ir.actions.report">
        <field name="name">ใบกำกับภาษี/ใบเสร็จรับเงิน ค่าเช่าทรัพย์สิน</field>
        <field name="model">account.payment</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_payment_form_receipt_jasper/report/payment_form_receipt_scaffold.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบกำกับภาษี-ใบเสร็จรับเงิน ค่าเช่าทรัพย์สิน</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบกำกับภาษี-ใบเสร็จรับเงิน ค่าเช่าทรัพย์สิน - %s' % (object.name)</field>
    </record>
    <record id="jasper_payment_form_receipt_scaffold_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">payment_form_receipt_scaffold.jrxml</field>
        <field name="report_id" ref="jasper_payment_form_receipt_scaffold_report"/>
        <field name="file" type="base64" file="pfb_npd_payment_form_receipt_jasper/report/payment_form_receipt_scaffold.jrxml"/>
    </record>

    <record id="jasper_payment_form_receipt_place_rent_report" model="ir.actions.report">
        <field name="name">ใบเสร็จรับเงินค่าเช่าที่</field>
        <field name="model">account.payment</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_payment_form_receipt_jasper/report/payment_form_receipt_place_rent.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบเสร็จรับเงินค่าเช่าที่</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบเสร็จรับเงินค่าเช่าที่ - %s' % (object.name)</field>
    </record>
    <record id="jasper_payment_form_receipt_place_rent_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">payment_form_receipt_place_rent.jrxml</field>
        <field name="report_id" ref="jasper_payment_form_receipt_place_rent_report"/>
        <field name="file" type="base64" file="pfb_npd_payment_form_receipt_jasper/report/payment_form_receipt_place_rent.jrxml"/>
    </record>
</odoo>
