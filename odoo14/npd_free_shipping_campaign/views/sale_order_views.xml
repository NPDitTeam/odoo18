<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_free_shipping" model="ir.ui.view">
        <field name="name">sale.order.form.free.shipping</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="pfb_npd_tap_shipment_information.view_order_form_inherit"/>
        <field name="arch" type="xml">
            <!-- แจ้งสถานะโปรไว้เหนือกลุ่มข้อมูลการขนส่ง จะได้เห็นก่อนดูตัวเลขค่าขนส่ง -->
            <!-- Odoo 14 ห้ามใช้ @string เป็นตัวชี้ตำแหน่งในวิวที่สืบทอด
                 จึงอ้างจากชื่อฟิลด์แล้วไต่ขึ้นไปหากลุ่มนอกสุดแทน -->
            <xpath expr="//field[@name='shipping_cost_raw']/../.." position="before">
                <field name="npd_free_shipping_applied" invisible="1"/>
                <field name="npd_free_shipping_warn" invisible="1"/>
                <div class="alert alert-success mb-2" role="alert"
                     invisible="not npd_free_shipping_applied">
                    <i class="fa fa-gift mr-1"/>
                    <b>ค่าขนส่งใบนี้ใช้โปรส่งฟรี</b>
                    <div><field name="npd_free_shipping_note" nolabel="1" readonly="1"/></div>
                </div>
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not npd_free_shipping_warn">
                    <i class="fa fa-info-circle mr-1"/>
                    <field name="npd_free_shipping_note" nolabel="1" readonly="1"/>
                </div>
            </xpath>

            <!-- ค่าขนส่งปกติก่อนใช้โปร เก็บไว้ให้ตรวจย้อนหลัง -->
            <xpath expr="//field[@name='shipping_cost']" position="after">
                <field name="npd_free_shipping_normal_cost" readonly="1"
                       invisible="not npd_free_shipping_applied"/>
            </xpath>

            <!-- โปรมีผล = ล็อกไม่ให้แก้ค่าขนส่งเอง -->
            <xpath expr="//field[@name='shipping_cost']" position="attributes">
                <attribute name="readonly">npd_free_shipping_applied</attribute>
            </xpath>
            <xpath expr="//field[@name='shipping_cost_m']" position="attributes">
                <attribute name="readonly">npd_free_shipping_applied</attribute>
            </xpath>
            <xpath expr="//field[@name='use_special_delivery_zero']" position="attributes">
                <attribute name="readonly">npd_free_shipping_applied</attribute>
            </xpath>
        </field>
    </record>
</odoo>
