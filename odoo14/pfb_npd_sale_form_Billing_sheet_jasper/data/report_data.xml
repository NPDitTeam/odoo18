<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action for Invoice / Billing Note
         report_name ห้ามมี "/" เพราะถูกใช้เป็น URL path segment -->
    <record id="jasper_billing_sheet_report" model="ir.actions.report">
        <field name="name">ใบแจ้งหนี้/ใบวางบิล</field>
        <field name="model">sale.order</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_sale_form_Billing_sheet_jasper/report/billing_sheet.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบแจ้งหนี้-ใบวางบิล</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Billing Note - %s' % (object.name)</field>
    </record>

    <!-- Attach the JRXML file to the report -->
    <record id="jasper_billing_sheet_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">billing_sheet.jrxml</field>
        <field name="report_id" ref="pfb_npd_sale_form_Billing_sheet_jasper.jasper_billing_sheet_report"/>
        <field name="file" type="base64" file="pfb_npd_sale_form_Billing_sheet_jasper/report/billing_sheet.jrxml"/>
    </record>
</odoo>
