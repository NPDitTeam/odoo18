<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_greenhome" model="ir.ui.view">
        <field name="name">res.users.form.inherit.greenhome</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="สิทธิ์บ้านเขียว">
                    <field name="allow_greenhome_return"
                           string="อนุญาตให้คืนสินค้าบ้านเขียว"
                           groups="base.group_system"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
