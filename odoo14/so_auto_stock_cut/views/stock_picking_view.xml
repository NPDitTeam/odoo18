<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- priority สูง เพื่อให้ apply หลังโมดูลอื่น (เช่น stock_picking_cancel_extended ที่ replace ปุ่ม Cancel) -->
    <record id="view_picking_form_so_auto_lock" model="ir.ui.view">
        <field name="name">stock.picking.form.so.auto.lock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- ฟิลด์ช่วยสำหรับเงื่อนไข invisible (ซ่อนไว้) -->
            <xpath expr="//header" position="inside">
                <field name="is_return_picking" invisible="1"/>
                <field name="sc_is_rental_picking" invisible="1"/>
            </xpath>

            <!-- ซ่อนปุ่ม 'ส่งคืน' (Return) บนใบคืน — กันวนกดสร้างใบคืนของใบคืน (= ตัดสต็อกใหม่)
                 Odoo 18: ใช้ attribute invisible="<expr>" แทน attrs -->
            <button name="%(stock.act_stock_return_picking)d" position="attributes">
                <attribute name="invisible">state != 'done' or is_return_picking</attribute>
            </button>

            <!-- หมายเหตุ Odoo 18: ปุ่ม 'ยกเลิก' (action_cancel) ของ core ถูกซ่อนอยู่แล้ว
                 เมื่อ state = 'done' (invisible="state not in ('assigned','confirmed','draft','waiting')")
                 จึงไม่ต้อง override เพิ่ม — การลบใบเสร็จสิ้นถูกกันไว้ที่ StockPicking.unlink() แล้ว -->
        </field>
    </record>
</odoo>
