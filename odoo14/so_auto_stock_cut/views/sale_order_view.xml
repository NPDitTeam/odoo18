<odoo>
    <record id="view_order_form_auto_stock" model="ir.ui.view">
        <field name="name">sale.order.form.auto.stock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_auto_validate_delivery"
                        type="object"
                        class="btn-primary"
                        string="ตัดสต๊อก Auto"
                        invisible="state != 'sale'"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="บ้านเขียว">
                    <group>
                        <field name="return_greenhome_state" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
