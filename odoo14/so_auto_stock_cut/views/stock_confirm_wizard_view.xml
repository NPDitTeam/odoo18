<odoo>
  <record id="view_stock_cut_confirm_wizard" model="ir.ui.view">
    <field name="name">stock.cut.confirm.wizard.form</field>
    <field name="model">stock.cut.confirm.wizard</field>
    <field name="arch" type="xml">
      <form string="ยืนยันการตัดสต๊อก">
        <field name="mode" invisible="1"/>
        <group>
          <field name="order_id" readonly="1"/>
        </group>

        <div invisible="mode != 'return'" class="alert alert-warning" role="alert">
          ↩️ โหมด<b>คืนสต๊อก</b> — รายการด้านล่างคือสินค้าที่ถูกตัดจริง กด "ยืนยันคืนสต๊อก" เพื่อคืนกลับคลังอัตโนมัติ (สถานะเสร็จสิ้น)
        </div>

        <notebook>
          <page string="ตัดสต๊อก (Odoo)">
            <group>
              <field name="confirm_line_ids" nolabel="1"
                     options="{'no_create': True, 'no_create_edit': True, 'no_open': True, 'no_delete': True}">
                <!-- ล็อกไม่ให้เพิ่ม/ลบรายการ (ทั้งโหมดตัดและคืน) — รายการมาจากระบบเท่านั้น -->
                <list editable="bottom" create="false" delete="false" string="ตัดสต๊อกตาม SO">
                  <field name="product_id" string="สินค้า" readonly="1" force_save="1"/>
                  <field name="odoo_stock_qty" string="สต๊อกคงเหลือ" readonly="1" force_save="1"/>
                  <field name="quantity" string="จำนวนที่ตัด" readonly="1" force_save="1"/>
                  <field name="location_name" string="คลังต้นทาง" readonly="1" force_save="1"/>
                </list>
              </field>
            </group>
          </page>
        </notebook>

        <footer>
          <button string="ยืนยันตัดสต๊อก"
                  type="object"
                  name="confirm_stock_cut"
                  class="btn-primary"
                  invisible="mode != 'cut'"/>

          <button string="↩️ ยืนยันคืนสต๊อก"
                  type="object"
                  name="confirm_stock_return"
                  class="btn-warning"
                  invisible="mode != 'return'"/>

          <button string="ยกเลิก"
                  class="btn-secondary"
                  special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
