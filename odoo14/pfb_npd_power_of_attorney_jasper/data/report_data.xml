<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action: หนังสือมอบอำนาจ -->
    <record id="jasper_power_of_attorney_report" model="ir.actions.report">
        <field name="name">หนังสือมอบอำนาจ</field>
        <field name="model">sale.order</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_power_of_attorney_jasper/report/power_of_attorney.jrxml</field>
        <field name="attachment_use">False</field>
        <!-- report_name ถูกใช้เป็น URL path segment ห้ามมีสแลชหรืออักขระพิเศษ -->
        <field name="report_name">power_of_attorney</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'หนังสือมอบอำนาจ-%s' % (object.jasper_rc_contract_base or object.name)</field>
    </record>

    <record id="jasper_power_of_attorney_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">power_of_attorney.jrxml</field>
        <field name="report_id" ref="pfb_npd_power_of_attorney_jasper.jasper_power_of_attorney_report"/>
        <field name="file" type="base64" file="pfb_npd_power_of_attorney_jasper/report/power_of_attorney.jrxml"/>
    </record>
</odoo>
