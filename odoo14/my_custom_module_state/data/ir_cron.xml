<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- o14 cron #46 "ฟังก์ชันอัปเดต สถานะ ขายเช่า" (ทุก 3 ชม.) — o14 สร้างไว้ในฐานข้อมูล ไม่ได้อยู่ในโมดูล -->
        <record id="ir_cron_rental_status_update" model="ir.cron">
            <field name="name">ฟังก์ชันอัปเดต สถานะ ขายเช่า</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.run_rental_status_update()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- o14 cron #52 (ชื่อเดิม "Stock เช่ารวม" แต่เรียก custom_function_update_overdue) รายวัน:
             ตั้ง "เกินกำหนด" ให้ใบสั่งเช่าที่เลยวันสิ้นสุด แม้ยังชำระไม่ครบ -->
        <record id="ir_cron_rental_status_overdue" model="ir.cron">
            <field name="name">อัปเดตสถานะเกินกำหนด ขายเช่า (รายวัน)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.run_rental_status_overdue_update()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
