<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_channel_list" model="ir.ui.view">
        <field name="name">customer.channel.list</field>
        <field name="model">customer.channel</field>
        <field name="arch" type="xml">
            <list string="ช่องทางลูกค้า" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_customer_channel" model="ir.actions.act_window">
        <field name="name">ช่องทางลูกค้า</field>
        <field name="res_model">customer.channel</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_customer_channel"
              name="ช่องทางลูกค้า"
              parent="sale.menu_sale_config"
              action="action_customer_channel"
              sequence="50"/>
</odoo>
