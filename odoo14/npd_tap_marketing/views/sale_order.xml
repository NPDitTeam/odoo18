<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_marketing_tab" model="ir.ui.view">
        <field name="name">sale.order.form.marketing.tab</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="การตลาด" name="marketing_tab">
                    <group>
                        <group string="UTM Tracking">
                            <field name="campaign_id"/>
                            <field name="medium_id"/>
                            <field name="source_id"/>
                        </group>
                        <group string="ช่องทางลูกค้า">
                            <field name="customer_channel_id" required="1"/>
                            <field name="freelance_salesperson_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
