<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_npd_doc_trace_wizard_form" model="ir.ui.view">
        <field name="name">npd.doc.trace.wizard.form</field>
        <field name="model">npd.doc.trace.wizard</field>
        <field name="arch" type="xml">
            <form string="ตรวจสอบเอกสารที่เชื่อมโยง">
                <div class="text-muted mb-2">
                    พิมพ์เลขเอกสารแล้วเลือก ระบบจะแสดงเอกสารที่เชื่อมกัน 2 ชั้น พร้อมบอกว่าเชื่อมกันทางไหน
                    กด <b>เปิด</b> เพื่อไปหน้าเอกสาร หรือ <b>ตรวจต่อ</b> เพื่อดูเอกสารที่เชื่อมกับใบนั้นต่อ
                </div>
                <field name="doc_id" widget="npd_doc_trace" nolabel="1" class="w-100"
                       placeholder="เช่น CUST.IN-261020-0039, INV-1019, SO-2610..."
                       options="{'no_create': True, 'no_open': True}"/>
                <div invisible="not trail" class="mt-2">
                    <span class="text-muted">เส้นทาง: </span><field name="trail" readonly="1" nolabel="1" class="d-inline"/>
                </div>
                <field name="summary" readonly="1" nolabel="1" invisible="not summary"
                       class="text-muted"/>
                <field name="line_ids" nolabel="1" invisible="not doc_id">
                    <list create="0" delete="0" editable="bottom"
                          decoration-bf="level == 0" decoration-info="level == 0" decoration-muted="level == 2">
                        <field name="level" column_invisible="1" force_save="1"/>
                        <field name="res_model" column_invisible="1" force_save="1"/>
                        <field name="res_id" column_invisible="1" force_save="1"/>
                        <field name="finder_id" column_invisible="1" force_save="1"/>
                        <field name="relation" readonly="1" force_save="1"/>
                        <field name="display_number" readonly="1" force_save="1"/>
                        <field name="menu_label" readonly="1" force_save="1"/>
                        <field name="date" readonly="1" force_save="1"/>
                        <field name="partner_id" readonly="1" force_save="1"/>
                        <field name="amount" readonly="1" force_save="1"/>
                        <field name="state" readonly="1" force_save="1"/>
                        <button name="action_open" type="object" string="เปิด" class="btn-link"/>
                        <button name="action_trace" type="object" string="ตรวจต่อ" class="btn-link"
                                invisible="level == 0"/>
                    </list>
                </field>
                <footer>
                    <button string="ปิด" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_npd_doc_trace" model="ir.actions.act_window">
        <field name="name">ตรวจสอบเอกสารที่เชื่อมโยง</field>
        <field name="res_model">npd.doc.trace.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

    <menuitem id="menu_npd_doc_trace" name="ตรวจสอบเอกสารที่เชื่อมโยง"
              parent="account.menu_finance" action="action_npd_doc_trace" sequence="1"/>

</odoo>
