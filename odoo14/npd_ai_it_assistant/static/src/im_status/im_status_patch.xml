<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ทำเครื่องหมายไว้ให้ SCSS ย้อมสีเฉพาะบอท ไม่กระทบผู้ใช้คนอื่น -->
    <t t-inherit="mail.ImStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-ImStatus')]" position="attributes">
            <attribute name="t-att-data-npd-ai-it">isNpdAiItBot ? '1' : undefined</attribute>
        </xpath>
        <xpath expr="//i[@title='Online']" position="attributes">
            <attribute name="title"/>
            <attribute name="t-att-title">isNpdAiItBot ? 'ตัวช่วย AI-IT พร้อมใช้งาน' : 'Online'</attribute>
        </xpath>
        <xpath expr="//i[@title='Offline']" position="attributes">
            <attribute name="title"/>
            <attribute name="t-att-title">isNpdAiItBot ? 'ตัวช่วย AI-IT ใช้งานไม่ได้ (ยังไม่ได้ตั้งค่า AI Key)' : 'Offline'</attribute>
        </xpath>
    </t>

    <!-- หัวหน้าต่างแชท -->
    <t t-inherit="mail.ThreadIcon" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-ThreadIcon')]" position="attributes">
            <attribute name="t-att-data-npd-ai-it">isNpdAiItBot ? '1' : undefined</attribute>
        </xpath>
        <xpath expr="//div[@title='Online']" position="attributes">
            <attribute name="title"/>
            <attribute name="t-att-title">isNpdAiItBot ? 'ตัวช่วย AI-IT พร้อมใช้งาน' : 'Online'</attribute>
        </xpath>
        <xpath expr="//div[@title='Offline']" position="attributes">
            <attribute name="title"/>
            <attribute name="t-att-title">isNpdAiItBot ? 'ตัวช่วย AI-IT ใช้งานไม่ได้ (ยังไม่ได้ตั้งค่า AI Key)' : 'Offline'</attribute>
        </xpath>
    </t>

</templates>
