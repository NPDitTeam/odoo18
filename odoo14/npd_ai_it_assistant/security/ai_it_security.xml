<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_npd_ai_it" model="ir.module.category">
            <field name="name">ตัวช่วย AI-IT</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_ai_it_manager" model="res.groups">
            <field name="name">ผู้ดูแลตัวช่วย AI-IT</field>
            <field name="category_id" ref="module_category_npd_ai_it"/>
            <field name="comment">ตั้งค่าหัวข้อ และดูประวัติการใช้งานของพนักงานทุกคน</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- พนักงานเห็นเฉพาะบทสนทนาของตัวเอง -->
        <record id="rule_ai_it_session_own" model="ir.rule">
            <field name="name">ตัวช่วย AI-IT : เห็นเฉพาะบทสนทนาของตัวเอง</field>
            <field name="model_id" ref="model_npd_ai_it_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_ai_it_session_manager" model="ir.rule">
            <field name="name">ตัวช่วย AI-IT : ผู้ดูแลเห็นทั้งหมด</field>
            <field name="model_id" ref="model_npd_ai_it_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_it_manager'))]"/>
        </record>

        <record id="rule_ai_it_session_line_own" model="ir.rule">
            <field name="name">ตัวช่วย AI-IT : รายการของบทสนทนาตัวเอง</field>
            <field name="model_id" ref="model_npd_ai_it_session_line"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_ai_it_session_line_manager" model="ir.rule">
            <field name="name">ตัวช่วย AI-IT : ผู้ดูแลเห็นรายการทั้งหมด</field>
            <field name="model_id" ref="model_npd_ai_it_session_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_it_manager'))]"/>
        </record>

        <!--
            ประวัติการแก้: พนักงานทั่วไปเห็นเฉพาะของตัวเอง
            ส่วนคนที่เข้าเมนู "บัญชี > การรายงาน" ได้ (group_account_readonly /
            group_account_invoice) ถือเป็นผู้ตรวจสอบ จึงเห็นได้ทั้งหมด
            กฎที่ผูกกับกลุ่มจะถูก OR กัน คนที่อยู่หลายกลุ่มจึงเห็นชุดที่กว้างที่สุด
        -->
        <record id="rule_ai_it_history_own" model="ir.rule">
            <field name="name">ประวัติการแก้ AI-IT : เห็นเฉพาะของตัวเอง</field>
            <field name="model_id" ref="model_npd_ai_it_history"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_ai_it_history_accountant" model="ir.rule">
            <field name="name">ประวัติการแก้ AI-IT : ฝ่ายบัญชีเห็นทั้งหมด</field>
            <field name="model_id" ref="model_npd_ai_it_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_readonly')),
                                        (4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="rule_ai_it_history_manager" model="ir.rule">
            <field name="name">ประวัติการแก้ AI-IT : ผู้ดูแลเห็นทั้งหมด</field>
            <field name="model_id" ref="model_npd_ai_it_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_it_manager'))]"/>
        </record>

    </data>
</odoo>
