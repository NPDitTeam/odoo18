<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- เมนู การรับ (Purchase Receipts) - เฉพาะ check_type_show_selection = False
         o18: วิวใบสำคัญอยู่ในโมดูล account_voucher_npd (o14 อยู่ใน account_voucher) -->
    <record id="view_purchase_receipt_form_review_state" model="ir.ui.view">
        <field name="name">account.voucher.purchase.form.review.state</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_purchase_receipt_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_review_checked"
                        string="ตรวจสอบแล้ว"
                        type="object"
                        class="btn-success"
                        groups="npd_expense_review_state.group_expense_review"
                        invisible="check_type_show_selection == 'true' or review_state == 'checked'"/>
                <button name="action_review_waiting"
                        string="รอตรวจสอบ"
                        type="object"
                        groups="npd_expense_review_state.group_expense_review"
                        confirm="ต้องการเปลี่ยนสถานะกลับเป็น รอตรวจสอบ ใช่หรือไม่?"
                        invisible="check_type_show_selection == 'true' or review_state == 'waiting'"/>
            </xpath>
            <xpath expr="//field[@name='check_type_show_selection']" position="after">
                <field name="review_state"
                       widget="badge"
                       decoration-warning="review_state == 'waiting'"
                       decoration-success="review_state == 'checked'"
                       invisible="check_type_show_selection == 'true'"/>
                <field name="review_user_id"
                       options="{'no_open': True}"
                       invisible="check_type_show_selection == 'true' or review_state != 'checked'"/>
                <field name="review_date"
                       invisible="check_type_show_selection == 'true' or review_state != 'checked'"/>
            </xpath>
        </field>
    </record>

    <!-- list/search นี้ใช้ร่วมกับเมนูที่ check_show = True ด้วย
         จึงซ่อนคอลัมน์ไว้เมื่อ context บอกว่าเป็นเมนูนั้น -->
    <record id="view_voucher_tree_purchase_review_state" model="ir.ui.view">
        <field name="name">account.voucher.list.supplier.review.state</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_voucher_tree_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="review_state"
                       widget="badge"
                       column_invisible="context.get('default_check_show')"
                       decoration-warning="review_state == 'waiting'"
                       decoration-success="review_state == 'checked'"/>
            </xpath>
        </field>
    </record>

    <record id="view_voucher_filter_vendor_review_state" model="ir.ui.view">
        <field name="name">account.voucher.purchase.select.review.state</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_voucher_filter_vendor"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='posted']" position="after">
                <separator/>
                <filter string="รอตรวจสอบ" name="review_waiting"
                        domain="[('review_state', '=', 'waiting'), ('check_type_show_selection', '!=', 'true')]"/>
                <filter string="ตรวจสอบแล้ว" name="review_checked"
                        domain="[('review_state', '=', 'checked'), ('check_type_show_selection', '!=', 'true')]"/>
            </xpath>
            <xpath expr="//filter[@name='status']" position="after">
                <filter string="สถานะตรวจสอบ" name="group_review_state"
                        context="{'group_by': 'review_state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
