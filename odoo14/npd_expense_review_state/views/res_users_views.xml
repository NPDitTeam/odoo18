<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- res.users form - เพิ่ม toggle "แสดงปุ่มตรวจสอบแล้ว"
         o18 หน้าผู้ใช้ใช้ page name="preferences" (o14 ใช้ references) -->
    <record id="view_users_form_expense_review" model="ir.ui.view">
        <field name="name">res.users.form.expense.review</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="สิทธิ์ตรวจสอบเอกสารรายจ่าย" name="expense_review_grp">
                    <field name="show_expense_review_button"
                           widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
