<?xml version="1.0"?>
<odoo>
    <record id="jasper_non_vat_invoice_report" model="ir.actions.report">
        <field name="name">ใบแจ้งหนี้ขาย (Non Vat)</field>
        <field name="model">account.move</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_non_vat_invoice_jasper/report/non_vat_invoice.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบแจ้งหนี้ขาย Non Vat</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบแจ้งหนี้ขาย Non Vat - %s' % (object.name)</field>
    </record>

    <record id="jasper_non_vat_invoice_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">non_vat_invoice.jrxml</field>
        <field name="report_id" ref="pfb_npd_non_vat_invoice_jasper.jasper_non_vat_invoice_report"/>
        <field name="file" type="base64" file="pfb_npd_non_vat_invoice_jasper/report/non_vat_invoice.jrxml"/>
    </record>
</odoo>
