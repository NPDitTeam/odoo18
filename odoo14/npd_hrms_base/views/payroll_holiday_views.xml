<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payroll_holiday_list" model="ir.ui.view">
        <field name="name">payroll.holiday.list</field>
        <field name="model">payroll.holiday</field>
        <field name="arch" type="xml">
            <list string="วันหยุดประจำปี">
                <field name="name"/>
                <field name="year"/>
                <field name="holiday_count" string="จำนวนวันหยุด"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_holiday_form" model="ir.ui.view">
        <field name="name">payroll.holiday.form</field>
        <field name="model">payroll.holiday</field>
        <field name="arch" type="xml">
            <form string="วันหยุดประจำปี">
                <header>
                    <button name="action_copy_from_previous_year" type="object"
                            string="คัดลอกจากปีก่อนหน้า" class="btn-secondary"
                            confirm="ระบบจะคัดลอกรายการวันหยุดของปีก่อนหน้ามาเป็นตั้งต้น (วันที่อาจต้องแก้ให้ตรงประกาศจริง) ต้องการดำเนินการหรือไม่?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="holiday_count"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายการวันหยุด" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="is_paid"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payroll_holiday" model="ir.actions.act_window">
        <field name="name">วันหยุดประจำปี</field>
        <field name="res_model">payroll.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">สร้างเทมเพลตวันหยุดของปีนี้</p>
            <p>ระบบใช้รายการนี้ตัดสินว่าวันไหนไม่ต้องมาทำงาน — มีผลต่อการคิดขาดงานและ OT</p>
        </field>
    </record>

</odoo>
