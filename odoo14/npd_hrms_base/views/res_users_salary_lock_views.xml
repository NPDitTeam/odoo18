<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ติ๊กล็อกการแก้ไขค่าจ้างในหน้าตั้งค่าผู้ใช้ (ตั้งค่า > ผู้ใช้) -->
    <record id="view_users_form_salary_lock" model="ir.ui.view">
        <field name="name">res.users.form.salary.lock</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="สิทธิ์ข้อมูลเงินเดือน" name="salary_lock">
                    <group>
                        <field name="lock_salary_fields"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
