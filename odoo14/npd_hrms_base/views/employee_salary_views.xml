<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_salary_list" model="ir.ui.view">
        <field name="name">employee.salary.list</field>
        <field name="model">employee.salary</field>
        <field name="arch" type="xml">
            <list string="พนักงาน" decoration-muted="status == 'inactive'">
                <field name="employee_code"/>
                <field name="prefix_th" optional="hide"/>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="nickname" optional="hide"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="position_id"/>
                <field name="employee_type"/>
                <field name="work_schedule_state" widget="badge"
                       decoration-danger="work_schedule_state == 'unset'"
                       decoration-success="work_schedule_state == 'checkin'"
                       decoration-info="work_schedule_state == 'no_checkin'"/>
                <field name="phone_number" optional="hide"/>
                <field name="start_date"/>
                <field name="resign_date" optional="hide"/>
                <field name="salary" sum="รวมค่าจ้าง"
                       groups="npd_hrms_base.group_hrms_payroll"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-danger="status == 'inactive'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_employee_salary_kanban" model="ir.ui.view">
        <field name="name">employee.salary.kanban</field>
        <field name="model">employee.salary</field>
        <field name="arch" type="xml">
            <kanban class="o_hr_employee_kanban" sample="1">
                <field name="employee_image"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="employee_image" widget="image"
                                   class="o_kanban_image_fill_left me-2"
                                   options="{'img_class': 'object-fit-cover'}"/>
                            <div class="flex-grow-1">
                                <field name="full_name" class="fw-bold fs-5"/>
                                <field name="employee_code" class="text-muted"/>
                                <div class="mt-1">
                                    <field name="position_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="branch_id"/>
                                </div>
                                <div class="mt-1">
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'active'"
                                           decoration-danger="status == 'inactive'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_employee_salary_form" model="ir.ui.view">
        <field name="name">employee.salary.form</field>
        <field name="model">employee.salary</field>
        <field name="arch" type="xml">
            <form string="พนักงาน">
                <header>
                    <button name="action_reset_device_id" type="object"
                            string="รีเซ็ต Device ID" class="btn-secondary"
                            confirm="พนักงานจะสามารถล็อกอินจากเครื่องใหม่ได้ในครั้งถัดไป ยืนยันหรือไม่?"/>
                    <button name="action_generate_pin" type="object"
                            string="สุ่ม PIN ใหม่" class="btn-secondary"
                            groups="npd_hrms_base.group_hrms_officer"
                            confirm="PIN เดิมจะใช้ไม่ได้ทันที ต้องแจ้ง PIN ใหม่ให้พนักงาน ยืนยันหรือไม่?"/>
                    <button name="action_unlock_login" type="object"
                            string="ปลดล็อกบัญชี" class="btn-warning"
                            invisible="not login_locked_until"/>
                    <button name="action_create_hr_employee" type="object"
                            string="สร้างพนักงานใน Odoo HR" class="btn-secondary"
                            invisible="hr_employee_id"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="active,inactive"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_work_schedule" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <div class="o_stat_info">
                                <span class="o_stat_text">ตารางงาน</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="ลาออกแล้ว" bg_color="text-bg-danger"
                            invisible="status == 'active'"/>
                    <field name="employee_image" widget="image"
                           class="oe_avatar" options="{'preview_image': 'employee_image'}"/>
                    <div class="oe_title">
                        <label for="employee_code" string="รหัสพนักงาน"/>
                        <h1><field name="employee_code" readonly="1"/></h1>
                        <h2>
                            <field name="prefix_th" placeholder="คำนำหน้า" class="oe_inline"/>
                            <field name="firstname" placeholder="ชื่อ" class="oe_inline"/>
                            <field name="lastname" placeholder="นามสกุล" class="oe_inline"/>
                        </h2>
                        <field name="full_name" invisible="1"/>
                        <field name="active" invisible="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="user_id">
                        เลือก <b>ผู้ใช้ในระบบ</b> ด้านล่าง แล้วชื่อ บริษัท และสาขา
                        จะถูกดึงมาให้อัตโนมัติ — หรือจะกรอกเองก็ได้ถ้าพนักงานคนนี้ไม่มีบัญชีผู้ใช้
                    </div>
                    <group>
                        <group string="สังกัด">
                            <field name="user_id" options="{'no_create': True}"
                                   placeholder="เลือกผู้ใช้เพื่อดึงชื่อ/บริษัท/สาขา"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="branch_id" options="{'no_create': True}"/>
                            <field name="department_id"/>
                            <field name="position_id"/>
                            <field name="employee_type"/>
                        </group>
                        <group string="ติดต่อ">
                            <field name="nickname"/>
                            <field name="phone_number" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="line_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="ข้อมูลส่วนตัว" name="personal">
                            <group>
                                <group string="ประวัติ">
                                    <field name="firstname_eng"/>
                                    <field name="lastname_eng"/>
                                    <field name="gender"/>
                                    <field name="nationality"/>
                                    <field name="marital_status"/>
                                    <field name="birthdate"/>
                                    <field name="age"/>
                                </group>
                                <group string="เอกสาร">
                                    <field name="id_card_number"/>
                                    <field name="passport_number"/>
                                    <field name="social_security_number"/>
                                    <field name="address"/>
                                    <field name="personal_equipment"/>
                                </group>
                            </group>
                        </page>

                        <page string="การจ้างงาน" name="employment">
                            <group>
                                <group string="วันสำคัญ">
                                    <field name="start_date"/>
                                    <field name="appointment_date"/>
                                    <field name="end_trial_date"/>
                                    <field name="probation_period"/>
                                    <field name="contract_end_date"/>
                                    <field name="retirement_year"/>
                                </group>
                                <group string="สิ้นสุดการจ้าง">
                                    <field name="resign_date"/>
                                    <field name="service_duration"/>
                                    <field name="auto_payroll"/>
                                    <field name="hr_employee_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>

                        <page string="ค่าจ้างและสิทธิประโยชน์" name="payroll"
                              groups="npd_hrms_base.group_hrms_payroll">
                            <group>
                                <group string="รายได้ประจำ">
                                    <field name="salary"/>
                                    <field name="cost_of_living"/>
                                    <field name="position_allowance"/>
                                    <field name="experience_allowance"/>
                                    <field name="professional_allowance"/>
                                </group>
                                <group string="เงินเบิกล่วงหน้า">
                                    <field name="advance_payment_type"/>
                                    <field name="advance_payment_limit"/>
                                </group>
                            </group>
                            <group>
                                <group string="ประกันสังคม">
                                    <field name="enable_social_security"/>
                                    <field name="social_security_condition"
                                           invisible="not enable_social_security"/>
                                    <field name="social_security_fixed_amount"
                                           invisible="not enable_social_security"/>
                                    <field name="social_security_start_date"
                                           invisible="not enable_social_security"/>
                                </group>
                                <group string="ภาษี">
                                    <field name="enable_tax"/>
                                    <field name="tax_condition" invisible="not enable_tax"/>
                                    <field name="tax_exception" invisible="not enable_tax"/>
                                    <field name="tax_start_date_condition"
                                           invisible="not enable_tax"/>
                                </group>
                            </group>
                            <group string="การจ่ายเงิน">
                                <group>
                                    <field name="payment_channel"/>
                                    <field name="transfer_type"/>
                                    <field name="payment_journal_id"
                                           options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="bank_name"/>
                                    <field name="bank_branch_code"/>
                                    <field name="bank_account_number"/>
                                </group>
                            </group>
                            <group string="รายละเอียดเพิ่มเติม">
                                <field name="details" nolabel="1"/>
                            </group>
                        </page>

                        <page string="การเข้าใช้แอป" name="app_access"
                              groups="npd_hrms_base.group_hrms_officer">
                            <group>
                                <group string="การยืนยันตัวตน">
                                    <field name="pin" password="True"/>
                                    <field name="fingerprint_id"/>
                                    <field name="allow_multi_login"/>
                                    <field name="allow_offsite_time"/>
                                </group>
                                <group string="อุปกรณ์ที่ผูกไว้">
                                    <field name="device_id"/>
                                    <field name="device_bound_at"/>
                                    <field name="failed_login_count"/>
                                    <field name="login_locked_until"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not login_locked_until">
                                บัญชีนี้ถูกล็อกจากการใส่ PIN ผิดหลายครั้ง —
                                กดปุ่ม "ปลดล็อกบัญชี" ด้านบนเพื่อให้พนักงานเข้าใช้งานได้อีกครั้ง
                            </div>
                        </page>

                        <page string="พฤติกรรมการทำงาน" name="behavior">
                            <field name="behavior_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="kind"/>
                                    <field name="name"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>

                        <page string="รูปภาพประวัติการทำงาน" name="work_history">
                            <field name="work_history_image_ids">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <div>
                                                <field name="image" widget="image"
                                                       options="{'size': [200, 200]}"/>
                                                <div><field name="name"/></div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_employee_salary_search" model="ir.ui.view">
        <field name="name">employee.salary.search</field>
        <field name="model">employee.salary</field>
        <field name="arch" type="xml">
            <search string="ค้นหาพนักงาน">
                <field name="full_name" string="ชื่อพนักงาน"
                       filter_domain="['|', '|', ('firstname', 'ilike', self), ('lastname', 'ilike', self), ('nickname', 'ilike', self)]"/>
                <field name="employee_code"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="position_id"/>
                <field name="phone_number"/>
                <field name="id_card_number"/>
                <filter name="filter_active" string="ใช้งาน"
                        domain="[('status', '=', 'active')]"/>
                <filter name="filter_inactive" string="ไม่ใช้งาน"
                        domain="[('status', '=', 'inactive')]"/>
                <separator/>
                <filter name="filter_resigned" string="มีวันที่ลาออก"
                        domain="[('resign_date', '!=', False)]"/>
                <filter name="filter_probation" string="ทดลองงาน"
                        domain="[('employee_type', '=', 'ทดลองงาน')]"/>
                <separator/>
                <filter name="filter_no_schedule" string="ยังไม่ลงกะ"
                        domain="[('work_schedule_state', '=', 'unset')]"/>
                <filter name="filter_has_schedule" string="ลงกะแล้ว"
                        domain="[('work_schedule_state', '!=', 'unset')]"/>
                <separator/>
                <filter name="filter_no_pin" string="ยังไม่มี PIN"
                        domain="[('pin', '=', False)]"/>
                <filter name="filter_locked" string="บัญชีถูกล็อก"
                        domain="[('login_locked_until', '!=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="เก็บถาวร"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_branch" string="สาขา"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_department" string="แผนก"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_position" string="ตำแหน่ง"
                            context="{'group_by': 'position_id'}"/>
                    <filter name="group_type" string="ประเภทพนักงาน"
                            context="{'group_by': 'employee_type'}"/>
                    <filter name="group_status" string="สถานะ"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_company" string="บริษัท"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_employee_salary" model="ir.actions.act_window">
        <field name="name">พนักงาน</field>
        <field name="res_model">employee.salary</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_employee_salary_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">เพิ่มพนักงานคนแรก</p>
            <p>ระบบจะสร้างรหัสพนักงานให้อัตโนมัติตามนโยบายที่ตั้งไว้ในหน้าตั้งค่า</p>
        </field>
    </record>

</odoo>
