<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- แยกข้อมูลพนักงานตามบริษัท — สำคัญเมื่อปล่อยเช่าระบบให้หลายบริษัทใช้ DB เดียว -->
        <record id="rule_employee_salary_company" model="ir.rule">
            <field name="name">พนักงาน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_employee_salary"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_employee_warning_company" model="ir.rule">
            <field name="name">ใบเตือน: เห็นเฉพาะบริษัทที่ได้รับอนุญาต</field>
            <field name="model_id" ref="model_employee_warning"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- พนักงานทั่วไป (ไม่ใช่เจ้าหน้าที่บุคคล) เห็นได้เฉพาะบัตรของตัวเอง -->
        <record id="rule_employee_salary_own_only" model="ir.rule">
            <field name="name">พนักงาน: เห็นเฉพาะข้อมูลของตัวเอง</field>
            <field name="model_id" ref="model_employee_salary"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('npd_hrms_base.group_hrms_user'))]"/>
        </record>

        <record id="rule_employee_salary_officer_all" model="ir.rule">
            <field name="name">พนักงาน: เจ้าหน้าที่บุคคลเห็นทุกคน</field>
            <field name="model_id" ref="model_employee_salary"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('npd_hrms_base.group_hrms_officer'))]"/>
        </record>

    </data>
</odoo>
