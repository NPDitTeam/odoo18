<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- คอลัมน์ตามลำดับ o14: ... ราคาต่อหน่วย, ประเภทการลดราคา, ยอดส่วนลด, วันที่จัดส่งสินค้า, ภาษี, ยอดหลังหักส่วนลด, รวม -->
    <record id="view_order_form_line_discount_o14" model="ir.ui.view">
        <field name="name">sale.order.form.line.discount.o14</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <!-- หลัง npd_logistics_hide_buttons (99) ที่ย้ายค่าประกันไปหลังหน่วยวัด -->
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- น้ำหนักต่อหน่วย (ดึงจากน้ำหนักสินค้า) ต่อจากค่าประกันแบบ o14 — แก้ไม่ได้ กันน้ำหนักรวมเพี้ยน -->
            <xpath expr="//field[@name='order_line']/list/field[@name='pfb_insurance_price']" position="after">
                <field name="second_uom_qty" string="น้ำหนักต่อหน่วย" readonly="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="before">
                <field name="discount_method"/>
                <field name="discount_amount" string="ยอดส่วนลด"
                       readonly="discount_method not in ('fix', 'per')"/>
                <field name="commitment_date" optional="show"/>
            </xpath>
            <!-- สรุปท้ายใบแบบ o14: - Line Discount / - Rental Discount แสดงในตารางยอดก่อนบรรทัด VAT
                 (static/src/xml/tax_totals_discount.xml) ช่องในฟอร์มเก็บไว้ให้โหลดค่าเท่านั้น -->
            <xpath expr="//group[@name='sale_total']/field[@name='total_rental_discount']" position="before">
                <field name="discount_amt_line" invisible="1"/>
            </xpath>
            <xpath expr="//group[@name='sale_total']/field[@name='total_rental_discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- ยืนยันเป็นคำสั่งขายแล้ว แก้/เพิ่ม/ลบรายการสินค้าไม่ได้ (ผู้ใช้สั่ง 23 ต.ค. 2569)
                 เดิม: state == 'cancel' or locked or not pricelist_id -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state in ('sale', 'done', 'cancel') or locked or not pricelist_id</attribute>
            </xpath>
            <!-- เงื่อนไขและข้อกำหนด: ข้อความธรรมดาแทนตัวแก้ HTML (ซ่อนช่องเดิม ไม่ replace เพราะวิวอื่นอาจ xpath หา note) -->
            <xpath expr="//field[@name='note']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='note']" position="after">
                <field name="npd_note_text" colspan="2" nolabel="1" placeholder="เงื่อนไขและข้อกำหนด..."/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="after">
                <field name="price_subtotal_without_discount" widget="monetary"/>
            </xpath>
        </field>
    </record>
</odoo>
