<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- อนุมัติแยกเรื่อง (ส่วนลดสินค้า / ค่าประกัน) — ผู้ใช้สั่ง 23 ต.ค. 2569 -->
    <record id="view_order_form_npd_split_approval" model="ir.ui.view">
        <field name="name">sale.order.form.npd.split.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">101</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_sale']" position="after">
                <field name="npd_disc_need" invisible="1"/>
                <field name="npd_ins_need" invisible="1"/>
                <field name="npd_disc_appr" readonly="1" widget="badge"
                       decoration-info="npd_disc_appr == 'waiting'"
                       decoration-success="npd_disc_appr == 'approved'"
                       decoration-danger="npd_disc_appr == 'rejected'"
                       invisible="not npd_disc_appr"/>
                <field name="npd_ins_appr" readonly="1" widget="badge"
                       decoration-info="npd_ins_appr == 'waiting'"
                       decoration-success="npd_ins_appr == 'approved'"
                       decoration-danger="npd_ins_appr == 'rejected'"
                       invisible="not npd_ins_appr"/>
            </xpath>
            <xpath expr="//header[not(@name='quotation')]/button[@name='action_waiting_to_approve']" position="attributes">
                <attribute name="string">ส่งขออนุมัติ</attribute>
            </xpath>
            <xpath expr="//header[@name='quotation']/button[@name='action_waiting_to_approve']" position="attributes">
                <attribute name="string">ส่งขออนุมัติ</attribute>
            </xpath>
            <xpath expr="//header[not(@name='quotation')]/button[@name='action_open_approval_popup']" position="attributes">
                <attribute name="string">พิจารณาอนุมัติ</attribute>
            </xpath>
            <xpath expr="//header[@name='quotation']/button[@name='action_open_approval_popup']" position="attributes">
                <attribute name="string">พิจารณาอนุมัติ</attribute>
            </xpath>
            <xpath expr="//header[@name='quotation']/button[@name='action_reject']" position="attributes">
                <attribute name="string">ไม่อนุมัติทั้งหมด</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_npd_waiting_mine" model="ir.ui.view">
        <field name="name">sale.order.search.npd.waiting.mine</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="npd_waiting_mine" string="รออนุมัติ (ของฉัน)"
                        domain="[('state_sale', '=', 'waiting_to_approve'), ('approver_id', '=', uid)]"/>
                <filter name="npd_waiting_all" string="รออนุมัติ (ทั้งหมด)"
                        domain="[('state_sale', '=', 'waiting_to_approve')]"/>
            </xpath>
        </field>
    </record>

    <record id="view_npd_sale_approval_request_form" model="ir.ui.view">
        <field name="name">npd.sale.approval.request.form</field>
        <field name="model">npd.sale.approval.request</field>
        <field name="arch" type="xml">
            <form string="ส่งขออนุมัติ">
                <field name="order_id" invisible="1"/>
                <div class="alert alert-warning mb-3" role="alert">
                    <strong>ใบนี้ต้องขออนุมัติเรื่องต่อไปนี้</strong>
                    <field name="summary" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <field name="approver_id" options="{'no_create': True}"/>
                    <field name="note" placeholder="เช่น ลูกค้าประจำ สั่งต่อเนื่อง ขอลดพิเศษ"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="ส่งขออนุมัติ" class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_npd_sale_approval_decide_form" model="ir.ui.view">
        <field name="name">npd.sale.approval.decide.form</field>
        <field name="model">npd.sale.approval.decide</field>
        <field name="arch" type="xml">
            <form string="พิจารณาอนุมัติ">
                <field name="order_id" invisible="1"/>
                <group>
                    <field name="requester_id" readonly="1"/>
                    <field name="request_note" readonly="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="kind" column_invisible="1" force_save="1"/>
                        <field name="name" force_save="1"/>
                        <field name="detail" force_save="1"/>
                        <field name="decision" widget="radio" options="{'horizontal': true}"/>
                    </list>
                </field>
                <group>
                    <field name="note" placeholder="บังคับกรอกเมื่อไม่อนุมัติเรื่องใด"/>
                </group>
                <footer>
                    <button name="action_approve_all" type="object" string="อนุมัติทั้งหมด" class="btn-primary"/>
                    <button name="action_confirm" type="object" string="บันทึกผลตามที่เลือก" class="btn-secondary"/>
                    <button string="ปิด" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
