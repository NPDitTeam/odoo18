<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ใบแจ้งหนี้จากใบสั่งขาย: คอลัมน์ ประเภทการลดราคา / ยอดส่วนลด แบบ o14 (อ่านอย่างเดียว ยอดหักจริงอยู่ใน ลด%)
         ท้ายใบ - Line Discount อยู่ในตารางยอด (static/src/xml/tax_totals_discount.xml) -->
    <record id="view_move_form_npd_line_discount" model="ir.ui.view">
        <field name="name">account.move.form.npd.line.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="discount_method" readonly="1" force_save="1"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"/>
                <field name="discount_amount" readonly="1" force_save="1"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="discount_amt_line" invisible="1"/>
            </xpath>
            <!-- - ส่วนลดค่าเช่า ท้ายใบแจ้งหนี้: o14 ไม่เคยมีค่า (0 ทุกใบ) การคืนเงินประกันใช้ rent_discount ของใบรับคืนสินค้า
                 ผู้ใช้สั่งซ่อน 23 ต.ค. 2569 -->
            <xpath expr="//field[@name='total_rental_discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
