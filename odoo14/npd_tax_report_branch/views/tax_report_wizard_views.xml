<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tax_report_wizard_form_branch" model="ir.ui.view">
        <field name="name">tax.report.wizard.form.branch</field>
        <field name="model">tax.report.wizard</field>
        <field name="inherit_id" ref="l10n_th_tax_report.tax_report_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_group_id']" position="before">
                <field name="report_tax_type" widget="radio" options="{'horizontal': true}"/>
            </xpath>
            <!-- เลือกได้เฉพาะภาษีประเภทเดียวกัน ภาษีซื้อกับภาษีขายจึงปนกันไม่ได้ -->
            <xpath expr="//field[@name='tax_id']" position="attributes">
                <attribute name="domain">[('type_tax_use', '=', report_tax_type)]</attribute>
            </xpath>
            <!-- สาขาแสดงหลังเลือก Tax: ภาษีซื้อใช้สาขาสำนักงานใหญ่, ภาษีขายใช้สาขาเดิม -->
            <xpath expr="//field[@name='date_range_id']" position="after">
                <field name="branch_all" invisible="not tax_id"/>
                <field name="filter_head_office_branch_id"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="not tax_id or branch_all or report_tax_type != 'purchase'"
                       required="not branch_all and report_tax_type == 'purchase'"/>
                <field name="filter_branch_id"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="not tax_id or branch_all or report_tax_type == 'purchase'"
                       required="not branch_all and report_tax_type != 'purchase'"/>
            </xpath>
        </field>
    </record>

</odoo>
