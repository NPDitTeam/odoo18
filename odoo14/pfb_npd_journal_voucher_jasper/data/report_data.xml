<?xml version="1.0"?>
<odoo>
    <record id="jasper_journal_voucher_report" model="ir.actions.report">
        <field name="name">ใบสำคัญจ่าย</field>
        <field name="model">account.move</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_journal_voucher_jasper/report/journal_voucher.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบสำคัญจ่าย</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบสำคัญจ่าย - %s' % (object.name)</field>
    </record>

    <record id="jasper_journal_voucher_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">journal_voucher.jrxml</field>
        <field name="report_id" ref="pfb_npd_journal_voucher_jasper.jasper_journal_voucher_report"/>
        <field name="file" type="base64" file="pfb_npd_journal_voucher_jasper/report/journal_voucher.jrxml"/>
    </record>
</odoo>
