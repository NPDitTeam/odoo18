<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_advance_form_view" model="ir.ui.view">
        <field name="name">account.advance.form</field>
        <field name="model">account.advance</field>
        <field name="arch" type="xml">
            <form string="Account Advance">
                <header>
                    <button name="open" string="Confirm" class="oe_highlight"
                            invisible="state != 'draft'" type="object"
                            groups="account.group_account_user,account.group_account_manager"/>
                    <button name="cancel" string="Cancel"
                            invisible="state != 'draft'" type="object"
                            groups="account.group_account_user,account.group_account_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submit,cancel"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Clear"
                            invisible="remain != 0 or state != 'submit'"/>
                    <widget name="web_ribbon" title="Wait Clear"
                            bg_color="text-bg-info"
                            invisible="remain == 0 or state != 'submit'"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="department_id"
                                   readonly="state != 'draft'"/>
                            <field name="payee_ids" widget="many2many_tags"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"/>
                            <field name="branch_id"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="advance_date"
                                   readonly="state != 'draft'"/>
                            <field name="due_date"
                                   readonly="state != 'draft'"/>
                            <field name="due_date_clear"
                                   readonly="state != 'draft'"/>
                            <field name="advance_request_id"
                                   domain="[('employee_id', '=', employee_id), ('state', '=', 'approve')]"
                                   readonly="state != 'draft'"/>
                            <field name="description"
                                   readonly="state != 'draft'"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payment">
                            <field name="journal_id"
                                   readonly="state != 'draft'"/>
                            <field name="account_id"
                                   readonly="state != 'draft'"/>
                            <field name="payment_method_id"
                                   invisible="is_payment_multi"
                                   readonly="state == 'submit'"/>
                            <field name="is_payment_multi"
                                   readonly="state == 'submit'"/>
                            <field name="total"
                                   readonly="state != 'draft'"/>
                            <field name="remain"/>
                            <field name="clear"/>
                            <field name="payment_total"/>
                        </group>
                    </group>
                    <group col="6" class="mt-2 mt-md-0" string="Payment Multi"
                           invisible="not is_payment_multi">
                        <field name="payment_ids"
                               invisible="not is_payment_multi"
                               readonly="state == 'submit'">
                            <list editable="bottom" string="Payment">
                                <field name="company_id" column_invisible="1"/>
                                <field name="payment_method_id"
                                       domain="[('is_active', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                <field name="bank_account_id"/>
                                <field name="ref"/>
                                <field name="total" sum="Total Amount"/>
                            </list>
                        </field>
                    </group>
                    <group string="Clear Advance">
                        <field name="clear_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="employee_id"/>
                                <field name="doc_date"/>
                                <field name="exclude_amount"/>
                                <field name="amount_clearing"/>
                                <field name="clear_amount"/>
                                <field name="state"
                                       widget="badge"
                                       decoration-success="state == 'post'"
                                       decoration-info="state == 'draft'"
                                       decoration-danger="state == 'cancel'"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="account_advance_rule_branch_conditional" model="ir.rule">
        <field name="name">Account Advance - HQ sees all / Branch sees own</field>
        <field name="model_id" ref="model_account_advance"/>
        <field name="domain_force">
            ['|', ('branch_id', '=', False), ('branch_id', 'in', user.branch_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="account_advance_tree" model="ir.ui.view">
        <field name="name">account.advance.tree</field>
        <field name="model">account.advance</field>
        <field name="arch" type="xml">
            <list string="Account Advance">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="due_date"/>
                <field name="payment_method_id" optional="show"/>
                <field name="total"/>
                <field name="state"/>
                <field name="state_remain"/>
            </list>
        </field>
    </record>

    <record id="action_account_advance" model="ir.actions.act_window">
        <field name="name">Account Advance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.advance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Account Advance
            </p>
        </field>
    </record>

    <menuitem id="account_advance_menu" name="Account Advance"
              parent="account_advance_root"
              action="action_account_advance" sequence="20"/>
</odoo>
