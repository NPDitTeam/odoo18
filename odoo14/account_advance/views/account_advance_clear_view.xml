<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_advance_clear_form_view" model="ir.ui.view">
        <field name="name">account.advance.clear.form</field>
        <field name="model">account.advance.clear</field>
        <field name="arch" type="xml">
            <form string="Advance Clear">
                <header>
                    <button name="submit" string="Confirm" class="oe_highlight"
                            invisible="state != 'draft'" type="object"/>
                    <button name="confirm" string="Post" class="oe_highlight"
                            invisible="state != 'confirm'" type="object"
                            groups="account.group_account_manager"/>
                    <button name="action_cancel_draft" string="Cancel"
                            invisible="state not in ('draft', 'confirm')" type="object"
                            groups="account.group_account_manager"/>
                    <button name="cancel_advance" string="Cancel"
                            invisible="state != 'post'" type="object"
                            groups="account.group_account_manager"/>
                    <button name="set_draft" string="Reset To Draft"
                            invisible="state not in ('cancel', 'confirm')" type="object"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,post,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="advance_id"
                                   readonly="state != 'draft'"/>
                            <field name="journal_id"
                                   readonly="state != 'draft'"/>
                            <field name="account_id"
                                   readonly="state != 'draft'"/>
                            <field name="move_id" readonly="1"/>
                            <field name="branch_id"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="doc_date"
                                   readonly="state != 'draft'"/>
                            <field name="description"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id"
                                   readonly="state != 'draft'"/>
                            <field name="is_partial"
                                   readonly="state != 'draft'"/>
                            <field name="payment_method_id"
                                   readonly="state != 'draft'"/>
                            <field name="advance_amount"
                                   invisible="not is_partial"/>
                            <field name="amount_clearing"
                                   invisible="not is_partial"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail">
                            <field name="clear_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="account_id"
                                           groups="account.group_account_user,account.group_account_manager"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           groups="analytic.group_analytic_accounting"
                                           optional="show"/>
                                    <field name="invoice_number"/>
                                    <field name="invoice_date"/>
                                    <field name="partner_id"
                                           groups="account.group_account_user,account.group_account_manager"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"
                                           domain="[('type_tax_use', '=', 'purchase')]"/>
                                    <field name="price_subtotal"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="note"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="untaxed_amount"/>
                                    <field name="tax_amount"/>
                                    <field name="wht_amount"/>
                                    <field name="amount" invisible="1"/>
                                    <field name="exclude_amount"/>
                                    <field name="advance_amount"/>
                                    <field name="clear_amount"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tax">
                            <field name="tax_line">
                                <list string="Tax" editable="bottom">
                                    <field name="tax_invoice_number"/>
                                    <field name="tax_invoice_date"/>
                                    <field name="partner_id"/>
                                    <field name="tax_base_amount"/>
                                    <field name="balance"/>
                                </list>
                            </field>
                        </page>
                        <page string="Withholding Tax">
                            <field name="wt_cert_ids"
                                   readonly="state != 'draft'">
                                <list string="WHT Cert">
                                    <field name="income_tax_form"/>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"
                                           string="Supplier"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="account_advance_clear_rule_branch" model="ir.rule">
        <field name="name">Advance Clear: HQ sees all / Branch sees own</field>
        <field name="model_id" ref="model_account_advance_clear"/>
        <field name="domain_force">
            ['|', ('branch_id', '=', False), ('branch_id', 'in', user.branch_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="account_advance_clear_tree" model="ir.ui.view">
        <field name="name">account.advance.clear.tree</field>
        <field name="model">account.advance.clear</field>
        <field name="arch" type="xml">
            <list string="Advance Clear">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="advance_id"/>
                <field name="doc_date"/>
                <field name="advance_amount"/>
                <field name="description"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_account_advance_clear" model="ir.actions.act_window">
        <field name="name">Advance Clear</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.advance.clear</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Advance Clear
            </p>
        </field>
    </record>

    <menuitem id="account_advance_clear" name="Advance Clear"
              parent="account_advance_root"
              action="action_account_advance_clear" sequence="30"/>
</odoo>
