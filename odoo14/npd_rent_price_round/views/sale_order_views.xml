<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_npd_rent_price_round" model="ir.ui.view">
        <field name="name">sale.order.form.npd.rent.price.round</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="can_edit_use_new_calc" invisible="1"/>
                <field name="use_new_calc"
                       readonly="not can_edit_use_new_calc"/>
                <field name="use_baan_kheaw"
                       readonly="not can_edit_use_new_calc"/>
                <field name="vat_from_total"
                       readonly="not can_edit_use_new_calc"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']"
                   position="after">
                <field name="price_unit_no_vat" optional="show"/>
            </xpath>
            <!-- ยอดรวม VAT ต่อบรรทัด (จำนวน x ราคา) — Odoo มีคอลัมน์ "Tax Incl." ซ่อนไว้
                 เปิดให้แสดงเป็นค่าเริ่มต้น ช่อง "รวม" หลักเป็นยอดก่อน VAT -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_total'][@optional]"
                   position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">รวม VAT</attribute>
            </xpath>
            <!-- ท้ายใบ: ผลรวมคอลัมน์ "รวม VAT" ใต้กล่องยอดรวม -->
            <xpath expr="//group[@name='sale_total']/field[@name='tax_totals']" position="after">
                <div colspan="2" class="d-flex justify-content-end align-items-baseline gap-3">
                    <span class="text-muted">รวม VAT:</span>
                    <field name="npd_amount_total_vat" nolabel="1" widget="monetary"
                           options="{'currency_field': 'currency_id'}" class="fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
