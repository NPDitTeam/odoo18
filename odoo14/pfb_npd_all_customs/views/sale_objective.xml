<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="sale_objective_tree_view" model="ir.ui.view">
        <field name="name">sale.objective.tree</field>
        <field name="model">sale.objective</field>
        <field name="arch" type="xml">
            <list string="Sale Order Objective">
                <field name="name" />

            </list>
        </field>
    </record>
    <record id="sale_objective_form_view" model="ir.ui.view">
        <field name="name">sale.objective.form</field>
        <field name="model">sale.objective</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="top">
                        <group>
                            <field name="name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record
        id="action_sale_objective"
        model="ir.actions.act_window"
    >
        <field name="name">Sale Objective</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.objective</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_sale_objective"
        name="Objective"
        parent="sale.menu_sales_config"
        action="action_sale_objective"
    />
</odoo>
