<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="payment_reference" position="after">
                <field name="pfb_so_type" string="ประเภทใบเสนอราคา"/>
                <field name="pfb_objective_id" string="วัตถุประสงค์"/>
                <field name="contact_type" string="การติดต่อของลูกค้า"/>
                <field name="sales_contact" string="Sales ที่ติดต่อ"/>
            </field>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="pfb_so_rent_ok" column_invisible="1"/>
                <field name="move_state_parent" column_invisible="1"/>
                <field name="move_type_parent" column_invisible="1"/>
                <field name="pfb_date_of_rent" force_save="1"
                       invisible="not pfb_so_rent_ok"
                       readonly="move_type_parent != 'out_refund' and move_state_parent != 'draft'"/>
                <field name="pfb_quantity" force_save="1"
                       invisible="not pfb_so_rent_ok"
                       readonly="move_type_parent != 'out_refund' and move_state_parent != 'draft'"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='price_unit']" position="before">
                <field name="discount_type_selection"/>
            </xpath>

            <xpath expr="//group[hasclass('oe_subtotal_footer')]/field[@name='tax_totals']" position="after">
                <field name="total_rental_discount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- ปุ่ม "Add Debit Note" บนหัวฟอร์มใบแจ้งหนี้แบบ o14
         Odoo 18 ย้ายการสร้างใบเพิ่มหนี้ไปไว้เฉพาะเมนู ⚙ ในหน้ารายการ (binding_view_types=list)
         ปุ่มบนฟอร์มจึงหายไป — ใส่กลับด้วยเงื่อนไขเดียวกับ o14: ใบที่ลงบัญชีแล้ว, เป็นใบแจ้งหนี้/ใบลดหนี้,
         และไม่ใช่ใบเพิ่มหนี้เอง (debit_origin_id มีอยู่ในฟอร์มแล้วจาก account_debit_note) -->
    <record id="view_move_form_add_debit_note" model="ir.ui.view">
        <field name="name">account.move.form.add.debit.note</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_reverse']" position="after">
                <button name="%(account_debit_note.action_view_account_move_debit)d" string="Add Debit Note"
                        type="action" groups="account.group_account_invoice"
                        invisible="debit_origin_id or move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund') or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
