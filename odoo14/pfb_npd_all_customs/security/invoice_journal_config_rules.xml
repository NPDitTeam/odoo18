<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ตารางตั้งค่าต้องมองเห็นได้เท่ากับสมุดรายวันที่มันอ้างถึง
             ไม่งั้นจะเจออาการ "เห็นแถวของบริษัทอื่น แต่กดเลือกสมุดรายวันไม่ได้"
             เพราะ account.journal มี global rule ของตัวเองอยู่แล้ว
             (ใช้ parent_of เหมือนกันเป๊ะ เพื่อให้รองรับโครงสร้างบริษัทแบบสาขา) -->
        <record id="npd_invoice_journal_config_company_rule" model="ir.rule">
            <field name="name">สมุดรายวันออกใบแจ้งหนี้ multi-company</field>
            <field name="model_id" ref="model_npd_invoice_journal_config"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

    </data>
</odoo>
