<odoo>
    <!-- Assets removed: legacy JS not compatible with Odoo 18 OWL -->
    <!-- Use PDF/XLSX export instead of HTML preview -->
    <template id="l10n_th_tax_report.internal_layout">
        <div class="article">
            <link
                    href="/l10n_th_tax_report/static/src/css/report.css"
                    rel="stylesheet"
            />
            <t t-out="0"/>
        </div>
        <div class="footer">
            <div class="row">
                <div class="col-6 custom_footer">
                    <span
                            t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"
                    />
                </div>
                <div class="col-6 text-right custom_footer">
                    <span class="page"/>
                    /
                    <span class="topage"/>
                </div>
            </div>
        </div>
    </template>
    <template id="l10n_th_tax_report.report_buttons">
        <div class="button_row">
            <button class="o_l10n_th_tax_report_print btn btn-sm oe_button">
                <span class="fa fa-print"/>
                Print
            </button>
<!--            <button class="o_l10n_th_tax_report_export btn btn-sm oe_button">-->
<!--                <span class="fa fa-download"/>-->
<!--                Export-->
<!--            </button>-->
<!--            <button class="o_l10n_th_tax_report_export_test_excel btn btn-sm oe_button">-->
<!--                <span class="fa fa-download"/>-->
<!--                Export Test Excel-->
<!--            </button>-->
        </div>
    </template>
    <template id="l10n_th_tax_report.report_tax_report_html">
        <div class="o_l10n_th_tax_report_page">
            <t t-call="l10n_th_tax_report.report_buttons"/>
            <t t-call="l10n_th_tax_report.report_tax_report_base"/>
        </div>
    </template>
    <template id="l10n_th_tax_report.report_tax_report_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_th_tax_report.internal_layout">
                    <t t-call="l10n_th_tax_report.report_tax_report_base"/>
                </t>
            </t>
        </t>
    </template>
    <template id="l10n_th_tax_report.report_tax_report_base">
        <div class="page">
            <!-- Display Title -->
            <div class="row">
                <t t-set="tax_use" t-as=""/>
                <t t-foreach="o.tax_id" t-as="tax">
                    <t t-set="tax_use" t-as="tax.type_tax_use"/>
                </t>
                <t t-if="tax_use == 'sale'">
                    <h4 class="mt0" style="text-align: center;">Sale VAT Report</h4>
                </t>
                <t t-elif="tax_use == 'purchase'">
                    <h4 class="mt0" style="text-align: center;">Purchase VAT Report</h4>
                </t>
                <t t-else="">
                    <h4 class="mt0" style="text-align: center;">VAT Report</h4>
                </t>
            </div>
            <!-- Display filters -->
            <t t-call="l10n_th_tax_report.report_tax_report_filters"/>
            <!-- Display tax report table -->
            <t t-foreach="o.tax_id" t-as="tax">
                <t t-set="tax_name" t-value="o.env['account.tax'].search([('id', '=', tax.id)])"/>
                <t t-if="tax_name">
                    <h4 class="mt0" style="text-align: left;">
                        <br/>
                        <t t-esc="tax_name.name"/>
                    </h4>
                </t>
                <div class="act_as_table data_table mt8" style="width: 100%;">
                    <!-- Display header line-->
                    <t t-call="l10n_th_tax_report.report_tax_report_lines_header"/>
                    <!-- Display each lines -->
                    <t t-set="n" t-value="1"/>
                    <t t-set="total_base" t-value="0.00"/>
                    <t t-set="total_tax" t-value="0.00"/>
                    <t t-foreach="o.results" t-as="line">
                        <t t-if="line.tax_id.id == tax.id">
                            <t t-call="l10n_th_tax_report.report_tax_report_lines"/>
                            <t t-set="n" t-value="n+1"/>
                            <t t-set="total_base" t-value="total_base+line.tax_base_amount"/>
                            <t t-set="total_tax" t-value="total_tax+line.tax_amount"/>
                        </t>
                    </t>
                    <!-- Display total lines -->
                    <t t-call="l10n_th_tax_report.report_tax_report_total_lines"/>
                </div>
            </t>
        </div>
    </template>
    <template id="l10n_th_tax_report.report_tax_report_filters">
        <div class="act_as_table data_table" style="width: 100%;">
            <div class="act_as_row labels">
                <div class="act_as_cell">Period</div>
                <div class="act_as_cell">Partner</div>
                <div class="act_as_cell">Tax ID</div>
                <div class="act_as_cell">Branch ID</div>
            </div>
            <div class="act_as_row">
                <div class="act_as_cell">
                    <span t-field="o.date_range_id.display_name"/>
                </div>
                <div class="act_as_cell">
                    <span t-field="o.company_id.display_name"/>
                </div>
                <div class="act_as_cell">
                    <span t-field="o.company_id.partner_id.vat"/>
                </div>
                <div class="act_as_cell">
                    <span t-field="o.company_id.partner_id.branch"/>
                </div>
            </div>
        </div>
    </template>
    <template id="l10n_th_tax_report.report_tax_report_lines_header">
        <div class="act_as_thead">
            <div class="act_as_row labels">
                <div class="act_as_cell">#</div>
                <div class="act_as_cell">Date</div>
                <div class="act_as_cell">Invoice</div>
                <div class="act_as_cell">Payment</div>
                <div class="act_as_cell">Number</div>
                <div class="act_as_cell">Cust./Sup.</div>
                <div class="act_as_cell">Tax ID</div>
                <div class="act_as_cell">Branch ID</div>
                <div class="act_as_cell">Base Amount</div>
                <div class="act_as_cell">Tax Amount</div>
                <div class="act_as_cell">Doc Ref.</div>
                <div class="act_as_cell">Branch</div>

            </div>
        </div>
    </template>
    <template id="l10n_th_tax_report.report_tax_report_lines">
        <div class="act_as_row lines">
            <div class="act_as_cell left">
                <t t-esc="n"/>
            </div>
            <div class="act_as_cell left">
                <t t-esc="line.tax_date"/>
            </div>
            <!-- ค้นหา move object ก่อน -->
        <t t-set="move_obj" t-value="False"/>

        <t t-if="not move_obj and line.tax_invoice_number">
            <t t-set="move_obj" t-value="request.env['account.move.tax.invoice'].search([('tax_invoice_number', '=', line.tax_invoice_number)], limit=1)"/>
        </t>

        <!-- แสดง invoice name จาก payment -->
        <div class="act_as_cell left">
            <t t-if="move_obj and move_obj.payment_id and move_obj.payment_id.search_invoice_name">
                <t t-esc="move_obj.payment_id.search_invoice_name"/>
            </t>
        </div>
            <div class="act_as_cell left">
            <t t-if="move_obj and move_obj.payment_id and move_obj.payment_id.name">
                <t t-esc="move_obj.payment_id.name"/>
            </t>
        </div>
            <div class="act_as_cell left">
                <t t-esc="line.tax_invoice_number"/>
            </div>
            <div class="act_as_cell left">
                <t t-esc="line.partner_id.display_name"/>
            </div>
            <div class="act_as_cell left">
                <t t-esc="line.partner_id.vat"/>
            </div>
            <div class="act_as_cell left">
                <t t-esc="line.partner_id.branch"/>
            </div>
            <div class="act_as_cell amount">
                <t t-esc="'{0:,.2f}'.format(line.tax_base_amount)"/>
            </div>
            <div class="act_as_cell amount">
                <t t-esc="'{0:,.2f}'.format(line.tax_amount)"/>
            </div>
            <div class="act_as_cell left">
                <t t-esc="line.name"/>
            </div>
<!--            <t t-set="move_obj" t-value="False"/> <t t-if="line.name">-->
<!--                <t t-set="move_obj" t-value="request.env['account.move'].search([('ref', '=', line.name)], limit=1)"/>-->
<!--            </t>-->
<!--            <t t-if="not move_obj and line.tax_invoice_number"> <t t-set="move_obj" t-value="request.env['account.move'].search([('name', '=', line.tax_invoice_number)], limit=1)"/>-->
<!--            </t>-->

<!--            <div class="act_as_cell left">-->
<!--                <t t-esc="move_obj.branch_id.name if move_obj and move_obj.branch_id else ''"/>-->
<!--            </div>-->
            <div class="act_as_cell left">
            <t t-if="move_obj and move_obj.payment_id and move_obj.payment_id.branch_id">
                <t t-esc="move_obj.payment_id.branch_id.name"/>
            </t>
            <t t-else="">
                <t t-set="move_branch_obj" t-value="False"/>
                <t t-if="line.name">
                    <t t-set="move_branch_obj" t-value="request.env['account.move'].search([('ref', '=', line.name)], limit=1)"/>
                </t>
                <t t-if="not move_branch_obj and line.tax_invoice_number">
                    <t t-set="move_branch_obj" t-value="request.env['account.move'].search([('name', '=', line.tax_invoice_number)], limit=1)"/>
                </t>
                <t t-esc="move_branch_obj.branch_id.name if move_branch_obj and move_branch_obj.branch_id else ''"/>
            </t>
        </div>

        </div>
    </template>
    <template id="l10n_th_tax_report.report_tax_report_total_lines">
        <div class="act_as_row totals_table">
            <div class="act_as_cell"/>
            <div class="act_as_cell"/>
            <div class="act_as_cell"/>
            <div class="act_as_cell"/>
            <div class="act_as_cell"/>
            <div class="act_as_cell"/>
            <div class="act_as_cell"/>
             <div class="act_as_cell"/>
            <div class="act_as_cell amount">
                <t t-esc="'{0:,.2f}'.format(total_base)"/>
            </div>
            <div class="act_as_cell amount">
                <t t-esc="'{0:,.2f}'.format(total_tax)"/>
            </div>
            <div class="act_as_cell"/>
            <div class="act_as_cell"/>
        </div>
    </template>
</odoo>
