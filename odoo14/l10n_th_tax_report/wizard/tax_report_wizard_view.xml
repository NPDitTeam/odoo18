<odoo>
    <!-- List view for tax report results -->
    <record id="view_tax_report_view_list" model="ir.ui.view">
        <field name="name">tax.report.view.list</field>
        <field name="model">tax.report.view</field>
        <field name="arch" type="xml">
            <list string="TAX Report" create="false" edit="false" delete="false">
                <field name="tax_date" string="วันที่"/>
                <field name="tax_invoice_number" string="เลขที่ใบกำกับภาษี"/>
                <field name="partner_id" string="ลูกค้า/ผู้จำหน่าย"/>
                <field name="name" string="เอกสารอ้างอิง"/>
                <field name="tax_base_amount" string="ฐานภาษี" sum="รวม"/>
                <field name="tax_amount" string="ภาษี" sum="รวม"/>
                <field name="branch_id" string="สาขา" optional="show"/>
                <field name="tax_id" string="ภาษี" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="tax_report_wizard_form" model="ir.ui.view">
        <field name="name">tax.report.wizard.form</field>
        <field name="model">tax.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group name="criteria">
                    <group>
                        <field
                            name="company_id"
                            options="{'no_create_edit': True, 'no_open': True}"
                            groups="base.group_multi_company"
                        />
                        <field name="tax_group_id"
                         options="{'no_create_edit': True, 'no_open': True}"/>
                        <field
                            name="tax_id"
                            widget="many2many_tags"
                            options="{'no_create_edit': True, 'no_open': True}"
                        />
                    </group>
                    <group>
                        <field
                            name="date_range_id"
                            options="{'no_create_edit': False, 'no_open': False, 'no_quick_create': False}"
                        />
                                                </group>
                </group>
                <group invisible="1">
                    <field name="report_file" filename="report_file_name"/>
                    <field name="report_file_name"/>
                </group>
                <footer>
                    <button
                        name="button_export_html"
                        string="View"
                        type="object"
                        default_focus="1"
                        class="oe_highlight"
                    />
                    or
                    <button
                        name="button_export_pdf"
                        string="Export PDF"
                        type="object"
                    />
                    or
                    <button
                        name="button_export_test_xlsx"
                        string="Export Excel"
                        type="object"
                    />
                    or
<!--                    <button-->
<!--                        name="button_export_xlsx"-->
<!--                        string="Export XLSX"-->
<!--                        type="object"-->
<!--                    />-->
<!--                    or-->
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_tax_report" model="ir.actions.act_window">
        <field name="name">Thai Tax Reports</field>
        <field name="res_model">tax.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_tax_report"
        parent="account.menu_finance_reports"
        action="action_tax_report"
        name="Thai Tax Report"
        groups="account.group_account_manager,account.group_account_user"
    />
</odoo>