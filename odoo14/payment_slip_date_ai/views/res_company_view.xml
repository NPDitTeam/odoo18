<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- เพิ่มฟิลด์ "ชื่อบริษัทสำรอง (ตรวจสลิป AI)" ในหน้าตั้งค่าบริษัท
             ใช้เมื่อสลิปแสดงชื่อบริษัทเป็นภาษาอังกฤษ หรือสะกดแบบต่าง ๆ
             ที่ AI ควรยอมรับว่าตรงกับบริษัทนี้ -->
        <record id="view_company_form_slip_verify_names" model="ir.ui.view">
            <field name="name">res.company.form.slip.verify.names</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="ตรวจสอบชื่อบริษัทจากสลิป (AI)" name="slip_verify_names">
                        <field name="slip_verify_extra_names"
                               placeholder="NOPPADOL S GROUP CO.,LTD&#10;บริษัท นภดล เอสกรุ๊ป จำกัด"/>
                        <div class="text-muted" colspan="2">
                            รายชื่อเพิ่มเติมที่ยอมรับได้เมื่อ AI ตรวจชื่อผู้รับเงินจากสลิป
                            (นอกเหนือจากชื่อบริษัทหลักด้านบน) — ใส่ 1 ชื่อต่อ 1 บรรทัด
                            เช่น ชื่อภาษาอังกฤษ เพื่อรองรับสลิปที่แสดงเฉพาะชื่ออังกฤษ
                        </div>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
