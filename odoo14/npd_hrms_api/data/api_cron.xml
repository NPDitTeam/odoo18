<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_purge_expired_api_tokens" model="ir.cron">
            <field name="name">HRMS API: ลบ token ที่หมดอายุ</field>
            <field name="model_id" ref="model_hrms_api_token"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_purge_login_attempts" model="ir.cron">
            <field name="name">HRMS API: ลบประวัติการล็อกอินผิดที่เก่าแล้ว</field>
            <field name="model_id" ref="model_hrms_api_login_attempt"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
