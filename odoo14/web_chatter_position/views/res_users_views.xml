<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add chatter_position to user preferences -->
    <record id="res_users_view_form_chatter" model="ir.ui.view">
        <field name="name">res.users.form.chatter.position</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tz']" position="after">
                <field name="chatter_position" string="ตำแหน่ง Chatter" widget="radio"
                       options="{'horizontal': true}"/>
            </xpath>
        </field>
    </record>
</odoo>
