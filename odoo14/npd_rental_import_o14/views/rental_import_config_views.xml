<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_import_config_list" model="ir.ui.view">
        <field name="name">npd.rental.import.config.list</field>
        <field name="model">npd.rental.import.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="db_name"/>
                <field name="company_id"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>

    <record id="view_rental_import_config_form" model="ir.ui.view">
        <field name="name">npd.rental.import.config.form</field>
        <field name="model">npd.rental.import.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="ทดสอบการเชื่อมต่อ" class="btn-secondary"/>
                    <button name="action_open_check_wizard" type="object"
                            string="ตรวจ/ดึงใบเช่า" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="การเชื่อมต่อ">
                            <field name="name"/>
                            <field name="url"/>
                            <field name="db_name"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="ปลายทางฝั่ง 18">
                            <field name="company_id"/>
                            <field name="last_run" readonly="1"/>
                        </group>
                        <group string="ซิงก์อัตโนมัติ (ทุกวันจันทร์ 02:00 น. ถึง 31/12/2569)">
                            <field name="auto_sync_products"/>
                            <field name="auto_sync_pricelists"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        ใช้ปุ่ม "ตรวจ/ดึงใบเช่า" ปุ่มเดียว: เลือกกรอกเลข SO หรือดึงบิลต่ออายุทั้งเดือน
                        สินค้า/รายการราคาที่ขาดจะถูกสร้าง/ปรับให้ตอนยกใบ และตัดสต็อกตามของที่ยังอยู่กับลูกค้าฝั่ง 14
                        (รายการราคายังซิงก์อัตโนมัติทุกวันจันทร์ตามเดิม)
                    </div>
                    <group string="ผลการทำงานล่าสุด">
                        <field name="last_result" nolabel="1" readonly="1"
                               widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_import_check_wizard_form" model="ir.ui.view">
        <field name="name">npd.rental.import.check.wizard.form</field>
        <field name="model">npd.rental.import.check.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="config_id"/>
                    <field name="mode" widget="radio" options="{'horizontal': true}"/>
                    <field name="date_from" invisible="mode != 'period'" required="mode == 'period'"/>
                    <field name="date_to" invisible="mode != 'period'" required="mode == 'period'"/>
                    <field name="names" invisible="mode != 'names'" placeholder="เช่น SO-26100100018 SO-26100500003 (หลายใบคั่นด้วยเว้นวรรค/ขึ้นบรรทัดใหม่)"/>
                </group>
                <div class="alert alert-info" role="alert">
                    "ตรวจ" ไล่ให้ดูว่าใบติดอะไร (ลูกค้า สินค้า ภาษี ยอดเงิน) โดยไม่บันทึกอะไรลงระบบ
                    เมื่อตรวจผ่านแล้วค่อยกด "ยกจริง" — ใบที่ของยังอยู่กับลูกค้าจะถูกตัดสต็อกตามฝั่ง 14
                    และใบที่มียอดค้างจะได้ใบแจ้งหนี้ (ร่าง) แยกตามประเภท
                </div>
                <field name="result" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_check" type="object" string="ตรวจ (ไม่บันทึก)" class="btn-primary"/>
                    <button name="action_import" type="object" string="ยกจริง" class="btn-secondary"
                            confirm="ยกใบเข้า Odoo 18 จริง (ใบที่เคยยกแล้วจะถูกอัปเดตทับ ใบที่ตัดสต็อกแล้วจะข้าม) ดำเนินการต่อไหม"/>
                    <button string="ปิด" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rental_import_config" model="ir.actions.act_window">
        <field name="name">ยกข้อมูลใบเช่าจาก Odoo 14</field>
        <field name="res_model">npd.rental.import.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
