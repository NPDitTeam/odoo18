<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_import_config_list" model="ir.ui.view">
        <field name="name">npd.rental.import.config.list</field>
        <field name="model">npd.rental.import.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="db_name"/>
                <field name="company_id"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>

    <record id="view_rental_import_config_form" model="ir.ui.view">
        <field name="name">npd.rental.import.config.form</field>
        <field name="model">npd.rental.import.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="ทดสอบการเชื่อมต่อ" class="btn-secondary"/>
                    <button name="action_sync_products" type="object"
                            string="1. ยกสินค้าเช่า" class="btn-primary"
                            confirm="สร้างสินค้าเช่าที่ฝั่ง 18 ยังไม่มี และอัปเดตตัวที่มีแล้ว ดำเนินการต่อไหม"/>
                    <button name="action_sync_pricelists" type="object"
                            string="2. ยกรายการราคา" class="btn-primary"
                            confirm="ปรับราคาในรายการราคาฝั่ง 18 ให้ตรงฝั่ง 14 ดำเนินการต่อไหม"/>
                    <button name="action_sync_stock" type="object"
                            string="3. ยกสต็อก" class="btn-primary"
                            confirm="ปรับยอดคงเหลือฝั่ง 18 ให้ตรงฝั่ง 14 ดำเนินการต่อไหม"/>
                    <button name="action_open_check_wizard" type="object"
                            string="4. ตรวจ/ดึงรายใบ" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group string="การเชื่อมต่อ">
                            <field name="name"/>
                            <field name="url"/>
                            <field name="db_name"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="ปลายทางฝั่ง 18">
                            <field name="company_id"/>
                            <field name="last_run" readonly="1"/>
                        </group>
                        <group string="ซิงก์อัตโนมัติ (ทุกวันจันทร์ 02:00 น. ถึง 31/12/2569)">
                            <field name="auto_sync_products"/>
                            <field name="auto_sync_pricelists"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        กดตามลำดับ 1 → 2 → 3 ก่อนยกใบเช่า เพราะใบต้องอ้างถึงสินค้าและราคาที่มีอยู่แล้ว
                        ทุกปุ่มกดซ้ำได้ ของที่มีแล้วจะถูกอัปเดตทับ ไม่สร้างซ้ำ
                    </div>
                    <group string="ผลการทำงานล่าสุด">
                        <field name="last_result" nolabel="1" readonly="1"
                               widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_import_check_wizard_form" model="ir.ui.view">
        <field name="name">npd.rental.import.check.wizard.form</field>
        <field name="model">npd.rental.import.check.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="config_id"/>
                    <field name="names" placeholder="เช่น SO-26100100018 SO-26100500003 (หลายใบคั่นด้วยเว้นวรรค/ขึ้นบรรทัดใหม่)"/>
                </group>
                <div class="alert alert-info" role="alert">
                    "ตรวจ" ไล่ให้ดูว่าใบติดอะไร (ลูกค้า สินค้า ภาษี ยอดเงิน) โดยไม่บันทึกอะไรลงระบบ
                    เมื่อตรวจผ่านแล้วค่อยกด "ยกจริงเฉพาะใบนี้"
                </div>
                <field name="result" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_check" type="object" string="ตรวจ (ไม่บันทึก)" class="btn-primary"/>
                    <button name="action_import" type="object" string="ยกจริงเฉพาะใบนี้" class="btn-secondary"
                            confirm="ยกใบที่กรอกเข้า Odoo 18 จริง (ใบที่เคยยกแล้วจะถูกอัปเดตทับ) ดำเนินการต่อไหม"/>
                    <button string="ปิด" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rental_import_config" model="ir.actions.act_window">
        <field name="name">ยกข้อมูลใบเช่าจาก Odoo 14</field>
        <field name="res_model">npd.rental.import.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
