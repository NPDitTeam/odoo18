<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_import_config_list" model="ir.ui.view">
        <field name="name">npd.rental.import.config.list</field>
        <field name="model">npd.rental.import.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="db_name"/>
                <field name="company_id"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>

    <record id="view_rental_import_config_form" model="ir.ui.view">
        <field name="name">npd.rental.import.config.form</field>
        <field name="model">npd.rental.import.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="ทดสอบการเชื่อมต่อ" class="btn-secondary"/>
                    <button name="action_sync_products" type="object"
                            string="1. ยกสินค้าเช่า" class="btn-primary"
                            confirm="สร้างสินค้าเช่าที่ฝั่ง 18 ยังไม่มี และอัปเดตตัวที่มีแล้ว ดำเนินการต่อไหม"/>
                    <button name="action_sync_pricelists" type="object"
                            string="2. ยกรายการราคา" class="btn-primary"
                            confirm="ปรับราคาในรายการราคาฝั่ง 18 ให้ตรงฝั่ง 14 ดำเนินการต่อไหม"/>
                    <button name="action_sync_stock" type="object"
                            string="3. ยกสต็อก" class="btn-primary"
                            confirm="ปรับยอดคงเหลือฝั่ง 18 ให้ตรงฝั่ง 14 ดำเนินการต่อไหม"/>
                </header>
                <sheet>
                    <group>
                        <group string="การเชื่อมต่อ">
                            <field name="name"/>
                            <field name="url"/>
                            <field name="db_name"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="ปลายทางฝั่ง 18">
                            <field name="company_id"/>
                            <field name="last_run" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        กดตามลำดับ 1 → 2 → 3 ก่อนยกใบเช่า เพราะใบต้องอ้างถึงสินค้าและราคาที่มีอยู่แล้ว
                        ทุกปุ่มกดซ้ำได้ ของที่มีแล้วจะถูกอัปเดตทับ ไม่สร้างซ้ำ
                    </div>
                    <group string="ผลการทำงานล่าสุด">
                        <field name="last_result" nolabel="1" readonly="1"
                               widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rental_import_config" model="ir.actions.act_window">
        <field name="name">ยกข้อมูลใบเช่าจาก Odoo 14</field>
        <field name="res_model">npd.rental.import.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
