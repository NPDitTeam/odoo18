<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- พอร์ตจาก o14: pfb_npd/pfb_npd_sale_form_Billing_sheet (สูตรตาม commit a30b9d59)
         ต่างจาก o14:
         - เลย์เอาต์ใช้ตารางกำหนดความกว้างแทน Bootstrap row/col (wkhtmltopdf ไม่รองรับ flex)
         - บัญชีธนาคาร/รูป QR สำรอง/ซ่อนเลขภาษี เลือกตามบริษัทของเอกสาร แทน request.db
         - โลโก้/QR ฝังเป็น data URI ไม่อ้าง URL (โลโก้ web/binary/company_logo ของ o14
           ได้โลโก้ของบริษัทที่ผู้ใช้เลือกอยู่ ไม่ใช่บริษัทของเอกสาร)
         - ฟอนต์ Laksaman ตัวเดียวกับเครื่อง o14 (เครื่อง o18 ไม่มีฟอนต์ไทย ต้องโหลดจากโมดูล) -->

    <record id="paperformat_pfb_npd_sale_form_Billing_sheet" model="report.paperformat">
        <field name="name">A4 ใบแจ้งหนี้/ใบวางบิล</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <record id="action_rent_invoice" model="ir.actions.report">
        <field name="name">ใบแจ้งหนี้/ใบวางบิล</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pfb_npd_sale_form_Billing_sheet.report_pfb_npd_sale_form_Billing_sheet</field>
        <field name="report_file">pfb_npd_sale_form_Billing_sheet.report_pfb_npd_sale_form_Billing_sheet</field>
        <field name="print_report_name">'Billing Note - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_pfb_npd_sale_form_Billing_sheet"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ==================== หัวเอกสาร ==================== -->
    <template id="report_header">
        <table width="100%" style="table-layout: fixed;">
            <tr>
                <td width="16.66%" style="vertical-align: top;">
                    <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)"
                         style="max-width: 100%; max-height: 90px;"/>
                </td>
                <td width="58.34%" style="vertical-align: top; padding-left: 40px;">
                    <div style="font-size: 19px; font-weight: bold;" t-out="doc.company_id.name"/>
                    <div style="line-height: 1.5; font-size: 14px;" t-out="doc.get_branch_address_billing_sheet()"/>
                    <div style="font-size: 14px;">
                        <t t-if="doc.show_company_vat_billing_sheet()">
                            เลขประจำตัวผู้เสียภาษี <span t-out="doc.company_id.vat"/>
                        </t>
                        <span t-if="doc.is_head_office_billing_sheet()">(สำนักงานใหญ่)</span>
                    </div>
                </td>
                <td width="25%" style="vertical-align: top; text-align: center;">
                    <div style="font-size: 19px; font-weight: bold;">ใบแจ้งหนี้/ใบวางบิล</div>
                    <div style="font-size: 15px; font-weight: bold;">INVOICE / BILLING NOTE</div>
                </td>
            </tr>
        </table>

        <div style="height: 18px;"/>

        <!-- ข้อมูลลูกค้า + เลขที่/วันที่ (ล็อกความกว้าง 19/39/21/21 แบบ o14 ที่อยู่ยาวไม่ดันเลขที่ตกขอบ) -->
        <table width="100%" style="table-layout: fixed; font-size: 14px;">
            <tr>
                <td width="19%" class="bs-lbl">ชื่อลูกค้า :</td>
                <td width="39%" class="bs-val" t-out="doc.partner_id.name"/>
                <td width="21%" class="bs-lbl">เลขที่ :</td>
                <td width="21%" class="bs-val" t-out="doc.get_invoice_names_billing_sheet()"/>
            </tr>
            <tr>
                <td class="bs-lbl">ที่อยู่ :</td>
                <td class="bs-val">
                    <t t-out="' '.join(p for p in [doc.partner_id.street, doc.partner_id.street2, doc.partner_id.city, doc.partner_id.state_id.name, doc.partner_id.zip] if p)"/>
                </td>
                <td class="bs-lbl">วันที่ :</td>
                <td class="bs-val" t-out="doc.date_order and doc.date_order.strftime('%d-%m-%Y') or ''"/>
            </tr>
            <tr>
                <td/>
                <td/>
                <td class="bs-lbl">วันที่กำหนดจ่าย :</td>
                <td class="bs-val" t-out="doc.get_invoice_due_date_billing_sheet()"/>
            </tr>
            <tr>
                <td class="bs-lbl">เบอร์โทรศัพท์ :</td>
                <td class="bs-val" t-out="doc.partner_id.phone or ''"/>
                <td/>
                <td/>
            </tr>
            <tr>
                <td class="bs-lbl">เลขที่ผู้เสียภาษี :</td>
                <td class="bs-val" t-out="doc.partner_id.vat or ''"/>
                <td/>
                <td/>
            </tr>
        </table>

        <div style="height: 8px;"/>

        <table width="100%" style="table-layout: fixed; border-collapse: collapse; font-size: 14px;">
            <thead>
                <tr style="border-bottom: 1px solid black;">
                    <th width="5%" style="text-align: center; padding: 4px;">ลำดับ</th>
                    <th width="50%" style="text-align: left; padding: 4px;">รายการ</th>
                    <th width="15%" style="text-align: right; padding: 4px;">ค่าเช่าต่อวัน</th>
                    <th width="15%" style="text-align: right; padding: 4px;">จำนวนวัน</th>
                    <th width="15%" style="text-align: right; padding: 4px;">จำนวนเงิน</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="text-align: center; padding: 4px; vertical-align: top;">1</td>
                    <td style="text-align: left; padding: 4px; vertical-align: top;">
                        ค่าเช่า เอกสารเลขที่ :<span style="margin-left: 4px;" t-out="doc.name"/><br/>
                        วันที่ :<span style="margin-left: 4px; margin-right: 4px;"
                                      t-out="doc.start_rent_date and doc.start_rent_date.strftime('%d-%m-%Y') or ''"/>
                        ถึงวันที่ :<span style="margin-left: 4px;"
                                         t-out="doc.end_rent_date and doc.end_rent_date.strftime('%d-%m-%Y') or ''"/>
                    </td>
                    <td style="text-align: right; padding: 4px; vertical-align: top;"
                        t-out="'{0:,.2f}'.format(doc.get_rent_per_day_billing_sheet())"/>
                    <td style="text-align: right; padding: 4px; vertical-align: top;"
                        t-out="'{0:,.0f}'.format(doc.pfb_date_of_rent or 0)"/>
                    <td style="text-align: right; padding: 4px; vertical-align: top;"
                        t-out="'{0:,.2f}'.format(doc.amount_total)"/>
                </tr>
            </tbody>
        </table>
    </template>

    <!-- ==================== ท้ายเอกสาร ==================== -->
    <template id="report_footer">
        <div style="border-bottom: 1px solid black; margin-bottom: 10px;"/>

        <table width="100%" style="table-layout: fixed; font-size: 14px;">
            <tr>
                <!-- ซ้าย: หมายเหตุ + จำนวนเงินตัวอักษร -->
                <td width="58.34%" style="vertical-align: top;">
                    <div>
                        <span style="font-weight: bold;">หมายเหตุ :</span>
                        <span style="margin-left: 4px;" t-out="doc.get_note_billing_sheet()"/>
                    </div>
                    <div style="height: 40px;"/>
                    <div style="font-weight: bold;">จำนวนเงิน(ตัวอักษร)</div>
                    <div style="height: 10px;"/>
                    <div style="text-align: center; font-size: 16px; font-weight: bold;">
                        (<t t-out="doc.get_total_baht_text_sheet()"/>)
                    </div>
                </td>
                <!-- กลาง: ป้าย -->
                <td width="25%" style="vertical-align: top; text-align: right;">
                    <div>ค่าเช่า :</div>
                    <div>ภาษีมูลค่าเพิ่ม 7% :</div>
                    <div>ค่าเช่าก่อนภาษีมูลค่าเพิ่ม :</div>
                    <div>ค่าประกัน :</div>
                    <div style="height: 10px;"/>
                    <div style="font-size: 16px; font-weight: bold;">จำนวนเงินทั้งสิ้น :</div>
                </td>
                <!-- ขวา: ยอดเงิน -->
                <td width="16.66%" style="vertical-align: top; text-align: right;">
                    <div t-out="'{0:,.2f}'.format(doc.amount_total)"/>
                    <div t-out="'{0:,.2f}'.format(doc.amount_tax)"/>
                    <div t-out="'{0:,.2f}'.format(doc.amount_untaxed)"/>
                    <div t-out="'{0:,.2f}'.format(doc.get_deposit_billing_sheet())"/>
                    <div style="height: 10px;"/>
                    <!-- จำนวนเงินทั้งสิ้น: ยอดเดียวกับตัวอักษรและยอดในคิวอาร์
                         ติ๊ก "หัก 5%" แล้ว = ยอดนี้หักภาษี ณ ที่จ่ายออกแล้ว -->
                    <div style="font-size: 16px; font-weight: bold;"
                         t-out="'{0:,.2f}'.format(doc.get_grand_total_billing_sheet())"/>
                </td>
            </tr>
        </table>

        <div style="border-bottom: 1px solid black; margin-top: 10px; margin-bottom: 10px;"/>

        <!-- ภาษีหัก ณ ที่จ่าย: แสดงทุกใบที่ลูกค้าเป็นนิติบุคคล ฐานคือค่าเช่าก่อน VAT ไม่รวมค่าประกัน -->
        <t t-if="doc.wht_applies_billing_sheet()">
            <div style="font-size: 16px; font-weight: bold;">ข้อมูลภาษี หัก ณ.ที่จ่าย</div>
            <div style="font-size: 14px; padding-left: 40px; margin-bottom: 8px;">
                ภาษีหัก ณ ที่จ่าย 5% ของ :
                <span style="padding-left: 40px;" t-out="'{0:,.2f}'.format(doc.get_wht_base_billing_sheet())"/>
                <span style="margin-left: 20px;">=</span>
                <span style="margin-left: 20px;" t-out="'{0:,.2f}'.format(doc.get_wht_amount_billing_sheet())"/>
                <span style="margin-left: 20px;">บาท</span>
                <span t-if="doc.deduct_wht_billing_sheet()" style="margin-left: 20px;">(หักออกจากจำนวนเงินทั้งสิ้นแล้ว)</span>
            </div>
        </t>

        <div style="font-size: 16px; font-weight: bold;">การชำระเงิน :</div>
        <table style="font-size: 14px; margin-left: 40px;">
            <t t-set="payment_account" t-value="doc.get_payment_account_billing_sheet()"/>
            <tr t-if="payment_account">
                <td>โอนเงินเข้าบัญชี : <t t-out="payment_account"/></td>
            </tr>
            <tr t-if="payment_account">
                <td>สั่งจ่ายด้วยเช็คกรุณาสั่งจ่ายในนาม : <t t-out="doc.get_payment_payee_billing_sheet()"/></td>
            </tr>
            <tr>
                <td>ค่าธรรมเนียมธนาคาร ผู้ชำระเงินเป็นผู้รับผิดชอบ</td>
            </tr>
            <tr>
                <td style="padding-top: 4px;">
                    <!-- QR สแกนจ่ายพร้อมเพย์ ยอด = จำนวนเงินทั้งสิ้น
                         ถ้าบริษัทยังไม่ได้ตั้งเลขพร้อมเพย์ (การตั้งค่า > บริษัท) แสดงรูป QR เดิมของบริษัทแทน -->
                    <t t-set="promptpay_qr" t-value="doc.get_promptpay_qr_image_billing_sheet()"/>
                    <t t-if="promptpay_qr">
                        <div style="font-weight: bold;">สแกนจ่ายด้วยพร้อมเพย์</div>
                        <img t-att-src="'data:image/png;base64,%s' % promptpay_qr" style="width: 100px; height: 100px;"/>
                    </t>
                    <t t-else="">
                        <t t-set="fallback_qr" t-value="doc.get_fallback_qr_billing_sheet()"/>
                        <img t-if="fallback_qr" t-att-src="'data:image/png;base64,%s' % fallback_qr" style="max-height: 100px;"/>
                    </t>
                </td>
            </tr>
        </table>

        <table width="100%" style="table-layout: fixed; margin-top: 10px;">
            <tr>
                <td width="66.66%"/>
                <td width="33.34%" style="text-align: center; font-size: 15px;">
                    <div>......................................................</div>
                    <div>ผู้วางบิล</div>
                </td>
            </tr>
        </table>
    </template>

    <!-- ==================== เอกสารหลัก ==================== -->
    <template id="report_pfb_npd_sale_form_Billing_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <!-- ฟอนต์ไทยต้องอ้าง URL เต็ม (เอกสารที่ส่งให้ wkhtmltopdf ไม่มี base href) -->
                    <t t-set="font_base" t-value="(web_base_url or '') + '/pfb_npd_sale_form_Billing_sheet/static/fonts/'"/>
                    <div class="page bs-page">
                        <style>
                            @font-face { font-family: 'NPDBillThai'; font-weight: normal;
                                src: url('<t t-out="font_base + 'Laksaman.ttf'"/>') format('truetype'); }
                            @font-face { font-family: 'NPDBillThai'; font-weight: bold;
                                src: url('<t t-out="font_base + 'Laksaman-Bold.ttf'"/>') format('truetype'); }
                            .bs-page, .bs-page * { font-family: 'NPDBillThai', 'Laksaman', sans-serif !important; }
                            .bs-page { color: #000; }
                            .bs-page td, .bs-page th { line-height: 1.35; }
                            .bs-lbl { text-align: right; font-weight: 600; padding-right: 8px;
                                      vertical-align: top; white-space: nowrap; }
                            .bs-val { text-align: left; padding-right: 10px; vertical-align: top;
                                      word-wrap: break-word; }
                        </style>
                        <!-- ตารางโครงหน้า (แบบ o14): ความสูงเท่าพื้นที่พิมพ์ A4 แถวท้ายชิดก้นกระดาษเสมอ
                             o14 ใช้ 960px แต่ o18 wkhtmltopdf ย่อสเกลหน้าต่างกัน 960px ได้แค่ ~3/4 หน้า
                             วัดจาก PDF จริงแล้วพื้นที่พิมพ์ (297-10-7 มม.) ≈ 1,225px จึงตั้ง 1,200px เผื่อไว้
                             ถ้าหัวเอกสารยาวเกินจนดันเกินหน้า ค่อยลดตัวเลขนี้ -->
                        <table style="width: 100%; table-layout: fixed; height: 1200px; border: 1px solid black; border-collapse: collapse;">
                            <tr>
                                <td style="vertical-align: top; border: 1px solid black; padding: 6px;">
                                    <t t-call="pfb_npd_sale_form_Billing_sheet.report_header"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="vertical-align: bottom; border: 1px solid black; padding: 6px;">
                                    <t t-call="pfb_npd_sale_form_Billing_sheet.report_footer"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
