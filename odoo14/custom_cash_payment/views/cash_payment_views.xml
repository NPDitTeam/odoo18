<odoo>
    <!-- List View -->
    <record id="view_cash_payment_tree" model="ir.ui.view">
        <field name="name">cash.payment.list</field>
        <field name="model">cash.payment</field>
        <field name="arch" type="xml">
            <list string="ชำระเงินสด">
                <field name="name"/>
                <field name="company_id" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="state"/>
                <field name="payment_ids"/>
                <field name="total_amount"/>
                <field name="date_created" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cash_payment_form" model="ir.ui.view">
        <field name="name">cash.payment.form</field>
        <field name="model">cash.payment</field>
        <field name="arch" type="xml">
            <form string="ชำระเงินสด">
                <header>
                    <button name="action_confirm"
                            string="ยืนยัน"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'confirmed'"/>
                    <button name="action_reset_to_draft"
                            string="ยกเลิกรับเป็นร่าง"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                            <field name="branch_id"
                                   readonly="state != 'draft'"
                                   domain="['|', ('company_ids', '=', False), ('company_ids', 'in', company_id)]"/>
                        </group>
                        <group>
                            <field name="move_id" readonly="1"/>
                            <field name="total_amount"/>
                            <field name="date_created"/>
                        </group>
                    </group>
                    <group>
                        <field name="payment_ids"
                               widget="many2many_tags"
                               domain="[('payment_method_one_id.name', '=', 'เงินสด'),
                                        ('payment_type', '=', 'inbound'),
                                        ('company_id', '=', company_id),
                                        ('branch_id', '=', branch_id),
                                        ('cash_status', '=', False)]"
                               readonly="state == 'confirmed'"/>
                    </group>

                    <notebook>
                        <page string="รายละเอียดการชำระเงิน">
                            <group string="รายละเอียดรายการที่เลือก">
                                <field name="payment_lines" readonly="state == 'confirmed'">
                                    <list editable="bottom">
                                        <field name="payment_name"/>
                                        <field name="payment_id" column_invisible="1"/>
                                        <field name="partner_id"/>
                                        <field name="amount"/>
                                        <field name="payment_date"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cash_payment_form" model="ir.actions.act_window">
        <field name="name">ชำระเงินสด</field>
        <field name="res_model">cash.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cash_payment_tree"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่มีข้อมูลเพิ่มข้อมูลใหม่เพื่อเริ่มต้น
            </p>
        </field>
    </record>
</odoo>
