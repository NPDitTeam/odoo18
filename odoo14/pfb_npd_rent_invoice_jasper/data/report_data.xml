<?xml version="1.0"?>
<odoo>
    <!-- Jasper Report Action for Rental Invoice -->
    <record id="jasper_rent_invoice_report" model="ir.actions.report">
        <field name="name">ใบกำกับการเช่า</field>
        <field name="model">sale.order</field>
        <field name="report_type">jasper</field>
        <field name="file">pfb_npd_rent_invoice_jasper/report/rent_invoice.jrxml</field>
        <field name="attachment_use">False</field>
        <field name="report_name">ใบกำกับการเช่า</field>
        <field name="jasper_report">True</field>
        <field name="jasper_output">pdf</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'ใบกำกับการเช่า - %s' % (object.name)</field>
    </record>

    <!-- Attach the JRXML file to the report -->
    <record id="jasper_rent_invoice_file" model="ir.actions.report.xml.file">
        <field name="default">True</field>
        <field name="filename">rent_invoice.jrxml</field>
        <field name="report_id" ref="pfb_npd_rent_invoice_jasper.jasper_rent_invoice_report"/>
        <field name="file" type="base64" file="pfb_npd_rent_invoice_jasper/report/rent_invoice.jrxml"/>
    </record>
</odoo>
