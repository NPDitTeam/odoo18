<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="seq_customer_payment" model="ir.sequence">
        <field name="name">Customer Payment</field>
        <field name="code">customer.payment</field>
        <field name="prefix">CUST.IN-%(y)s%(month)s%(day)s-</field>
        <field name="padding">4</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_supplier_payment" model="ir.sequence">
        <field name="name">Supplier Payment</field>
        <field name="code">supplier.payment</field>
        <field name="prefix">CUST.OUT-%(y)s%(month)s%(day)s-</field>
        <field name="padding">4</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
